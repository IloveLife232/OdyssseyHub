	local ddHeader=_fieldBox({Class="TextButton",Parent=pairRow,Text=tostring(ddSelected),Size=UDim2.new(0.38,-3,1,0),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0)})
