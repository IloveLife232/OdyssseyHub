			userV.Text="OdysseyBlockingThis"
			idV.Text="1"
		else
			dispV.Text=realDisplayName
			userV.Text="@"..realUsername
			idV.Text=realUserId
		end
	end
	local alreadyBlurred={}
	local function BlurTextIn(obj)
		if alreadyBlurred[obj] then return end
		pcall(function()
			if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
				if obj.Text and obj.Text~="" then
					local changed=false
					if realUsername~="" and obj.Text:find(realUsername,1,true) then
						obj.Text=obj.Text:gsub(realUsername,"OdysseyBlockingThis")
						changed=true
					end
					if realDisplayName~="" and realDisplayName~=realUsername and obj.Text:find(realDisplayName,1,true) then
						obj.Text=obj.Text:gsub(realDisplayName,"OdysseyBlockingThis")
						changed=true
					end
					if changed then alreadyBlurred[obj]=true end
				end
			end
		end)
	end
	local function BlurPlayerGuiPass()
		if not realUsername or realUsername=="" then return end
		for _,gui in ipairs(PlayerGui:GetChildren()) do
			for _,obj in ipairs(gui:GetDescendants()) do BlurTextIn(obj) end
		end
	end
	local function BlurWorkspacePass()
		if not realUsername or realUsername=="" then return end
		pcall(function()
			for _,obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
					for _,child in ipairs(obj:GetDescendants()) do BlurTextIn(child) end
				end
			end
		end)
	end
	local function StartBlurLoop()
		if blurLoopActive then return end
		blurLoopActive=true
		task.spawn(function()
			local cycles=0
			while blurIdentityEnabled do
				BlurPlayerGuiPass()
				cycles+=1
				if cycles%4==0 then BlurWorkspacePass() end
				task.wait(1.5)
			end
			blurLoopActive=false
		end)
	end
	Odyssey._RefreshIdentityDisplay=RefreshIdentityDisplay
	Odyssey._SetBlurIdentity=function(v)
		blurIdentityEnabled=v
		RefreshIdentityDisplay()
		if v then StartBlurLoop() end
		pcall(function()
			game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not v)
		end)
	end
	pcall(function()
		realDisplayName=LocalPlayer.DisplayName~="" and LocalPlayer.DisplayName or "N/A"
