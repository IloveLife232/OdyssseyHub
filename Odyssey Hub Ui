			elseif ch:IsA("Frame") then ch:Destroy() end
		end
		timCard.Visible=true
		local apis={}
		for i,r in ipairs(o.Rows or {}) do
			local v=TimerRow(timL,r.Name or "",tostring(r.Value or "-"))
