function Window:_selectTab(td)
	if self._searchBoxes then
		for _,sb in ipairs(self._searchBoxes) do if sb.Text~="" then sb.Text="" end end
	end
	for _,t in ipairs(self._tabs) do self:_styleNav(t,false); t.page.Visible=false; t.searchTitle.Visible=false end
	self:_styleNav(td,true)
	td.page.Visible=true
	self._current=td
	if self._titleLbl then self._titleLbl.Text=td.name end
	if self._subLbl then self._subLbl.Text=td.desc or "" end
	if self._contentScroll then self._contentScroll.CanvasPosition=Vector2.new(0,0) end

	if td.chip and self._chipScroll and self._chipScroll.Visible then
		pcall(function()
			local x=td.chip.AbsolutePosition.X-self._chipScroll.AbsolutePosition.X+self._chipScroll.CanvasPosition.X
			self._chipScroll.CanvasPosition=Vector2.new(math.max(0,x-40),0)
		end)
	end
end

function Window:_relayoutTabs(compact)
	self._compact=compact
	for _,root in ipairs(self._roots or {}) do
		root.compact=compact
		for i,card in ipairs(root.cards) do
			card.Parent=compact and root.cols[1] or root.cols[card:GetAttribute("Col") or 1]
			card.LayoutOrder=i
		end
		root.cols[1].Size=compact and UDim2.new(1,0,0,0) or UDim2.new(0.5,-5,0,0)
		root.cols[2].Visible=not compact
	end
end

function Window:_runSearch(q)
	q=tostring(q or ""):lower():match("^%s*(.-)%s*$")
	if q=="" then
		for _,it in ipairs(self._searchItems) do it.row.Visible=true end
		for _,s in ipairs(self._searchSections) do s.Visible=true end
		if self._current then self:_selectTab(self._current) end
		return
	end
	local hit,secHit={},{}
	for _,it in ipairs(self._searchItems) do
		local m=it.n:find(q,1,true)~=nil
		it.row.Visible=m
		if m and it.page then hit[it.page]=true end
		if m and it.sec then secHit[it.sec]=true end
	end
	for _,s in ipairs(self._searchSections) do s.Visible=secHit[s]==true end
	local any=false
	for _,t in ipairs(self._tabs) do
		local h=hit[t.page]==true
		t.page.Visible=h
		t.searchTitle.Visible=h
		if h then any=true end
		self:_styleNav(t,false)
	end
	if self._titleLbl then self._titleLbl.Text="Search" end
	if self._subLbl then self._subLbl.Text=any and ('Results for "'..q..'"') or "No matches" end
	if self._contentScroll then self._contentScroll.CanvasPosition=Vector2.new(0,0) end
end

