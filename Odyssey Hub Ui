-- when you stand next to something the game lets you use with E (an egg, the Candy Witch, a pad, a house),
-- E does that instead of tapping. So near those, Auto Tap clicks an empty bit of the screen instead (never on a button).
local CollectionS = game:GetService("CollectionService")
local GuiS = game:GetService("GuiService")
local nearCache, nearAt = false, 0
local function nearInteractable()
    if os.clock() - nearAt < 0.5 then return nearCache end
    nearAt = os.clock()
    nearCache = false
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    for _, m in ipairs(CollectionS:GetTagged("Interactable")) do
        local ok, pos = pcall(function() return m:IsA("BasePart") and m.Position or m:GetPivot().Position end)
        if ok and pos then
            local range = tonumber(m:GetAttribute("InteractRange")) or 12
            if (pos - r.Position).Magnitude <= range + 3 then nearCache = true break end
        end
    end
    return nearCache
end
local clickSpot, clickSpotAt = nil, 0
local SPOTS = {{0.5, 0.42}, {0.35, 0.45}, {0.65, 0.45}, {0.5, 0.3}, {0.25, 0.6}, {0.75, 0.6}, {0.5, 0.62}, {0.15, 0.4}, {0.85, 0.4}}
local function findClickSpot()
    if os.clock() - clickSpotAt < 1 then return clickSpot end
    clickSpotAt = os.clock()
    clickSpot = nil
    local cam = workspace.CurrentCamera
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not (cam and pg) then return nil end
    local vp = cam.ViewportSize
    local inset = GuiS:GetGuiInset()
    for _, f in ipairs(SPOTS) do
        local x, y = math.floor(vp.X * f[1]), math.floor(vp.Y * f[2])
        local blocked = false
        local ok, objs = pcall(function() return pg:GetGuiObjectsAtPosition(x, y - inset.Y) end)
        for _, o in ipairs(ok and objs or {}) do
            if o.Visible and (o:IsA("GuiButton") or o:IsA("TextBox") or (o.Active and o.BackgroundTransparency < 0.95)) then blocked = true break end
        end
        if not blocked then clickSpot = Vector2.new(x, y) break end
    end
    return clickSpot
end
local ourClickUntil = 0
local function tapOnce()
    if UIS:GetFocusedTextBox() then task.wait() return end
    if nearInteractable() then
        local p = findClickSpot()
        if p then
            ourClickUntil = os.clock() + 0.2
            VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0)
            task.wait()
            VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
            return
        end
    end
    pressE()
end

