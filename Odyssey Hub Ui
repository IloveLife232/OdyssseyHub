-- EGGS PER HATCH: always the most you can, the same way the game's own auto hatch picks it
-- (EggController.pickAutoHatchCount): x8 if you own the x8 gamepass (or an Octo Hatch boost) and can afford 8,
-- else x3 if you can afford 3, else x1
function Hatch.maxCount(egg)
    local function req(path)
        local ok, m = pcall(function()
            local cur = game:GetService("ReplicatedStorage")
            for part in path:gmatch("[^%.]+") do cur = cur:FindFirstChild(part) end
            return require(cur)
        end)
        return ok and m or nil
    end
    local d = GameData.get()
    local lec, ep = req("Shared.Pets.LaunchEggConfig"), req("Shared.Pets.EggPricing")
    local info = lec and lec[egg]
    if not (d and info and ep and ep.GetTotal) then return 1 end
    local coins = tonumber(d.Currencies and d.Currencies.Coins) or 0
    local function total(n) local ok, v = pcall(ep.GetTotal, d, egg, info.Price, n) return ok and tonumber(v) or math.huge end
    local gp, bf = req("Shared.Monetization.GamepassPerks"), req("Shared.Items.BoostFormula")
    local has8 = (gp and gp.Has and select(2, pcall(gp.Has, d, "x8Egg")) == true) or (bf and bf.HasType and select(2, pcall(bf.HasType, d, "OctoHatch")) == true)
    if has8 and total(8) <= coins then return 8 end
    if total(3) <= coins then return 3 end
    return 1
end
