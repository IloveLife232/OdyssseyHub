-- DIAMOND MACHINE: same as the golden one but at the Diamond machine (InteractionPoint "Diamond", Crystal Cave) with
-- Machine = "Diamond": #MachineConfig.Diamond.Chances GOLDEN copies of the same pet = 1 diamond (100%).
do
local function diamondSource()
    local ok, mc = pcall(function() return require(RS.Shared.Pets.MachineConfig) end)
    return ok and mc and mc.Diamond and mc.Diamond.SourceTier or "Golden"
end
local DIAMOND_SPOTS = {
    {island = "Crystal Cave", pos = Vector3.new(-186.60, 5444.44, -2002.29)},
}
local function diamondGroups(need)
    local d = GameData.get()
    local pets = d and d.Pets
    if type(pets) ~= "table" or type(pets.Owned) ~= "table" then return nil end
    local equipped = {}
    for _, id in pairs(pets.Equipped or {}) do equipped[id] = true end
    local groups = {}
    for id, p in pairs(pets.Owned) do
        if type(p) == "table" and p.Tier == diamondSource() and not p.Locked and not p.Equip and not equipped[id]
            and not tostring(p.Rarity):find("^Secret") and type(p.Name) == "string" then
            groups[p.Name] = groups[p.Name] or {}
            table.insert(groups[p.Name], id)
        end
    end
    local ready = {}
    for name, ids in pairs(groups) do if #ids >= need then table.insert(ready, {name = name, ids = ids}) end end
    return ready
end
local function closestDiamondMachine()
    local r = root()
    if not r then return nil end
    local d = GameData.get()
    local unlocked = d and d.Progression and d.Progression.UnlockedIslands or {}
    local best, bd
    local function consider(pos)
        local dd = (pos - r.Position).Magnitude
        if not bd or dd < bd then best, bd = pos, dd end
    end
    for _, p in ipairs(CollectionS:GetTagged("InteractionPoint")) do
        if p.Name == "Diamond" and p:IsDescendantOf(workspace) then
            local ok, pos = pcall(function() return p:IsA("BasePart") and p.Position or p:GetPivot().Position end)
            if ok and pos then consider(pos) end
        end
    end
    for _, g in ipairs(DIAMOND_SPOTS) do
        if unlocked[g.island] == true then consider(g.pos) end
    end
    return best
end
-- one diamond-machine trip (same as the toggle); on() = keep going? Returns status, how many it made.
function Hatch.diamondRun(on)
    local okM, mc = pcall(function() return require(RS.Shared.Pets.MachineConfig) end)
    if not okM then mc = nil end
    local need = (mc and mc.Diamond and type(mc.Diamond.Chances) == "table" and #mc.Diamond.Chances) or 6
    if need < 1 then need = 6 end
    local ready = diamondGroups(need)
    if not ready then return "Can't read your pets", 0 end
    if #ready == 0 then return "Nothing to diamond · need " .. need .. " of the same pet", 0 end
    local r0 = root()
    local back = r0 and r0.CFrame
    local pos = closestDiamondMachine()
    if not pos then return "Can't find the diamond machine", 0 end
    local r = root()
    if r and (r.Position - pos).Magnitude > 6 then
        pcall(function() LP:RequestStreamAroundAsync(pos) end)
        if not on() then return "stopped", 0 end
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(0.8)
    end
    local made = 0
    -- if you have the "Craft All" Mastery unlock (MasteryFormula.HasUnlock(data, "CraftAll")), use the game's
    -- Craft All: MachineCraftRequested:Fire({Action = "CraftAll", Machine = "Diamond"}) - it does every set at once
    local hasCraftAll = false
    pcall(function()
        local mf = require(RS.Shared.Progression.MasteryFormula)
        hasCraftAll = mf.HasUnlock(GameData.get(), "CraftAll") == true
    end)
    if hasCraftAll and on() then
        local function countReady() local rr = diamondGroups(need) or {} local n = 0 for _, g in ipairs(rr) do n += math.floor(#g.ids / need) end return n end
        local before = countReady()
        for _ = 1, 5 do
            if not on() or countReady() == 0 then break end
            send("MachineService.RE.MachineCraftRequested", {Action = "CraftAll", Machine = "Diamond"})
            task.wait(3)
        end
        made = math.max(0, before - countReady())
    end
    for _ = 1, 50 do   -- keep going until you run out of sets (our own way, or whatever Craft All left)
        if not on() then break end
        ready = diamondGroups(need)
        if not ready or #ready == 0 then break end
        local g = ready[1]
        local ids = {}
        for i = 1, need do ids[i] = g.ids[i] end
        send("MachineService.RE.MachineCraftRequested", {Action = "Craft", Machine = "Diamond", PetIds = ids})
        made += 1
        -- wait for the pets to actually go (data updates), max 4s
        local t = os.clock()
        while os.clock() - t < 4 do
            task.wait(0.25)
            local d = GameData.get()
            if d and d.Pets and d.Pets.Owned and d.Pets.Owned[ids[1]] == nil then break end
        end
        task.wait(0.4)
    end
    r = root()
    if r and back and on() and (r.Position - back.Position).Magnitude > 20 then
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = back
    end
    pcall(function()
        local MC = require(RS.Controllers.UI.MenuController)
        local open = MC:GetOpen()
        if open ~= nil then MC:Close(open) end
    end)
    if made > 0 then
        Window:Notify({Type = "Success", Title = "Diamond machine", Content = "Made " .. made .. " diamond pet(s)"})
        return "Made " .. made .. " diamond · " .. os.date("%H:%M"), made
    end
    return "Nothing to diamond", 0
end
autoLoop(Eggs, {Side = "Right", Name = "Auto Diamond Machine", Key = "AutoDiamond", Description = "Goes to the Diamond machine (Crystal Cave) and turns golden pets diamond", Every = 5, Run = function()
    return (Hatch.diamondRun(function() return autoOn.AutoDiamond == true end))
end})
end

