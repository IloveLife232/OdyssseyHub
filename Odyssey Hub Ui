    end
    autoLoop(Farm, {Side = "Right", Name = "Auto Fishing", Description = "Reels your rods, collects the bowl, re-baits and casts rods", Flag = "AutoFishing", Every = 30, Run = function()
        local d = GameData.get()
        local fish = d and type(d.Fishing) == "table" and d.Fishing
        if not fish then return "No fishing data yet (cast a rod once by hand)" end
        local rods = type(fish.Rods) == "table" and fish.Rods or {}
        local now = os.time()
        pcall(function() now = workspace:GetServerTimeNow() end)
        local todo, empty = {}, {}
        for rodId, rod in pairs(rods) do
            if type(rod) == "table" then
                local hooked = type(rod.Hooked) == "table" and #rod.Hooked > 0
