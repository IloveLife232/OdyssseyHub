-- LEARNING: remembers the exact message the game sends for an action (equip best, auto delete, quests...)
-- the first time you do it by hand, and saves it. Buttons then send that same message. Only watches.
------------------------------------------------------------------------------------------
local RS = game:GetService("ReplicatedStorage")
local HS = game:GetService("HttpService")
local Services = RS:FindFirstChild("RemoteServices") or RS:WaitForChild("RemoteServices", 10)
local function remote(path)   -- "PetService.RE.PetActionRequested"
    local cur = Services
    for part in path:gmatch("[^%.]+") do cur = cur and cur:FindFirstChild(part) end
    return cur
end
local LowGfx = {}   -- effects hidden by Low graphics (put back when it's turned off)
local LEARN_FILE = "OdysseyTapping/learned2_" .. tostring(game.PlaceId) .. ".json"
local Learned = {}   -- ["PetService.PetActionRequested"] = { {args...}, ... } (newest last, max 30)
local function plain(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" or t == "number" or t == "boolean" then return v end
    if t == "table" and d < 5 then
        local o = {}
        for k, x in pairs(v) do
            local kk = type(k) == "number" and ("#" .. k) or tostring(k)
            o[kk] = plain(x, d + 1)
        end
        return o
    end
    return nil
end
local function unplain(v)
    if type(v) ~= "table" then return v end
    local o = {}
    for k, x in pairs(v) do
        local n = type(k) == "string" and tonumber(k:match("^#(%d+)$"))
        o[n or k] = unplain(x)
    end
    return o
end
pcall(function()
    if isfile(LEARN_FILE) then
        for k, list in pairs(HS:JSONDecode(readfile(LEARN_FILE))) do
            Learned[k] = {}
            for _, a in ipairs(list) do table.insert(Learned[k], unplain(a)) end
        end
    end
end)
local saveQueued = false
local function saveLearned()
    if saveQueued then return end
    saveQueued = true
    task.delay(2, function()
        saveQueued = false
        pcall(function()
            if not isfolder("OdysseyTapping") then makefolder("OdysseyTapping") end
            local out = {}
            for k, list in pairs(Learned) do
                out[k] = {}
                for _, a in ipairs(list) do table.insert(out[k], plain(a)) end
            end
            writefile(LEARN_FILE, HS:JSONEncode(out))
        end)
    end)
end
local LEARN_WATCH = {PetActionRequested = true, AutoDeleteRequested = true, ClaimQuest = true, Spin = true, Redeem = true, EquipPetTeam = true,
    ZoneUnlockRequested = true, IslandUnlockRequested = true, Claim = true, MachineCraftRequested = true}
local onGameCall = {}   -- other parts of the script can listen: function(remoteName, args)
local function learnCall(r, args)
    if not running or not Services or not r:IsDescendantOf(Services) then return end
    for _, fn in ipairs(onGameCall) do pcall(fn, r, args) end
    if not LEARN_WATCH[r.Name] then return end
    local key = r.Parent.Parent.Name .. "." .. r.Name
    local list = Learned[key] or {}
    Learned[key] = list
    local enc = HS:JSONEncode(plain(args) or {})
    for i, a in ipairs(list) do if HS:JSONEncode(plain(a) or {}) == enc then table.remove(list, i) break end end
    table.insert(list, args)
    if #list > 30 then table.remove(list, 1) end
    saveLearned()
end
-- the game sends some things without going through the normal hook (your hatch spy showed nothing), so the
-- RemoteEvent / RemoteFunction send functions themselves are watched too
pcall(function()
    if type(hookfunction) ~= "function" then return end
    local isOurs = function() return checkcaller and checkcaller() end
    local fe = Instance.new("RemoteEvent").FireServer
    local oldFE
    oldFE = hookfunction(fe, function(self, ...)
        if running and not isOurs() and typeof(self) == "Instance" then
            local a = table.pack(...)
            task.spawn(learnCall, self, a)
        end
        return oldFE(self, ...)
    end)
    local fi = Instance.new("RemoteFunction").InvokeServer
    local oldFI
    oldFI = hookfunction(fi, function(self, ...)
        if running and not isOurs() and typeof(self) == "Instance" then
            local a = table.pack(...)
            task.spawn(learnCall, self, a)
        end
        return oldFI(self, ...)
    end)
end)
-- call a game remote. RemoteFunctions get a time limit so a button never freezes.
local function send(path, ...)
    local r = remote(path)
    if not r then return false, "not found" end
    if r:IsA("RemoteFunction") then
        local done, res, ok = false, nil, false
        local a = table.pack(...)
        task.spawn(function() ok, res = pcall(r.InvokeServer, r, table.unpack(a, 1, a.n)) done = true end)
        local t = os.clock()
        while not done and os.clock() - t < 5 do task.wait() end
        return done and ok, res
    end
    return pcall(r.FireServer, r, ...)
end
local function sendLearned(path, which)   -- which = "last" or "all"
    local key = path:gsub("%.R[EF]%.", ".")
    local list = Learned[key]
    if not list or #list == 0 then return false end
    if which == "last" then
        local a = list[#list]
        send(path, table.unpack(a, 1, a.n or #a))
    else
        for _, a in ipairs(list) do send(path, table.unpack(a, 1, a.n or #a)) task.wait(0.2) end
    end
    return true
end

