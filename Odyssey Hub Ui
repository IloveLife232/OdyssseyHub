-- codes come from the game's own code list (if it has one in ReplicatedStorage) plus anything you type
-- current codes (from Tap Simulator Reborn code lists, checked Oct 20 2026). Codes are case-sensitive.
local KNOWN_CODES = {"BOO!", "spooky"}
local function gameCodes()
    local found, seen = {}, {}
    for _, c in ipairs(KNOWN_CODES) do seen[c] = true table.insert(found, c) end
    local function add(c)
        c = tostring(c)
        if #c >= 3 and #c <= 32 and not c:find("%s") and not seen[c] then seen[c] = true table.insert(found, c) end
    end
    for _, m in ipairs(RS:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name:lower():find("code") then
            local ok, data = pcall(require, m)
            if ok and type(data) == "table" then
                local list = data.Codes or data.codes or data
                if type(list) == "table" then
                    for k, v in pairs(list) do
                        if type(k) == "string" and (type(v) == "table" or type(v) == "boolean" or type(v) == "number") then add(k)
                        elseif type(v) == "string" then add(v)
                        elseif type(v) == "table" and (v.Code or v.code or v.Name) then add(v.Code or v.code or v.Name) end
                    end
                end
            end
        end
    end
    return found
end
