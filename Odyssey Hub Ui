local function ThemeSeq()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0,currentThemeColors.c1),
		ColorSequenceKeypoint.new(0.5,currentThemeColors.c2),
		ColorSequenceKeypoint.new(1,currentThemeColors.c3),
	})
end

local function AccentGrad(obj,rot)
	local g=Instance.new("UIGradient")
	g.Color=ThemeSeq()
	g.Rotation=rot or 0
	g.Parent=obj
	ProgressBarGradients[g]=true
	obj.AncestryChanged:Connect(function(_,p) if not p then ProgressBarGradients[g]=nil end end)
	return g
end

local function GradientButton(btn,radius)
	btn.BackgroundTransparency=1
	local fill=Instance.new("Frame")
	fill.Name="Fill"; fill.Size=UDim2.new(1,0,1,0); fill.BackgroundColor3=Color3.new(1,1,1)
	fill.BorderSizePixel=0; fill.ZIndex=btn.ZIndex; fill.Parent=btn
	local uc=Instance.new("UICorner"); uc.CornerRadius=UDim.new(0,radius or 9); uc.Parent=fill
	AccentGrad(fill,0)
	local lbl=Instance.new("TextLabel")
	lbl.Name="Label"; lbl.Text=btn.Text; lbl.TextSize=btn.TextSize; lbl.Font=btn.Font
	lbl.TextColor3=Color3.new(1,1,1); lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(1,-12,1,0)
	lbl.Position=UDim2.new(0,6,0,0); lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.ZIndex=btn.ZIndex+1; lbl.Parent=btn
	btn.TextTransparency=1
	btn:GetPropertyChangedSignal("Text"):Connect(function() if btn.Text~="" then lbl.Text=btn.Text end end)
	return fill,lbl
end
local function take(self)
	local c=self._ctr
	local o=self._order or 0
	if c then o=math.max(c.n,o); c.n=o+1 end
	self._order=o+1
	return o
end

local SKIP_GUIS={Chat=true,OdysseyUI=true,OdysseyTip=true,OdysseyNotif=true,OdysseyConfirm=true,OdysseyProgress=true,TargetGui=true,ESPGui=true,CrosshairGui=true}

local function StyleLT2Gui(v,themeColor)
	if SKIP_GUIS[v.Name] then return end
	local panelCol=C.BG:Lerp(themeColor,0.14)
	local buttonCol=C.Hover:Lerp(themeColor,0.25)
	local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)

	local all=v:GetDescendants()
	local overlay={}
	for _,d in ipairs(all) do
		if d:IsA("GuiObject") then
			local ok,sz=pcall(function() return d.AbsoluteSize end)

			if ok and sz.X>=viewport.X*0.85 and sz.Y>=viewport.Y*0.85 then overlay[d]=true end
		end
	end
	local n=0
	for _,d in ipairs(all) do
		n=n+1
		if n%250==0 then task.wait() end
		pcall(function()
				if overlay[d] or not d.Parent then return end
				if d.Name=="DropShadow" then d:Destroy() return end
				if not d:IsA("GuiObject") then return end
				if not OriginalColors[d] then
					local o={bg=d.BackgroundColor3}
					if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then o.text=d.TextColor3; o.font=d.Font end
					OriginalColors[d]=o
				end
				if (d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") or d:IsA("TextBox")) and not d:FindFirstChildWhichIsA("UICorner") then
					local uc=Instance.new("UICorner"); uc.Name="OdysseyLT2"; uc.CornerRadius=UDim.new(0,d:IsA("TextButton") and 8 or 10); uc.Parent=d
				end
				if d:IsA("TextButton") or d:IsA("ImageButton") then
					d.BackgroundColor3=buttonCol
					if d.BackgroundTransparency<0.9 and not d:FindFirstChild("OdysseyLT2Stroke") then
						local st=Instance.new("UIStroke"); st.Name="OdysseyLT2Stroke"; st.Color=C.FieldStroke; st.Thickness=1
						st.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; st.Parent=d
					end
				elseif d:IsA("TextBox") then
					d.BackgroundColor3=C.Field
				elseif d:IsA("Frame") or d:IsA("ScrollingFrame") or d:IsA("TextLabel") then
					d.BackgroundColor3=panelCol
				end
				if d:IsA("ScrollingFrame") then d.ScrollBarImageColor3=C.Muted end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					d.TextColor3=C.Text
					d.Font=d:IsA("TextButton") and Enum.Font.GothamBold or Enum.Font.GothamMedium
				end
		end)
	end
end
local lt2Busy,lt2Again=false,false
local function ApplyLT2Theme(themeColor)
	if not lt2ThemeEnabled then return end

	if lt2Busy then lt2Again=true return end
	lt2Busy=true
	task.spawn(function()
		repeat
			lt2Again=false
			for _,v in ipairs(PlayerGui:GetChildren()) do
				if not lt2ThemeEnabled then break end
				StyleLT2Gui(v,currentLT2BG)
			end
		until not lt2Again
		lt2Busy=false
	end)
end

local function RevertLT2Theme()
	for d,orig in pairs(OriginalColors) do
		pcall(function()
			if d and d.Parent then
				if orig.bg then d.BackgroundColor3=orig.bg end
				if orig.text then d.TextColor3=orig.text end
				if orig.font then d.Font=orig.font end
				for _,ch in ipairs(d:GetChildren()) do
					if ch.Name=="OdysseyLT2Stroke" or ch.Name=="OdysseyLT2" then ch:Destroy() end
				end
			end
		end)
	end
	OriginalColors={}
end

PlayerGui.ChildAdded:Connect(function(v)
	if SKIP_GUIS[v.Name] then return end
	task.wait(0.1)
	if lt2ThemeEnabled and v.Parent then StyleLT2Gui(v,currentLT2BG) end
end)
task.defer(function() if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)

local TipFrame,TipLbl,OdysseyMainRef,OdysseyGradient,OdysseyGuiRef
local function ApplyTheme(name)
	local theme=Themes[name]
	if not theme then return end
	local newSeq=ColorSequence.new({
		ColorSequenceKeypoint.new(0,theme.c1),
		ColorSequenceKeypoint.new(0.5,theme.c2),
		ColorSequenceKeypoint.new(1,theme.c3),
	})

	if OdysseyMainRef then
		pcall(function()
			for _,old in ipairs(OdysseyMainRef:GetChildren()) do
				if old:IsA("UIGradient") then old:Destroy() end
			end
			local grad=Instance.new("UIGradient")
			grad.Color=newSeq
			grad.Rotation=120
			grad.Parent=OdysseyMainRef
			OdysseyGradient=grad
		end)
