-- SLIDER: Segmented = true (default, the holo bar) or false (smooth bar with a handle)
function Tab:CreateSlider(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local range = o.Range or {0, 100}
    local minV, maxV = range[1], range[2]
    local inc = o.Increment or 1
    local value = math.clamp(saved(o.Flag, o.CurrentValue or minV), minV, maxV)
    local segmented = o.Segmented ~= false
    local box = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order, ZIndex = 4, Parent = parent})
    Text(box, {Text = spaced(string.upper(o.Name or "SLIDER")), Role = "Mid", FontFace = F.Semi, TextSize = 11, Size = UDim2.new(1, -80, 0, 16), ZIndex = 5})
    local valLbl = Text(box, {Text = "", FontFace = F.Bold, TextSize = 13, Size = UDim2.new(0, 80, 0, 16), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5})
    local hit = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 18), ZIndex = 6, Parent = box})
    local segs, fill, knob = {}, nil, nil
    if segmented then
        local row = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromOffset(0, 24), ZIndex = 5, Parent = box})
        local n = o.Segments or 10
        for i = 1, n do
            local s = New("Frame", {BorderSizePixel = 0, Size = UDim2.new(1 / n, -2, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0), ZIndex = 5, Parent = row})
            paint(s, "BackgroundColor3", "Accent")
            segs[i] = s
        end
    else
        local track = New("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.75, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 25), ZIndex = 5, Parent = box})
        paint(track, "BackgroundColor3", "Accent")
        fill = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 5, Parent = track})
        paint(fill, "BackgroundColor3", "Accent")
        knob = New("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 16), Position = UDim2.fromScale(0, 0.5), ZIndex = 6, Parent = track})
        paint(knob, "BackgroundColor3", "Hi")
    end
    local function draw()
        local p = (maxV > minV) and (value - minV) / (maxV - minV) or 0
        valLbl.Text = fmtNum(value, inc) .. (o.Suffix and (" " .. o.Suffix) or "")
        if segmented then
            local lit = math.floor(p * #segs + 0.5)
            for i, s in ipairs(segs) do s.BackgroundTransparency = (i <= lit) and 0 or 0.75 end
        else
            fill.Size = UDim2.fromScale(p, 1)
            knob.Position = UDim2.fromScale(p, 0.5)
        end
    end
    local function setFrom(x)
        local p = math.clamp((x - hit.AbsolutePosition.X) / math.max(1, hit.AbsoluteSize.X), 0, 1)
        local v = minV + (maxV - minV) * p
        v = math.clamp(math.floor(v / inc + 0.5) * inc, minV, maxV)
        if v ~= value then
            value = v
            draw()
            setFlag(o.Flag, value)
            if o.Callback then task.spawn(o.Callback, value) end
        end
    end
    local dragging = false
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true setFrom(i.Position.X) end
    end)
    table.insert(self.Conns, UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setFrom(i.Position.X) end
    end))
    table.insert(self.Conns, UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    draw()
    setFlag(o.Flag, value)
    if o.Callback then task.defer(o.Callback, value) end
    local api = {}
    function api:Set(s)
        if type(s) ~= "table" then s = {Value = s} end
        if s.Range then minV, maxV = s.Range[1], s.Range[2] end
        local nv = s.Value or s.CurrentValue
        if nv then value = math.clamp(nv, minV, maxV) setFlag(o.Flag, value) if o.Callback then task.spawn(o.Callback, value) end end
        draw()
    end
    function api:GetValue() return value end
    function api:Destroy() box:Destroy() end
    return api
end

-- DROPDOWN: Options can be strings or {Text = "Spiked Egg", Right = "200K"}; opens inline like the mockup
function Tab:CreateDropdown(o)
    o = o or {}
