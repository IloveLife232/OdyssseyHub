function Hatch.goldenRun(on, maxSets)
    local okM, mc = pcall(function() return require(RS.Shared.Pets.MachineConfig) end)
    if not okM then mc = nil end
    local need = (mc and mc.Golden and type(mc.Golden.Chances) == "table" and #mc.Golden.Chances) or 6
    if need < 1 then need = 6 end
    local ready = goldenGroups(need)
    if not ready then return "Can't read your pets", 0 end
    if #ready == 0 then return "Nothing to gold · need " .. need .. " of the same pet", 0 end
    local r0 = root()
    local back = r0 and r0.CFrame
    local pos = closestGoldenMachine()
    if not pos then return "Can't find a golden machine", 0 end
    local r = root()
    if r and (r.Position - pos).Magnitude > 6 then
        pcall(function() LP:RequestStreamAroundAsync(pos) end)
        if not on() then return "stopped", 0 end
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(0.8)
    end
    local made = 0
    -- if you have the "Craft All" Mastery unlock (MasteryFormula.HasUnlock(data, "CraftAll")), use the game's
    -- Craft All: MachineCraftRequested:Fire({Action = "CraftAll", Machine = "Golden"}) - it does every set at once
    local hasCraftAll = false
    pcall(function()
        local mf = require(RS.Shared.Progression.MasteryFormula)
        hasCraftAll = mf.HasUnlock(GameData.get(), "CraftAll") == true
    end)
    if hasCraftAll and on() then
        local function countReady() local rr = goldenGroups(need) or {} local n = 0 for _, g in ipairs(rr) do n += math.floor(#g.ids / need) end return n end
        local before = countReady()
        for _ = 1, 5 do
            if not on() or countReady() == 0 then break end
            send("MachineService.RE.MachineCraftRequested", {Action = "CraftAll", Machine = "Golden"})
            task.wait(3)
        end
        made = math.max(0, before - countReady())
    end
    for _ = 1, 50 do   -- keep going until you run out of sets (our own way, or whatever Craft All left)
        if not on() then break end
        if maxSets and made >= maxSets then break end
        ready = goldenGroups(need)
        if not ready or #ready == 0 then break end
        local g = ready[1]
        local ids = {}
        for i = 1, need do ids[i] = g.ids[i] end
        send("MachineService.RE.MachineCraftRequested", {Action = "Craft", Machine = "Golden", PetIds = ids})
        made += 1
        -- wait for the pets to actually go (data updates), max 4s
        local t = os.clock()
        while os.clock() - t < 4 do
            task.wait(0.25)
            local d = GameData.get()
            if d and d.Pets and d.Pets.Owned and d.Pets.Owned[ids[1]] == nil then break end
        end
        task.wait(0.4)
    end
    r = root()
    if r and back and on() and (r.Position - back.Position).Magnitude > 20 then
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = back
    end
    pcall(function()
        local MC = require(RS.Controllers.UI.MenuController)
        local open = MC:GetOpen()
        if open ~= nil then MC:Close(open) end
    end)
    if made > 0 then
        Window:Notify({Type = "Success", Title = "Golden machine", Content = "Made " .. made .. " golden pet(s)"})
        return "Made " .. made .. " golden · " .. os.date("%H:%M"), made
    end
    return "Nothing to gold", 0
end
