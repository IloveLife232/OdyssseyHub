    local bought, waiting, total, owned = 0, nil, 0, 0
    local r0 = root()
    local back = r0 and r0.CFrame
    for lineName, line in pairs(pcfg.Lines) do
        if not autoOn.AutoPads then break end
        -- the island Luck / Speed pads are switched off in the game right now (IslandUpgradeConfig.Enabled = false)
        if not (line.Tiered and icfg and icfg.Enabled == false) then
            total += #line.Prices
