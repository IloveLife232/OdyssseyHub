        for _, v in ipairs({...}) do if type(v) == "table" and v.Phase then HW.state = v end end
    end))
end)
pcall(function()
    track(remote("HallowBossService.RE.Attack").OnClientEvent:Connect(function(a)
        if not HW.dodging or type(a) ~= "table" or type(a.Targets) ~= "table" then return end
        local r, p = root(), HW.platform()
        if not (r and p) then return end
        local cfg = rcfg("Shared.Game.HallowBossConfig")
        local radius = tonumber(a.Radius) or (cfg and cfg.BombRadius) or 10
        local targets, close = {}, false
        for _, t in pairs(a.Targets) do
            if typeof(t) == "Vector3" then
                table.insert(targets, t)
                if (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(t.X, 0, t.Z)).Magnitude <= radius + 3 then close = true end
            end
        end
        if close then
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.new(HW.platformSpot(p, targets, radius))
        end
    end))
end)
-- one round of the boss: go there when it's about to start, stand on the platform and tap during the fight,
-- go back where you were once it's over. on() = toggle still on. Returns status, busy (true while a fight is on)
function HW.bossStep(on)
    -- the boss fight takes the busy lock while it's on (Auto Quest / Auto Hallow Lord may run it), and doesn't
    -- pull you out of a wave or mansion run
    local other = AUTO.blockedFor("AutoHallowBoss")
    if other == "Hallow Lord" then other = nil end
    if other then return "waiting · finishing " .. other, false end
    local msg, busy = HW.bossStepInner(on)
    if busy then AUTO.lockOn("Hallow Lord", {AutoQuest = true, AutoHallowBoss = true}) else AUTO.lockOff("Hallow Lord") end
    return msg, busy
end
function HW.bossStepInner(on)
    local st = HW.bossState()
    local phase = st.Phase or "Idle"
    -- only head over in the last 30 seconds before the fight (if the game told us when it starts)
    if phase == "Warning" and not HW.bossBack then
        local startsAt = HW.state and tonumber(HW.state.StartsAt)
        local left = startsAt and (startsAt - workspace:GetServerTimeNow())
        if left and left > 30 then return "Hallow Lord in " .. math.ceil(left) .. "s · going at 30s", false end
    end
    if phase == "Warning" or phase == "Fight" then
        if not on() then HW.dodging = false return "stopped", false end
        local r = root()
        if r and not HW.bossBack then HW.bossBack = r.CFrame end
        local p = HW.go(on, HW.platform)
        if not p then return on() and "Couldn't find the boss platform" or "stopped", true end
        r = root()
        if r and not st.InZone then
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.new(HW.platformSpot(p))
            task.wait(0.3)
        end
        HW.dodging = true
        if phase == "Warning" then return "Hallow Lord is coming · waiting on the platform", true end
        if not autoTap then for _ = 1, 40 do if not on() then break end pcall(tapOnce) end end
        return "Fighting the Hallow Lord" .. (st.MyDamage and (" · " .. short(st.MyDamage) .. " damage") or ""), true
    end
    HW.dodging = false
    if HW.bossBack then
        local r = root()
        if r and on() then r.AssemblyLinearVelocity = Vector3.new() r.CFrame = HW.bossBack end
        HW.bossBack = nil
        if phase == "Defeated" then Window:Notify({Type = "Success", Title = "Hallow Lord", Content = "Defeated!"}) end
    end
    return "Waiting for the Hallow Lord" .. (phase ~= "Idle" and (" · " .. phase) or ""), false
end

