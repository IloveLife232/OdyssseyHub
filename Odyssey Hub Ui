	function api:GetText() return tb.Text end
	function api:SetDropdown(v) ddSelected=v; ddHeader.Text=tostring(v); ddBuild() end
	function api:GetDropdown() return ddSelected end
	function api:Destroy() card:Destroy() end
	return api
end

function Tab:CreateDropdown(opts)
	opts=opts or {}
	local options=opts.Options or {}
	local multi=opts.MultipleOptions or false
	local cb=opts.Callback
	local special=opts.SpecialType
	if special=="Player" then
		options={}
		for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
	end
	local flag=opts.Flag
	local selected
	if multi then
		selected=saved(flag,type(opts.CurrentOption)=="table" and opts.CurrentOption or (opts.CurrentOption and {opts.CurrentOption} or {}))
		if type(selected)~="table" then selected={selected} end
	else
		selected=saved(flag,opts.CurrentOption or (options[1]~=nil and textOf(options[1])) or "")
		if type(selected)=="table" then selected=selected[1] or "" end
		selected=textOf(selected)
	end
	local function selText()
		local s=multi and (type(selected)=="table" and table.concat(selected,", ") or tostring(selected)) or tostring(selected)
		if s=="" then return "Select..." end
		return s
	end
	local open=false
	local card=_slot(self,true)
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,Parent=card})
	VList(vl,6)
	local head=_title(vl,opts.Name or "Dropdown",opts.Description,1)
	if tipOnly(opts) then AddTooltip(head,opts.Tooltip) end
	local header=_fieldBox({Class="TextButton",Parent=vl,Text=selText(),LayoutOrder=2})
	header.TextTruncate=Enum.TextTruncate.AtEnd
	Pad(header,0,30,0,10)
	local arrow=_chev(header)
	arrow.Position=UDim2.new(1,24,0.5,0)
	local body,bvl,optS=_optionList(vl,3)
	local sb=_fieldBox({Parent=bvl,LayoutOrder=1,Size=UDim2.new(1,0,0,28),Placeholder="Search..."})
	sb.BackgroundColor3=C.Card
	Pad(sb,0,8,0,8)
	local optBtns={}
	local function isSel(o) o=textOf(o) return multi and type(selected)=="table" and table.find(selected,o) or selected==o end
	local function build(list)
		for _,b in ipairs(optBtns) do b:Destroy() end
		optBtns={}
		for _,opt in ipairs(list) do
			local ob=_optionBtn(optS,opt,isSel(opt) and true or false)
			ob.MouseButton1Click:Connect(function()
				local t=textOf(opt)
				if multi then
					if type(selected)~="table" then selected={} end
					local idx=table.find(selected,t)
					if idx then table.remove(selected,idx) else table.insert(selected,t) end
				else
					selected=t; open=false; body.Visible=false; arrow.Rotation=0
				end
				header.Text=selText()
				build(list)
				if flag then Odyssey.Flags[flag]=selected end
				if cb then task.spawn(cb,selected) end
			end)
			table.insert(optBtns,ob)
		end
		optS.Size=UDim2.new(1,0,0,math.min(#list,opts.MaxVisible or 6)*30)
		sb.Visible=#options>6
	end
	build(options)
	sb:GetPropertyChangedSignal("Text"):Connect(function()
		local q=sb.Text:lower()
		local f={}
		for _,o in ipairs(options) do if textOf(o):lower():find(q,1,true) then table.insert(f,o) end end
		build(f)
	end)
	header.MouseButton1Click:Connect(function()
		open=not open
		body.Visible=open
		arrow.Rotation=open and 180 or 0
		if open then sb.Text=""; build(options) end
	end)
	if special=="Player" then
		local function refresh()
			options={}
			for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
			if open then build(options) end
		end
		Players.PlayerAdded:Connect(refresh)
		Players.PlayerRemoving:Connect(function() task.wait(0.1); refresh() end)
	end
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o)
		if o.Options then options=o.Options; build(options) end
		if o.CurrentOption~=nil then
			if multi then selected=type(o.CurrentOption)=="table" and o.CurrentOption or {textOf(o.CurrentOption)}
			else selected=textOf(type(o.CurrentOption)=="table" and o.CurrentOption[1] or o.CurrentOption) end
			if flag then Odyssey.Flags[flag]=selected end
			build(options)
		end
		header.Text=selText()
	end
	function api:Refresh(list) api:Set({Options=list}) end
	function api:SetDescription(d) _setDesc(head,d) end
	function api:GetValue() return selected end
	function api:Destroy() card:Destroy() end
	if flag then Odyssey.Flags[flag]=selected end
	if cb and (multi or selected~="") then task.defer(cb,selected) end
	return api
end

function Tab:CreateColorPicker(opts)
