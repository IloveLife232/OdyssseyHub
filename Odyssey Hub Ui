-- AUTO DELETE (from the game's EggController): the game's Auto Delete is per egg. For each egg it keeps a list
-- of "delete keys" (one per pet, HatchRulesConfig.AutoDeleteKey(petName, "Normal")) and sends the whole list:
--   EggService.AutoDeleteRequested:Fire({Egg = <egg>, Entries = {<keys>}})
-- This adds every pet below Legendary from every egg (LaunchEggConfig[egg].Pets, rarity from LaunchPetConfig)
-- to that list, and keeps anything you ticked yourself. Secret pets are never added. It only deletes pets the
-- moment they hatch, so pets you own / have equipped are never touched.
local function shared(name)
    local ok, c = pcall(function() return require(RS.Shared.Pets:FindFirstChild(name)) end)
    return ok and c or nil
end
local function lowKeysFor(egg, eggCfg, petCfg, rules)
    local keys = {}
    local legendaryRank = rules and rules.GetRank and rules.GetRank("Legendary")
    for petName in pairs(eggCfg.Pets or {}) do
        local info = petCfg and petCfg[petName]
        local rarity = info and info.Rarity or "Common"
        -- by name first (Common / Uncommon / Rare / Epic); only unknown rarity names use the game's rank
        local low = LOW[rarity] == true
        if not low and not table.find(RARITY_ORDER, rarity) and legendaryRank and rules.GetRank then
            local ok, r = pcall(rules.GetRank, rarity)
            low = ok and type(r) == "number" and r < legendaryRank
        end
        if low then
            local ok, key = pcall(rules.AutoDeleteKey, petName, "Normal")
            table.insert(keys, ok and key or petName)
        end
    end
    return keys
end
local function setAutoDeleteAll(on)
    local eggs, pets, rules = shared("LaunchEggConfig"), shared("LaunchPetConfig"), shared("HatchRulesConfig")
    if type(eggs) ~= "table" then return 0, "can't read the egg list" end
    if type(rules) ~= "table" then return 0, "can't read the hatch rules" end
    local d = GameData.get()
    local current = d and d.Eggs and d.Eggs.AutoDelete or {}
    local n = 0
    for egg, eggCfg in pairs(eggs) do
        if type(eggCfg) == "table" then
            local keys = lowKeysFor(egg, eggCfg, pets, rules)
            local list = table.clone(type(current[egg]) == "table" and current[egg] or {})
            local changed = false
            for _, k in ipairs(keys) do
                local at = table.find(list, k)
                if on and not at then table.insert(list, k) changed = true end
                if not on and at then table.remove(list, at) changed = true end
            end
            if changed then
                send("EggService.RE.AutoDeleteRequested", {Egg = egg, Entries = list})
                print(("[Odyssey] auto delete %s: %s -> %d pets on the delete list"):format(egg, on and "on" or "off", #list))
                n += 1
                task.wait(0.15)
            end
        end
    end
    return n
end
-- DELETE NON-LEGENDARY PETS ALREADY IN YOUR INVENTORY (from the game's InventoryController):
-- your pets are in Data.Pets.Owned ({Id, Name, Rarity, Tier, Locked, Equip ...}); the game deletes through
-- its PetDeleteRequest module, which sends PetService.PetActionRequested. Skipped, always: equipped pets,
-- locked pets, the pet in the enchanter, anything Legendary or better, and Golden/other tiers (Normal only).
-- which tiers Auto Delete / the Delete button remove (the game calls Rainbow "Shiny")
Hatch.delTiers = {Normal = true}
local function deletablePets()
    local d = GameData.get()
    local pets = d and d.Pets
    if not (pets and type(pets.Owned) == "table") then return nil end
    local equipped = {}
    for _, id in pairs(pets.Equipped or {}) do equipped[id] = true end
    local inEnchanter = LP:GetAttribute("EnchantHeldPet")
    local ids = {}
    for id, p in pairs(pets.Owned) do
        if type(p) == "table" and LOW[tostring(p.Rarity)] and Hatch.delTiers[tostring(p.Tier or "Normal")] == true
            and not tostring(p.Rarity):find("^Secret")
            and p.Locked ~= true and p.Equip ~= true and not equipped[id] and id ~= inEnchanter then
            table.insert(ids, id)
        end
    end
    return ids
end
local function deletePets(ids)
    -- 1) the game's own delete module (same message the Delete button sends)
    local ok = pcall(function()
        local PDR = require(RS.Modules.Client.Pets.PetDeleteRequest)
        pcall(PDR.Init, {
            Fire = function(payload) send("PetService.RE.PetActionRequested", payload) end,
            Notify = function() end,
            GetOwned = function() local d = GameData.get() return d and d.Pets and d.Pets.Owned or {} end,
        })
        for i = 1, #ids, 50 do
            local chunk = {}
            for j = i, math.min(i + 49, #ids) do table.insert(chunk, ids[j]) end
            PDR.Send(chunk, false, true)
            task.wait(0.4)
        end
    end)
    if ok then return true end
    -- 2) backup: the usual delete message, 50 at a time
    for i = 1, #ids, 50 do
        local chunk = {}
        for j = i, math.min(i + 49, #ids) do table.insert(chunk, ids[j]) end
        send("PetService.RE.PetActionRequested", {Action = "Delete", PetIds = chunk})
        task.wait(0.4)
    end
    return false
end
