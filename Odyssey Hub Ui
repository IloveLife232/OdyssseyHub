-- UI FROM ANY THREAD: a thread that waited on the game's own code (a machine, a menu, a remote) comes back without
-- the right to touch the UI ("lacking capability Plugin"), so pop-ups / toggle text from it errored. Every UI change
-- (Notify, SetDescription, Set, Refresh ...) now goes through one runner started here, which always has that right.
;(function()
    local q = {}
    task.spawn(function()
        while true do
            local job = table.remove(q, 1)
            if job then task.spawn(pcall, job) else task.wait(0.03) end
        end
    end)
    local function queue(fn) table.insert(q, fn) end
    local function wrapApi(api)
        if type(api) ~= "table" then return api end
        for k, v in pairs(api) do
            if type(k) == "string" and type(v) == "function" and (k:sub(1, 3) == "Set" or k == "Refresh" or k == "Destroy") then
                api[k] = function(self, ...)
                    local args = table.pack(...)
                    queue(function() v(self, table.unpack(args, 1, args.n)) end)
                end
            end
        end
        return api
    end
    for _, name in ipairs({"Notify", "SetStatus", "Confirm"}) do
        local orig = Window[name]
        if type(orig) == "function" then
            Window[name] = function(self, ...)
                local args = table.pack(...)
                queue(function() orig(self, table.unpack(args, 1, args.n)) end)
            end
        end
    end
    local origTab = Window.CreateTab
    Window.CreateTab = function(self, ...)
        local tab = origTab(self, ...)
        if type(tab) == "table" then
            for _, name in ipairs({"CreateToggle", "CreateDropdown", "CreateParagraph", "CreateLabel", "CreateStat", "CreateSlider",
                "CreateInput", "CreateBind", "CreateKeybind", "CreateChoice", "CreateRing", "CreateProgress", "CreateButton"}) do
                local orig = tab[name]
                if type(orig) == "function" then tab[name] = function(t, ...) return wrapApi(orig(t, ...)) end end
            end
        end
        return tab
    end
end)()

