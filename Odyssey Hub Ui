    for _, c in ipairs(TAP_CHESTS) do
        if unlocked[c.island] == true then
            local at = tonumber(type(d.TapChests) == "table" and d.TapChests[c.id]) or 0
            if at <= now then table.insert(ready, c) else soonest = math.min(soonest or math.huge, at - now) end
        end
    end
    if #ready == 0 then
        return soonest and ("No chest ready · next in " .. (soonest >= 3600 and string.format("%dh %02dm", soonest // 3600, (soonest % 3600) // 60) or (math.ceil(soonest / 60) .. "m"))) or "Unlock Sky Island / Desert for the chests"
    end
    local r0 = root()
    local back = r0 and r0.CFrame
    local got = 0
    for _, c in ipairs(ready) do
        if not (running and claimOn["TapChestService.RF.Claim"]) then break end
        local pos = c.pos
        pcall(function()
            for _, m in ipairs(CollectionS:GetTagged("TapChest")) do
                if m:GetAttribute("TapChestId") == c.id then
                    local front = m:GetAttribute("TapChestFront")
                    pos = typeof(front) == "CFrame" and front.Position or m:GetPivot().Position
                end
            end
        end)
        local r = root()
        if r then
            pcall(function() LP:RequestStreamAroundAsync(pos) end)
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
            task.wait(0.8)
        end
        local ok, res = send("TapChestService.RF.Claim", c.id)
