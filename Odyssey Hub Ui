-- PLAYER: island teleports
------------------------------------------------------------------------------------------
-- Islands come from the game's IslandConfig (in unlock order). Teleport goes straight to the island (no portal):
-- it drops you onto the island itself: workspace.IslandParts has one box per island, and a ray finds the ground in it.
-- Locked islands work too this way, so you can fly up to a portal and buy it.
local function islandList()
    local c = cfg("Shared.Progression.IslandConfig")
    local list = {}
    for name, info in pairs(c and c.Islands or {}) do table.insert(list, {name = name, order = info.Order or 99, price = info.Price}) end
    table.sort(list, function(a, b) return a.order < b.order end)
    local names = {"Spawn"}
    for _, i in ipairs(list) do table.insert(names, i.name) end
    return names
end
local function groundIn(part)
    local top = part.Position + Vector3.new(0, part.Size.Y / 2, 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char(), workspace:FindFirstChild("IslandParts")}
    local hit = workspace:Raycast(top, Vector3.new(0, -(part.Size.Y + 500), 0), params)
    return hit and (hit.Position + Vector3.new(0, 4, 0)) or (part.Position + Vector3.new(0, 4, 0))
end
local function islandSpot(name)
    if ISLAND_SPOTS[name] then return ISLAND_SPOTS[name] end
    if name == "Spawn" then
        local sp = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
        return sp and (sp.Position + Vector3.new(0, 5, 0))
    end
    local parts = workspace:FindFirstChild("IslandParts")
    local part = parts and parts:FindFirstChild(name)
    if part and part:IsA("BasePart") then return groundIn(part) end
    -- not loaded? the island model / its portal
    local isl = workspace:FindFirstChild("Ts2Islands") and workspace.Ts2Islands:FindFirstChild(name)
    if isl then local ok, piv = pcall(function() return isl:GetPivot().Position end) if ok then return piv + Vector3.new(0, 8, 0) end end
    return nil
end
local function tpToIsland(islandPick)   -- used by WORLD > Places > Islands
    -- straight teleport to the saved spot (no portal / game travel)
    local r = root()
    if not r then return end
    local spot = islandSpot(islandPick)
    if not spot then Window:Notify({Type = "Warning", Content = "Couldn't find " .. islandPick .. " yet"}) return end
    pcall(function() LP:RequestStreamAroundAsync(spot) end)
    r.AssemblyLinearVelocity = Vector3.new()
    r.CFrame = CFrame.new(spot)
    settleOnGround(r)
end

-- SHINY STARS (from the game's ShinyStarController / ShinyStarConfig): 15 stars, 2-3 per island. Each one is a model
-- tagged "ShinyStar" with ShinyStarId + ShinyStarCenter; you pick it up within 6 studs with
-- ShinyStarService:Collect(<id>). Found ones are in Data.ShinyStars.Found. Centers below are from your star scan,
-- used when the island isn't loaded.
do
    local STAR_SPOTS = {
        Spawn1 = Vector3.new(53.60, -513.27, -2015.70), Spawn2 = Vector3.new(-4.40, -513.27, -1699.50), Spawn3 = Vector3.new(-100.69, -381.31, -1469.50),
        SkyIsland1 = Vector3.new(-79.70, -49.07, -1930.40), SkyIsland2 = Vector3.new(-61.91, -53.57, -1791.14),
        Autumn1 = Vector3.new(-125.50, 905.13, -1978.30), Autumn2 = Vector3.new(23.60, 882.83, -1947.90),
        Mushroom1 = Vector3.new(78.90, 2034.53, -1996.00), Mushroom2 = Vector3.new(-124.10, 2032.53, -2067.90),
        Desert1 = Vector3.new(13.20, 3643.33, -2165.90), Desert2 = Vector3.new(59.10, 3636.43, -1979.10),
        CrystalCave1 = Vector3.new(-235.00, 5444.93, -2050.90), CrystalCave2 = Vector3.new(19.70, 5446.53, -2033.50),
        ShadowRelm1 = Vector3.new(13.20, 7692.23, -2106.30), ShadowRelm2 = Vector3.new(197.80, 7698.43, -1858.60),
    }
    local ORDER = {"Spawn1", "Spawn2", "Spawn3", "SkyIsland1", "SkyIsland2", "Autumn1", "Autumn2", "Mushroom1", "Mushroom2",
        "Desert1", "Desert2", "CrystalCave1", "CrystalCave2", "ShadowRelm1", "ShadowRelm2"}
    local function starCenter(id)
        local ok, tagged = pcall(function() return CollectionS:GetTagged("ShinyStar") end)
        for _, m in ipairs(ok and tagged or {}) do
            if m:GetAttribute("ShinyStarId") == id then
                local c = m:GetAttribute("ShinyStarCenter")
                if typeof(c) == "Vector3" then return c end
                local ok, p = pcall(function() return m:GetPivot().Position end)
                if ok then return p end
            end
        end
        return STAR_SPOTS[id]
    end
    local busy = false
    World:CreateSection({Name = "Shiny stars", Side = "Left"})
    local starStat = World:CreateLabel({Side = "Left", Text = "Picks up every shiny star you haven't found, then brings you back."})
    World:CreateButton({Side = "Left", Name = "Get all shiny stars", Style = "Primary", Callback = function()
        if busy then return end
        busy = true
        task.spawn(function()
            local d = GameData.get()
            local found = d and type(d.ShinyStars) == "table" and type(d.ShinyStars.Found) == "table" and d.ShinyStars.Found or {}
            local ids, islandOf = {}, {}
            pcall(function()
                local cfg = require(RS.Shared.Game.ShinyStarConfig)
                for _, st in ipairs(cfg.Stars) do table.insert(ids, st.Id) islandOf[st.Id] = st.Island end
            end)
            if #ids == 0 then ids = ORDER end
            local ISL = {Spawn = "Spawn", SkyIsland = "Sky Island", Autumn = "Autumn", Mushroom = "Mushroom", Desert = "Desert",
                CrystalCave = "Crystal Cave", ShadowRelm = "Shadow Realm"}
            local unlocked = d and d.Progression and d.Progression.UnlockedIslands or {}
            local lockedIslands, lockedCount = {}, 0
            local r0 = root()
            local back = r0 and r0.CFrame
            local got, missing = 0, 0
            for _, id in ipairs(ids) do
                local isl = islandOf[id] or ISL[(id:gsub("%d+$", ""))] or "Spawn"
                local open = isl == "Spawn" or unlocked[isl] == true
                if found[id] ~= true and not open then
                    -- island not unlocked yet: skip it, you'll be told which islands to unlock
                    lockedCount += 1
                    if not table.find(lockedIslands, isl) then table.insert(lockedIslands, isl) end
                elseif found[id] ~= true then
                    local c = starCenter(id)
                    local r = root()
                    if c and r then
                        starStat:Set("Getting " .. id .. "...")
                        pcall(function() LP:RequestStreamAroundAsync(c) end)
                        r.AssemblyLinearVelocity = Vector3.new()
                        r.CFrame = CFrame.new(c + Vector3.new(0, 1, 0))
                        task.wait(0.6)
                        local ok, res = send("ShinyStarService.RF.Collect", id)
                        if ok and (res == true or (type(res) == "table" and res.Success ~= false)) then got += 1 else missing += 1 end
                        task.wait(0.4)
                    else
                        missing += 1
                    end
                end
            end
            local r = root()
            if r and back then
                pcall(function() LP:RequestStreamAroundAsync(back.Position) end)
                r.AssemblyLinearVelocity = Vector3.new()
                r.CFrame = back
            end
            local d2 = GameData.get()
            local total = 0
            for _, v in pairs(d2 and d2.ShinyStars and d2.ShinyStars.Found or {}) do if v == true then total += 1 end end
            starStat:Set("Found " .. total .. " / " .. #ids .. " shiny stars")
            Window:Notify({Type = got > 0 and "Success" or "Info", Title = "Shiny stars", Content = got > 0 and ("Picked up " .. got .. " · " .. total .. "/" .. #ids .. " found") or ("Nothing new · " .. total .. "/" .. #ids .. " found")})
            if lockedCount > 0 then
                Window:Notify({Type = "Warning", Duration = 8, Title = "Shiny stars", Content = lockedCount .. " star(s) wait until you unlock: " .. table.concat(lockedIslands, ", ")})
                starStat:Set("Found " .. total .. " / " .. #ids .. " · unlock " .. table.concat(lockedIslands, ", ") .. " for the rest")
            end
            busy = false
        end)
    end})
end

-- PLACES: quick teleports to the game's stations, by category (spots from your scans; the ones that move around,
-- like the Candy Witch or the boss platform, are looked up live). No eggs here - those are in EGGS.
do
    local function V(x, y, z) return Vector3.new(x, y, z) end
    local function livePos(inst)
        local ok, p = pcall(function() return inst:IsA("BasePart") and inst.Position or inst:GetPivot().Position end)
        return ok and p or nil
    end
    -- machines of the same kind on several islands: the one you're near (within 150 studs), otherwise the one
    -- closest in height (the islands are stacked on top of each other)
    local function closestOf(list)
        local r = root()
        if not r then return list[1] end
        local best, bd
        for _, p in ipairs(list) do
            if (p - r.Position).Magnitude <= 150 then return p end
            local dy = math.abs(p.Y - r.Position.Y)
            if not bd or dy < bd then best, bd = p, dy end
        end
        return best
    end
    local PLACES = {
        {"Shops", {
            {"Jump Shop (double jump machine)", function()
                local best, bd
                local r = root()
                for _, m in ipairs(CollectionS:GetTagged("DoubleJumpMachine")) do
                    if m:IsDescendantOf(workspace) and r then
                        local p = livePos(m)
                        if p and (not bd or (p - r.Position).Magnitude < bd) then best, bd = p, (p - r.Position).Magnitude end
                    end
                end
                -- stand in front of it, not on top of it
                return (best and bd and bd < 200) and (best + Vector3.new(0, -6.8, -1.9)) or V(-98.26, -515.43, -1680.08)
            end},
            {"Rebirth Shop (Skill Tree)", function() return closestOf({
                V(-109.83, -518.45, -1856.71), V(-67.19, -61.36, -1823.94), V(-89.18, 891.65, -1948.41), V(-159.12, 1999.56, -1959.04),
                V(-149.99, 3636.56, -1956.17), V(88.85, 5438.95, -1803.50), V(-117.32, 15312.31, -1792.74)}) end},
        }},
        {"Machines", {
            {"Golden Machine", function() return closestOf({
                V(14.47, -515.97, -1885.65), V(-110.18, -50.44, -1854.49), V(-130.85, 881.24, -1726.21), V(4.31, 2018.09, -1779.99),
                V(32.09, 3633.84, -1966.96), V(-146.51, 5444.54, -2044.90), V(47.00, 7679.44, -1722.86), V(-141.56, 15315.29, -1811.29)}) end},
            {"Rainbow Machine", function() return closestOf({V(90.68, 7677.64, -1933.54), V(-106.90, 11104.24, -2021.28), V(134.25, 15320.43, -1812.28)}) end},
            {"Diamond Machine", V(-186.60, 5444.44, -2002.29)},
            {"Secret Fusion", function() return closestOf({V(-175.39, 11085.68, -2019.48), V(-132.79, 15337.16, -1973.00)}) end},
            {"Enchanting", function() return closestOf({V(127.14, 7687.35, -1802.73), V(130.89, 15344.68, -1974.47)}) end},
            {"Shrine blessing (Autumn)", function()
                local ok, sc = pcall(function() return require(RS.Shared.Game.ShrineConfig) end)
                local m = ok and sc.FindShrine and sc.FindShrine()
                return m and livePos(m) or ISLAND_SPOTS["Autumn"]
            end},
        }},
        {"Chests", {
            {"Tap Chest (big chest)", function() return closestOf({V(-9.39, -51.19, -1882.17), V(-64.35, 3645.0, -2120.91)}) end},
        }},
        {"Minigames", {
            {"Wave Defense (Mushroom)", V(-169.69, 2020.27, -1794.68)},
            {"Fishing (Heaven Falls)", V(24.34, 15348.72, -2069.91)},
            {"Mine (Crystal Cave)", function()
                -- the mine's way in is a "Teleport" pad hidden in Crystal Cave's trees (the game's MiningWorld.Portal):
                -- load Crystal Cave, find the pad, stand on it
                local function pad()
                    local ok, mw = pcall(function() return require(RS.Shared.Minigames.Mining.MiningWorld) end)
                    local p = ok and mw and mw.Portal and mw.Portal()
                    return p and p.Position or nil
                end
                local pos = pad()
                if not pos then
                    local r = root()
                    local spot = ISLAND_SPOTS["Crystal Cave"]
                    if r and spot then
                        pcall(function() LP:RequestStreamAroundAsync(spot) end)
                        r.AssemblyLinearVelocity = Vector3.new()
                        r.CFrame = CFrame.new(spot + Vector3.new(0, 10, 0))
                        for _ = 1, 40 do pos = pad() if pos then break end task.wait(0.1) end
                    end
                end
                return pos and (pos - Vector3.new(0, 2, 0)) or nil
            end},
        }},
        {"Halloween", {
            {"Halloween Island", V(-1866.27, -509.76, -2014.77)},
            {"Halloween Shop (daily shop)", V(-1858.80, -510.88, -2055.84)},
            {"Halloween portal (Spawn)", V(-46.80, -491.54, -1981.15)},
        }},
    }
    local catNames, byCat = {"Islands", "Players"}, {}
    for _, c in ipairs(PLACES) do table.insert(catNames, c[1]) byCat[c[1]] = c[2] end
    local function placeNames(cat)
        if cat == "Islands" then return islandList() end
        if cat == "Players" then return playerNames() end
        local t = {}
        for _, p in ipairs(byCat[cat] or {}) do table.insert(t, p[1]) end
        return t
    end
    local pickCat, pickPlace = catNames[1], placeNames(catNames[1])[1]
    World:CreateSection({Name = "Places", Side = "Left"})
    local placeDrop
    World:CreateDropdown({Side = "Left", Name = "Category", Options = catNames, CurrentOption = pickCat, MaxVisible = 6, Callback = function(v)
        pickCat = v
        local list = placeNames(v)
        pickPlace = list[1]
        if placeDrop then pcall(function() placeDrop:Set({Options = list, CurrentOption = list[1]}) end) end
    end})
    placeDrop = World:CreateDropdown({Side = "Left", Name = "Place", Options = placeNames(pickCat), CurrentOption = pickPlace, MaxVisible = 6, Callback = function(v) pickPlace = v end})
    -- the player list changes as people join / leave
    local function refreshIfPlayers()
        if pickCat == "Players" and placeDrop then
            local list = playerNames()
            if not table.find(list, pickPlace) then pickPlace = list[1] end
            pcall(function() placeDrop:Set({Options = list, CurrentOption = pickPlace}) end)
        end
    end
    track(Players.PlayerAdded:Connect(refreshIfPlayers))
    track(Players.PlayerRemoving:Connect(function() task.defer(refreshIfPlayers) end))
    World:CreateButton({Side = "Left", Name = "Go there", Style = "Primary", Callback = function()
        if pickCat == "Islands" then tpToIsland(pickPlace) return end
        if pickCat == "Players" then if pickPlace and not tostring(pickPlace):find("^%(") then tpToPlayer(pickPlace) end return end
        local spot
        for _, p in ipairs(byCat[pickCat] or {}) do
            if p[1] == pickPlace then
                if type(p[2]) == "function" then local ok, v = pcall(p[2]) spot = ok and v or nil else spot = p[2] end
            end
        end
        local r = root()
        if not (spot and r) then Window:Notify({Type = "Warning", Content = "Couldn't find " .. tostring(pickPlace) .. " right now"}) return end
        pcall(function() LP:RequestStreamAroundAsync(spot) end)
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(spot + Vector3.new(0, 4, 0))
    end})
end

