    local spot = ISLAND_SPOTS[isl]
    if spot then
        pcall(function() LP:RequestStreamAroundAsync(spot) end)
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(spot)
    else
        -- no saved spot (event islands): travel there the way the game's island menu does
        if not send("IslandService.RF.Travel", {Island = isl, Source = "Menu"}) then send("IslandService.RE.Travel", {Island = isl, Source = "Menu"}) end
    end
    for _ = 1, 40 do pcall(scanEggs) if eggSpot(egg) then return true end task.wait(0.1) end
    return eggSpot(egg) ~= nil, "Couldn't find " .. egg .. " on " .. isl
end
