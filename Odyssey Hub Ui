track(RunService.RenderStepped:Connect(function()
    if not fly.on then return end
    local r, h, cam = root(), hum(), workspace.CurrentCamera
    if not (r and h and cam) then return end
    if not (fly.bv and fly.bv.Parent == r) then
        stopFly()
        fly.bv = Instance.new("BodyVelocity")
        fly.bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        fly.bv.Velocity = Vector3.new()
        fly.bv.Parent = r
        fly.bg = Instance.new("BodyGyro")
        fly.bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        fly.bg.P = 9e4
        fly.bg.Parent = r
    end
    h.PlatformStand = true
    -- MoveDirection already follows the camera's yaw (works for keyboard and mobile stick); add the camera's pitch
    local md = h.MoveDirection
    local dir = Vector3.new()
    if md.Magnitude > 0 then
        local localMove = cam.CFrame:VectorToObjectSpace(md)
        local flat = Vector3.new(localMove.X, 0, localMove.Z)
        if flat.Magnitude > 0 then dir = cam.CFrame:VectorToWorldSpace(flat.Unit) end
    end
    if not UIS:GetFocusedTextBox() then
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) then dir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
    end
    fly.bv.Velocity = dir.Magnitude > 0 and dir.Unit * fly.speed or Vector3.new()
    fly.bg.CFrame = cam.CFrame
end))

