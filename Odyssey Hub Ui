-- TOGGLE: big holo card with the glowing slide switch
function Tab:CreateToggle(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local win = self.Window
    local value = saved(o.Flag, o.CurrentValue == true)
    local hasDesc = o.Description ~= nil and o.Description ~= ""
    local card = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, hasDesc and 56 or 46), LayoutOrder = order, ZIndex = 4, Parent = parent})
    paint(card, "BackgroundColor3", "Accent")
    local stroke = Stroke(card, "Accent", 0.62, 1)
    local title = Text(card, {Text = string.upper(o.Name or "TOGGLE"), FontFace = F.Bold, TextSize = 16, Size = UDim2.new(1, -90, 0, 20), Position = UDim2.fromOffset(14, hasDesc and 9 or 13), ZIndex = 5, TextTruncate = Enum.TextTruncate.AtEnd})
    local desc = Text(card, {Text = string.upper(o.Description or ""), Role = "Mid", TextSize = 12, Size = UDim2.new(1, -90, 0, 16), Position = UDim2.fromOffset(14, 30), ZIndex = 5, TextTruncate = Enum.TextTruncate.AtEnd})
    desc.Visible = hasDesc
    local sw = New("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(52, 24), BackgroundTransparency = 1, ZIndex = 5, Parent = card})
    local swStroke = Stroke(sw, "Accent", 0, 1)
    local knob = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromOffset(24, 16), Position = UDim2.fromOffset(3, 4), ZIndex = 6, Parent = sw})
    paint(knob, "BackgroundColor3", "Accent")
    local knobGlow = New("UIStroke", {Thickness = 3, Transparency = 0.55, Parent = knob})
    paint(knobGlow, "Color", "Accent")

    local api = {Tab = self}
    function api:_Render(anim)
        local t = anim and 0.15 or 0
        local pos = value and UDim2.fromOffset(25, 4) or UDim2.fromOffset(3, 4)
        if t > 0 then tween(knob, t, {Position = pos, BackgroundTransparency = value and 0 or 0.62}) else knob.Position = pos knob.BackgroundTransparency = value and 0 or 0.62 end
        knobGlow.Enabled = value
        card.BackgroundTransparency = value and 0.93 or 1
        stroke.Transparency = value and 0.62 or 0.8
        swStroke.Transparency = value and 0 or 0.62
        title.TextColor3 = value and T.Hi or T.Mid
    end
    function api:Set(s)
        if type(s) ~= "table" then s = {CurrentValue = s} end
        if s.CurrentValue ~= nil and s.CurrentValue ~= value then
            value = s.CurrentValue
            setFlag(o.Flag, value)
            api:_Render(true)
            win.RefreshOrb()
            self.Tab:_Refresh()
            if o.Callback then task.spawn(o.Callback, value) end
        end
        if s.Description then desc.Text = string.upper(s.Description) end
        if s.Name then title.Text = string.upper(s.Name) end
    end
    function api:SetDescription(d) desc.Text = string.upper(tostring(d)) if not desc.Visible then desc.Visible = true card.Size = UDim2.new(1, 0, 0, 56) title.Position = UDim2.fromOffset(14, 9) end end
    function api:GetValue() return value end
    function api:Destroy() card:Destroy() end
    card.MouseButton1Click:Connect(function() api:Set({CurrentValue = not value}) end)
    api:_Render(false)
    setFlag(o.Flag, value)
    table.insert(win.Toggles, api)
    if value and o.Callback then task.defer(o.Callback, true) end
    task.defer(function() win.RefreshOrb() self:_Refresh() end)
    return api
end

