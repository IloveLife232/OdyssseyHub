task.spawn(function()
    local lastCoins = nil
    while running do
        task.wait(1)
        local s = math.floor(os.clock() - Stats.t0)
        upStat:Set({Value = string.format("%02d:%02d", s // 60, s % 60)})
        -- taps this session = the game's own count of your taps (Data.Statistics.ActualTaps) since you started,
        -- so it matches exactly what Auto Tap (and tapping by hand) really got; Odyssey's own count if that can't be read
        local okT, actual = pcall(function()
            local d = GameData.get()
            return d and d.Statistics and tonumber(d.Statistics.ActualTaps)
        end)
        if okT and actual then
            Stats.tapBase = Stats.tapBase or actual
            tapStat:Set({Value = short(math.max(0, actual - Stats.tapBase))})
        else
            tapStat:Set({Value = short(taps)})
        end
        -- coins earned = every rise in coins (spending on rebirths doesn't count against you)
        local c, rb = coinsNow(), rebirthsNow()
        if c then
            if lastCoins and c > lastCoins then Stats.earned += c - lastCoins end
            lastCoins = c
            Stats.coins = c
            coinStat:Set({Value = short(c)})
            if s >= 5 then cphStat:Set({Value = short(Stats.earned / s * 3600)}) end
        end
        if rb then
            Stats.startReb = Stats.startReb or rb
            Stats.rebirths = rb
            rebStat:Set({Value = short(rb) .. (rb > Stats.startReb and ("  +" .. short(rb - Stats.startReb)) or "")})
        end
    end
end)

