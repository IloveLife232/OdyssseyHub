function Window:CreateTab(o)
    if type(o) == "string" then o = {Name = o} end
    o = o or {}
    local tab = setmetatable({Window = self, Conns = {}, Count = 0, SideName = "Left", Name = o.Name or "TAB"}, Tab)
    local btn = New("TextButton", {Text = string.upper(tab.Name), FontFace = F.Reg, TextSize = 13, AutoButtonColor = false, BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = o.Order or (#self.Tabs + 1), ZIndex = 4, Parent = self.TabBar})
    local under = New("Frame", {BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), Visible = false, ZIndex = 4, Parent = btn})
    paint(under, "BackgroundColor3", "Accent")
    local dot = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromOffset(5, 5), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(1, 4, 0.5, -1), BackgroundColor3 = GOOD, Visible = false, ZIndex = 4, Parent = btn})
    Corner(dot, UDim.new(1, 0))
    tab.Button, tab.Under, tab.Dot = btn, under, dot

    local page = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 3, Parent = self.Pages})
    local function column()
        local sf = New("ScrollingFrame", {BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 3, Parent = page})
        paint(sf, "ScrollBarImageColor3", "Accent")
        List(sf, Enum.FillDirection.Vertical, 10)
        Pad(sf, 2, 6, 6, 2)
        return sf
    end
    tab.Page = page
    tab.Left = column()
    tab.Right = column()
    tab.Right.Visible = false
    tab.Right.AnchorPoint = Vector2.new(1, 0)
    tab.Right.Position = UDim2.fromScale(1, 0)

    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
    table.insert(self.Tabs, tab)
    if not self.Current then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    self.Current = tab
    for _, t in ipairs(self.Tabs) do t:_Refresh() end
end

function Tab:_Refresh()
    local on = self.Window.Current == self
    self.Page.Visible = on
    self.Under.Visible = on
    self.Button.FontFace = on and F.Bold or F.Reg
    self.Button.TextColor3 = on and T.Hi or T.Mid
    local running = false
    for _, tg in ipairs(self.Window.Toggles) do if tg.Tab == self and tg:GetValue() then running = true break end end
    self.Dot.Visible = running and not on and not self.NoDot
end

-- Tab:Side("Right") sends everything created after it to the right column (Side("Left") to go back)
function Tab:_ShowRight()
    if self.Right.Visible then return end
    self.Right.Visible = true
    self.Right.Size = UDim2.new(0, self.RightWidth or 220, 1, 0)
    self.Left.Size = UDim2.new(1, -((self.RightWidth or 220) + 18), 1, 0)
end
function Tab:Side(which)
    self.SideName = (which == "Right") and "Right" or "Left"
    if self.SideName == "Right" then self:_ShowRight() end
    return self
end
function Tab:_Holder(o)
    self.Count += 1
    local side = (o and o.Side) or self.SideName
    if side == "Right" then self:_ShowRight() end
    return side == "Right" and self.Right or self.Left, self.Count
end

