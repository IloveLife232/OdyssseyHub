local mouse = LP:GetMouse()
-- TP TOOL (toggle): puts a tool in your backpack; equip it and tap/click where to go. Works on mobile.
-- Turning it off takes it away. It comes back after you respawn while the toggle is on.
local tpToolOn = false
local function removeTpTool()
    for _, where in ipairs({LP:FindFirstChildOfClass("Backpack"), char()}) do
        local t = where and where:FindFirstChild("Odyssey TP")
        if t then t:Destroy() end
    end
end
local function giveTpTool()
    removeTpTool()
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return end
    local tool = Instance.new("Tool")
    tool.Name = "Odyssey TP"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Activated:Connect(function() if mouse.Hit then tpTo(CFrame.new(mouse.Hit.Position)) end end)
    tool.Parent = bp
end
Player:CreateToggle({Name = "TP Tool", Description = "Equip it, tap/click to teleport", Callback = function(on)
    tpToolOn = on
    if on then giveTpTool() else removeTpTool() end
end})
track(LP.CharacterAdded:Connect(function()
    if tpToolOn then task.wait(1) if tpToolOn then giveTpTool() end end
end))
local function playerNames()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then table.insert(t, p.Name) end end
    table.sort(t)
    if #t == 0 then t = {"(nobody else here)"} end
    return t
end
local function tpToPlayer(target)   -- used by WORLD > Places > Players
    local p = target and Players:FindFirstChild(target)
    if not p then Window:Notify({Type = "Warning", Content = "Pick a player first"}) return end
    local function theirRoot() return p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
    if theirRoot() and tpTo(theirRoot().CFrame) then return end
    -- far away = not loaded on your side. The game tells everyone which island each player is on
    -- (CurrentIsland), so go to that island first, wait for them to load in, then go to them.
    local isl = p:GetAttribute("CurrentIsland")
    isl = (isl == "Spawn" or isl == nil) and "Spawn" or tostring(isl)
    local spot = ISLAND_SPOTS[isl]
    local r = root()
    if spot and r then
        pcall(function() LP:RequestStreamAroundAsync(spot) end)
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(spot)
        settleOnGround(r)
        for _ = 1, 30 do
            if theirRoot() then break end
            task.wait(0.1)
        end
    end
    if theirRoot() and tpTo(theirRoot().CFrame) then return end
    Window:Notify({Type = "Warning", Content = target .. " is on " .. isl .. " but didn't load in - try again"})
end

