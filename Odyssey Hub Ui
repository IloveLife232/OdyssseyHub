-- these repeat what you did by hand once (unlock a zone / island / skill in the game and it learns it)
-- From the game's IslandController / WorldController: you unlock a zone or island AT ITS PORTAL.
--   zones:   WorldService.ZoneUnlockRequested:Fire({Action = "Purchase", Zone = <name>})       (names/prices: ProgressionConfig.Zones)
--   islands: IslandService.IslandUnlockRequested:Fire({Action = "Purchase", Island = <name>}) (names/prices: IslandConfig.Islands)
-- They unlock in Order, so it takes the next locked one, waits until you have the coins, hops to its portal
-- (workspace.Zones.Portals / workspace.Portals.Portals) and buys it. Unlocked ones come from your game data.
local function cfg(path)
    local ok, c = pcall(function()
        local cur = RS
        for part in path:gmatch("[^%.]+") do cur = cur:FindFirstChild(part) end
        return require(cur)
    end)
    return ok and c or nil
end
local function portalPart(folder, name)
    local m = folder and (folder:FindFirstChild(name) or folder:FindFirstChild(name, true))
    if not m then return nil end
    if m:IsA("BasePart") then return m end
    return m:FindFirstChild("Portal", true) or m:FindFirstChildWhichIsA("BasePart", true)
end
local function makeUnlocker(kind)
    local isIsland = kind == "Island"
    local reqPath = isIsland and "IslandService.RE.IslandUnlockRequested" or "WorldService.RE.ZoneUnlockRequested"
    local resPath = isIsland and "IslandService.RE.IslandUnlockResult" or "WorldService.RE.ZoneUnlockResult"
    local last = {}
    pcall(function()
        track(remote(resPath).OnClientEvent:Connect(function(r)
            if type(r) == "table" then last.reason = r.Success and ("Unlocked " .. tostring(r[kind] or "")) or tostring(r.Reason or r.Message or "no") end
        end))
    end)
    return function(flag)   -- flag: the toggle using it (stops teleporting once it's off)
        local function on() return not flag or autoOn[flag] == true end
        local c = isIsland and cfg("Shared.Progression.IslandConfig") or cfg("Shared.Progression.ProgressionConfig")
        local list = c and (isIsland and c.Islands or c.Zones)
        if type(list) ~= "table" then return "Couldn't read the " .. kind:lower() .. " list" end
        local d = GameData.get()
        local unlocked = d and d.Progression and (isIsland and d.Progression.UnlockedIslands or d.Progression.UnlockedZones) or {}
        -- next locked one in order
        local nextName, nextInfo
        for name, info in pairs(list) do
            if unlocked[name] ~= true and type(info) == "table" and (not nextInfo or (info.Order or 0) < (nextInfo.Order or 0)) then nextName, nextInfo = name, info end
        end
        if not nextName then return "All " .. kind:lower() .. "s unlocked" end
        local coins = coinsNow()
        local price = tonumber(nextInfo.Price)
        if price and coins and coins < price then
            return "Next: " .. nextName .. " · need " .. short(price) .. " coins"
        end
        -- go to its portal, then buy
        local folder = isIsland and (workspace:FindFirstChild("Portals") and workspace.Portals:FindFirstChild("Portals"))
            or (workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild("Portals"))
        local part = portalPart(folder, isIsland and (nextInfo.PortalName or nextName) or nextName)
        if not part and not isIsland then
            -- zone portals sit on their own island and only load when you're there: go to the zone's island
            -- (if the game says which one), otherwise visit each island until the portal shows up
            local order = {}
            if type(nextInfo.Island) == "string" and ISLAND_SPOTS[nextInfo.Island] then table.insert(order, nextInfo.Island) end
            for _, isl in ipairs({"Spawn", "Sky Island", "Autumn", "Mushroom", "Desert", "Crystal Cave", "Shadow Realm", "Volcano", "Heaven"}) do
                if not table.find(order, isl) then table.insert(order, isl) end
            end
            for _, isl in ipairs(order) do
                local rr = root()
                if not (rr and on()) then break end
                pcall(function() LP:RequestStreamAroundAsync(ISLAND_SPOTS[isl]) end)
                rr.AssemblyLinearVelocity = Vector3.new()
                rr.CFrame = CFrame.new(ISLAND_SPOTS[isl])
                settleOnGround(rr)
                task.wait(0.8)
                folder = workspace:FindFirstChild("Zones") and workspace.Zones:FindFirstChild("Portals")
                part = portalPart(folder, nextName)
                if part then break end
            end
        end
        local r = root()
        local saved = isIsland and PORTAL_SPOTS[nextInfo.PortalName or nextName]
        if not on() then return "stopped" end
        if r and (part or saved) then
            pcall(function() LP:RequestStreamAroundAsync(part and part.Position or saved) end)   -- load the portal area first
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = part and (part.CFrame + Vector3.new(0, 3, 0)) or CFrame.new(saved)
            task.wait(0.8)
        end
        local args = {Action = "Purchase"}
        args[kind] = nextName
        send(reqPath, args)
        task.wait(1)
        return last.reason and (nextName .. ": " .. last.reason) or ("Buying " .. nextName .. ((part or saved) and "" or " (portal not found)"))
    end
end
