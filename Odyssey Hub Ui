-- EGGS: best egg picker
------------------------------------------------------------------------------------------
-- an egg's price comes from the egg itself (a Price / Cost attribute) or the price sign on it, including the
-- game's "EggCostSignFill" signs. Picks the most expensive egg in the World you picked that you can pay for
-- (price x eggs per hatch).
local SUF = {K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24, OC = 1e27, NO = 1e30, DC = 1e33}
local function parsePrice(text)
    text = tostring(text):gsub(",", ""):gsub("<[^>]->", "")
    local best
    for num, suf in text:gmatch("(%d+%.?%d*)%s*(%a*)") do
        local n = tonumber(num)
        local m = SUF[suf:upper():sub(1, 2)] or SUF[suf:upper():sub(1, 1)] or 1
        if n then
            -- a suffix like K / M / Qa multiplies; a word after the number ("5 Coins") doesn't
            if #suf > 2 and not SUF[suf:upper()] then m = 1 end
            n *= m
            if not best or n > best then best = n end
        end
    end
    return best
end
-- From your scan: each egg's sign shows its price ("2.50K") and how many you can afford right now ("x14.66K").
-- Some signs show a second number too (Spiked: "300K" and "200K"), so the real price is the one that matches
-- coins / how-many-you-can-afford. The "x" number is also the simplest way to know if you can afford it.
local function eggSign(name)
    local folder = workspace:FindFirstChild("Eggs")
    local m = folder and folder:FindFirstChild(name)
    if not m then local k = KnownEggs[name] return k and k.price, nil end
    local cands, canBuy = {}, nil
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("TextLabel") then
            local t = d.Text:gsub("%s", "")
            if t:sub(1, 1):lower() == "x" then
                local n = parsePrice(t:sub(2))
                if n then canBuy = n end
            elseif t ~= "" and t ~= "$" then
                local n = parsePrice(t)
                if n and n > 0 then table.insert(cands, n) end
            end
        end
    end
    local price
    local coins = coinsNow()
    if #cands > 0 then
        if canBuy and canBuy > 0 and coins then
            -- the price that fits coins / canBuy best
            local want = coins / canBuy
            for _, c in ipairs(cands) do
                if not price or math.abs(math.log(c / want)) < math.abs(math.log(price / want)) then price = c end
            end
        else
            for _, c in ipairs(cands) do if not price or c < price then price = c end end
        end
    end
    if price and KnownEggs[name] then KnownEggs[name].price = price end
    return price, canBuy
end
local function eggPrice(name) return (eggSign(name)) end
