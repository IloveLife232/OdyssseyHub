        track(svc("RelicFound").OnClientEvent:Connect(function(a) if type(a) == "table" and a.Id ~= nil then M.relics[a.Id] = true end end))
        track(svc("BossAttack").OnClientEvent:Connect(function(a)
            if type(a) == "table" and a.Kind == "Sweep" and typeof(a.Origin) == "CFrame" then M.sweep = a end
        end))
        for _, n in ipairs({"Results", "RunEnded"}) do
            track(svc(n).OnClientEvent:Connect(function(a) M.ended = true M.results = a end))
        end
    end)
    local function fire(name, ...)
        local r = svc(name)
        if r then pcall(r.FireServer, r, ...) end
    end
    local function tapM()
        if Hatch.tapSeq and tapRemote then
            Hatch.tapSeq += 1
            pcall(tapRemote.FireServer, tapRemote, {ClientSequence = Hatch.tapSeq, Auto = false, Source = "screen"})
        else
            pcall(tapOnce)
        end
    end
    local function standAt(pos, side)
        local r = root()
        if not (r and pos) then return end
        if (r.Position - pos).Magnitude > 6 then
            pcall(function() LP:RequestStreamAroundAsync(pos) end)
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.new(pos + (side or Vector3.new(0, 3, 0)))
        end
    end
    local function cfgM(name)
        local ok, c = pcall(function() return require(RS.Shared.Game.HalloweenDungeon[name]) end)
        return ok and c or nil
    end
    local function inRun() return type(M.run) == "table" and M.run.Id ~= nil and not M.ended end
    AUTO.mansionLive = function()   -- in a run AND actually at the mansion (so a missed "run over" can't block forever)
        if not inRun() then return false end
        local r = root()
        return r ~= nil and (r.Position - Vector3.new(-1418.73, -465.58, -2014.77)).Magnitude < 1500
    end
    Limited:CreateSection({Name = "Haunted Mansion", Side = "Left"})
    local mansionToggle
    mansionToggle = autoLoop(Limited, {Side = "Left", Name = "Auto Haunted Mansion", Description = "Runs the Haunted Mansion every time it's ready (bats, chests, blessings, boss)", Flag = "AutoMansion", Every = 5, Run = function()
        local d = GameData.get()
        local cfg = cfgM("Config")
        if not (d and cfg) then return "Couldn't read the mansion" end
        local hd = type(d.HalloweenDungeon) == "table" and d.HalloweenDungeon or {}
        local now = os.time()
        pcall(function() now = workspace:GetServerTimeNow() end)
        local readyAt = tonumber(select(2, pcall(cfg.ReadyAt, d))) or 0
        if not inRun() then
            AUTO.lockOff("Haunted Mansion")   -- not in a run: don't hold anything else up
            if now < readyAt then
                local left = math.ceil(readyAt - now)
                return "Next run in " .. math.floor(left / 60) .. "m " .. (left % 60) .. "s · clears " .. tostring(hd.Clears or 0)
            end
            if hd.Unlocked ~= true then
                -- talk to Count Greg (the mansion's NPC) first
                HW.go(function() return autoOn.AutoMansion end, HW.island)
                fire("Talk")
                task.wait(1)
                return "Talked to Greg to unlock the mansion"
            end
            -- go stand on the lobby circle (takes the busy lock: nothing else pulls you away until the run is over)
            if not AUTO.lockOn("Haunted Mansion", {AutoMansion = true}, "AutoMansion") then return "Waiting · finishing " .. tostring(AUTO.busy and AUTO.busy.name) end
            local isl = HW.go(function() return autoOn.AutoMansion end, HW.island)
            if not isl then AUTO.lockOff("Haunted Mansion") return "Couldn't get to Halloween island" end
            local function findZone()
                for _, c in ipairs(CollectionS:GetTagged(cfg.CircleTag or "HalloweenDungeonCircle")) do
                    if c:IsDescendantOf(workspace) then
                        local z = (c:IsA("BasePart") and c.Name == (cfg.ZoneName or "Zone")) and c or c:FindFirstChild(cfg.ZoneName or "Zone", true) or (c:IsA("BasePart") and c)
                        if z then return z end
                    end
                end
            end
            M.back = M.back or (root() and root().CFrame)
            local zone = findZone()
            if not zone then
                -- the circle only loads near the mansion: go there and wait for it (up to 8s)
                pcall(function() mansionToggle:SetDescription("Going to the mansion lobby...") end)
                standAt(Vector3.new(-1418.73, -465.58, -2014.77), Vector3.new(0, 3, 20))
                for _ = 1, 80 do zone = findZone() if zone then break end task.wait(0.1) end
            end
            if not zone then AUTO.lockOff("Haunted Mansion") return "Couldn't find the lobby circle (trying again)" end
            pcall(function() mansionToggle:SetDescription("On the lobby circle · waiting for the run to start") end)
            standAt(zone.Position, Vector3.new(0, 3, 0))
            -- wait for the countdown / run to start (keep standing on it)
            local t0 = os.clock()
            while autoOn.AutoMansion and not inRun() and os.clock() - t0 < 40 do
                standAt(zone.Position, Vector3.new(0, 3, 0))
                task.wait(0.5)
            end
            if not inRun() then AUTO.lockOff("Haunted Mansion") return "Waiting in the lobby..." end
            Window:Notify({Type = "Info", Title = "Haunted Mansion", Content = "Run started"})
        end
        -- IN THE RUN
        AUTO.lockOn("Haunted Mansion", {AutoMansion = true}, "AutoMansion")
        fire("SkipIntro")
        local target, chestT, lastTap = nil, nil, 0
        local t0 = os.clock()
        while autoOn.AutoMansion and inRun() and os.clock() - t0 < 1800 do
            local r = root()
            -- blessing: the best one offered
            if M.offer and M.offer.OfferId ~= nil then
                local choices, pick = {}, nil
                for _, c in pairs(type(M.offer.Choices) == "table" and M.offer.Choices or {}) do choices[c] = true end
                for _, id in ipairs(BLESS_ORDER) do if choices[id] then pick = id break end end
                if pick then fire("BlessingPick", M.offer.OfferId, pick) end
                M.offer = nil
            end
            -- Vampire Relics hidden in the room (models with InteractableId "VampireRelic", attribute RelicId): go take
            -- each one you haven't taken (RelicConfig.FoundBy) - 1-2 per run, 6 in total
            if os.clock() - (M.relicScan or 0) > 1 then
                M.relicScan = os.clock()
                local rc = cfgM("RelicConfig")
                for _, m in ipairs(CollectionS:GetTagged("Interactable")) do
                    if m:IsA("Model") and m:IsDescendantOf(workspace) and m:GetAttribute("InteractableId") == ((rc and rc.InteractableId) or "VampireRelic") then
                        local id = m:GetAttribute((rc and rc.IdAttribute) or "RelicId")
                        local mine = rc and rc.FoundBy and select(2, pcall(rc.FoundBy, m, LP.UserId)) == true
                        local okD, rpos = pcall(function() return m:GetPivot().Position end)
                        local near = okD and rpos and r and (rpos - r.Position).Magnitude < 150   -- only relics in this room
                        if type(id) == "string" and not mine and not M.relics[id] and near then
                            M.relics[id] = true
                            local ok, p = pcall(function() return m:GetPivot().Position end)
                            if ok and p then
                                standAt(p, Vector3.new(0, 3, 4))
                                task.wait(0.4)
                                fire("CollectRelic", id)
                                task.wait(0.6)
                                Window:Notify({Type = "Success", Title = "Haunted Mansion", Content = "Took a Vampire Relic"})
                            end
                        end
                    end
                end
            end
            -- dodge the boss's cape sweep: step behind him just before it hits
            if M.sweep and r then
                local sw = M.sweep
                local hitAt = tonumber(sw.HitAt) or 0
                local tnow = workspace:GetServerTimeNow()
                if tnow > hitAt + 0.5 then
                    M.sweep = nil
                elseif tnow > hitAt - 0.45 then
                    local behind = sw.Origin.Position - sw.Origin.LookVector * 18
                    r.AssemblyLinearVelocity = Vector3.new()
                    r.CFrame = CFrame.new(behind + Vector3.new(0, 3, 0))
                    local h = hum()
                    if h then h.Jump = true end
                end
            end
            -- a chest MIMIC that has jumped out (Kind "Mimic", hopping From -> To, close by and awake): hit it first
            local mimic, md, mimicPos
            for id, m in pairs(M.mobs) do
                if tostring(m.Kind or ""):find("Mimic") and (tonumber(m.Hp) or 1) > 0 and r then
                    local mode = tostring(m.Mode or ""):lower()
                    local p = (typeof(m.To) == "Vector3" and m.To) or (typeof(m.From) == "Vector3" and m.From)
                    if p and not (mode:find("hid") or mode:find("dorm") or mode:find("sleep") or mode:find("disguis")) then
                        local dd = (p - r.Position).Magnitude
                        if dd < 150 and (not md or dd < md) then mimic, md, mimicPos = id, dd, p end
                    end
                end
            end
            -- bats: closest one
            local best, bd
            for id, m in pairs(M.mobs) do
                local anchor = type(m.Orbit) == "table" and m.Orbit.Anchor
                if typeof(anchor) == "Vector3" and (tonumber(m.Hp) or 1) > 0 and r then
                    local dd = (anchor - r.Position).Magnitude
                    if not bd or dd < bd then best, bd = id, dd end
                end
            end
            -- once the door is open, a mimic never keeps you in the room for more than 6s
            if mimic ~= nil and M.door and os.clock() - (M.doorSeen or os.clock()) > 6 then mimic = nil end
            if mimic ~= nil then
                if target ~= mimic then target = mimic fire("SetTarget", mimic) end
                if chestT ~= nil then chestT = nil fire("ChestTarget", nil) end
                if md and md > 40 then standAt(mimicPos, Vector3.new(0, 3, 10)) end
            elseif best ~= nil then
                if target ~= best then target = best fire("SetTarget", best) end
                if chestT ~= nil then chestT = nil fire("ChestTarget", nil) end
                local anchor = M.mobs[best].Orbit.Anchor
                if bd and bd > 60 then standAt(anchor, Vector3.new(0, 3, 12)) end
            else
                if target ~= nil then target = nil fire("SetTarget", nil) end
                -- room cleared: the game draws arrows (a beam, Terrain.HalloweenDungeonBeamTo) from you to the way into
                -- the next room - teleport straight to the end of the arrows
                M.beamOk = false
                local beamTo = workspace.Terrain:FindFirstChild("HalloweenDungeonBeamTo")
                local beamPos = beamTo and beamTo:IsA("Attachment") and beamTo.WorldPosition
                if beamPos and r and (not M.beamTried or (beamPos - M.beamTried).Magnitude > 2 or os.clock() - (M.beamAt or 0) > 6) then
                    if chestT ~= nil then chestT = nil fire("ChestTarget", nil) end
                    M.beamTried, M.beamAt = beamPos, os.clock()
                    pcall(function() mansionToggle:SetDescription("Following the arrows to the next room") end)
                    local roomBefore = type(M.run) == "table" and M.run.RoomIndex
                    pcall(function() LP:RequestStreamAroundAsync(beamPos) end)
                    local rr = root()
                    if rr then
                        rr.AssemblyLinearVelocity = Vector3.new()
                        rr.CFrame = CFrame.new(beamPos + Vector3.new(0, 3, 0))
                    end
                    local t = os.clock()
                    while os.clock() - t < 3 do
                        local now = type(M.run) == "table" and M.run.RoomIndex
                        if (now ~= nil and now ~= roomBefore) or M.ended or not inRun() then M.beamOk = true break end
                        task.wait(0.1)
                    end
                    if M.beamOk then M.door = nil end
                end
                -- door open (room done) and no bats left: go FORWARD into the next room right away
                -- (only if the arrows didn't get you there)
                if not M.beamOk and M.door and r then
                    if chestT ~= nil then chestT = nil fire("ChestTarget", nil) end
                    local door = M.door
                    -- the mansion's rooms go one after another toward -Z (Room 1 at Z ~200, its door at Z ~-150), so
                    -- "forward" is whichever side of the door has the lower Z
                    -- (only needed in the first room - from room 2 on, "past the door from where you stand" works)
                    local look
                    local roomIdx = type(M.run) == "table" and tonumber(M.run.RoomIndex) or 1
                    if roomIdx <= 1 then
                        look = door.LookVector * Vector3.new(1, 0, 1)
                        if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
                        look = look.Unit
                        if look.Z > 0 then look = -look end
                    else
                        look = (door.Position - r.Position) * Vector3.new(1, 0, 1)
                        if look.Magnitude < 1 then look = door.LookVector * Vector3.new(1, 0, 1) end
                        if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
                        look = look.Unit
                    end
                    local roomBefore = type(M.run) == "table" and M.run.RoomIndex
                    local function moved()
                        local now = type(M.run) == "table" and M.run.RoomIndex
                        return (now ~= nil and now ~= roomBefore) or M.ended or not inRun()
                    end
                    local function waitMoved(sec) local t = os.clock() while os.clock() - t < sec and not moved() do task.wait(0.1) end return moved() end
                    local floorY = door.Position.Y - 20
                    local function place(p, dir)
                        local rr = root()
                        if not rr then return end
                        local params = RaycastParams.new()
                        params.FilterType = Enum.RaycastFilterType.Exclude
                        params.FilterDescendantsInstances = {char()}
                        local hit = workspace:Raycast(Vector3.new(p.X, floorY + 8, p.Z), Vector3.new(0, -80, 0), params)
                        local spot = hit and (hit.Position + Vector3.new(0, 3.5, 0)) or Vector3.new(p.X, floorY, p.Z)
                        rr.AssemblyLinearVelocity = Vector3.new()
                        rr.CFrame = CFrame.new(spot, spot + dir)
                    end
                    M.door = nil
                    -- 1) the way that worked: 45 studs past the door
                    place(door.Position + look * 45, look)
                    if not waitMoved(2.5) then
                        pcall(function() mansionToggle:SetDescription("Getting into the next room...") end)
                        -- 2) walk through from the doorway, 3) further in, 4) the other side
                        place(door.Position - look * 6, look)
                        local h = hum()
                        if h then h:MoveTo(door.Position + look * 40) end
                        if not waitMoved(3) then
                            local done = false
                            for _, dir in ipairs({look, -look}) do
                                for _, dist in ipairs({60, 80}) do
                                    place(door.Position + dir * dist, dir)
                                    if waitMoved(1.5) then done = true break end
                                end
                                if done then break end
                            end
                        end
                    end
                    task.wait(0.5)
                else
                    -- chests: closest unopened one
                    local cb, cd, cid
                    for _, c in ipairs(CollectionS:GetTagged("HalloweenDungeonChest")) do
                        if c:IsA("Model") and c:IsDescendantOf(workspace) and c:GetAttribute("Opened") ~= true and type(c:GetAttribute("ChestId")) == "number" and r then
                            local ok, p = pcall(function() return c:GetPivot().Position end)
                            if ok and p and math.abs(p.Y - r.Position.Y) < 80 then
                                local dd = (p - r.Position).Magnitude
                                if dd < 400 and (not cd or dd < cd) then cb, cd, cid = p, dd, c:GetAttribute("ChestId") end
                            end
                        end
                    end
                    if cb then
                        if cd > 25 then standAt(cb, Vector3.new(0, 3, 8)) end
                        if chestT ~= cid then chestT = cid fire("ChestTarget", cid) end
                    end
                end
            end
            -- tap (hits the bat / chest you target, or Count Greg when nothing is targeted) ~10 a second
            if os.clock() - lastTap >= 0.1 then lastTap = os.clock() tapM() end
            local runInfo = M.run
            pcall(function()
                mansionToggle:SetDescription("Room " .. tostring(runInfo.RoomIndex) .. "/" .. tostring(runInfo.RoomCount) .. " · " .. tostring(runInfo.ObjectiveText or runInfo.Objective or ""))
            end)
            task.wait(0.05)
        end
        if not autoOn.AutoMansion and inRun() then fire("Leave") end
        -- results: wait for the game to send you back, then go to where you were
        task.wait(14)
        local r = root()
        if r and M.back then r.AssemblyLinearVelocity = Vector3.new() r.CFrame = M.back end
        M.back = nil
        M.run = nil
        AUTO.lockOff("Haunted Mansion")
        Window:Notify({Type = "Success", Title = "Haunted Mansion", Content = "Run finished"})
        if Webhook.post then
            local res = M.results
            task.spawn(Webhook.post, {title = "Haunted Mansion run done", color = 0xb47bff, fields = {
                {name = "Player", value = LP.Name, inline = true},
                {name = "Result", value = type(res) == "table" and tostring(res.Outcome or res.Result or (res.Won and "Won") or "Finished") or "Finished", inline = true}}})
        end
        return "Last run done · " .. os.date("%H:%M")
    end})
end)()
