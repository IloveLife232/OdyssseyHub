	local function ensureFolders() pcall(function() for _,f in ipairs(FOLDERS) do if not isfolder(f) then makefolder(f) end end end) end

	task.defer(function()
		ensureFolders()
		pcall(function()
			local HS=game:GetService("HttpService")
			local function rgb(c) return {math.floor(c.R*255+0.5),math.floor(c.G*255+0.5),math.floor(c.B*255+0.5)} end
			for name,t in pairs(Themes) do
				local path=THEMES_FOLDER.."/"..name..".json"
				if not isfile(path) then
					writefile(path,HS:JSONEncode({c1=rgb(t.c1),c2=rgb(t.c2),c3=rgb(t.c3),LT2BG=rgb(t.LT2BG or t.c2),accent=t.accent and rgb(t.accent) or nil}))
				end
			end
			local added=false
			for _,fname in ipairs(listfiles(THEMES_FOLDER)) do
				local themeName=fname:match("([^/\\]+)%.json$")
				if themeName and not Themes[themeName] then
					local ok,data=pcall(function() return HS:JSONDecode(readfile(fname)) end)
					if ok and type(data)=="table" and data.c1 and data.c2 and data.c3 then
						local function c(x) return Color3.fromRGB(x[1],x[2],x[3]) end
						Themes[themeName]={c1=c(data.c1),c2=c(data.c2),c3=c(data.c3),LT2BG=data.LT2BG and c(data.LT2BG) or c(data.c2),accent=data.accent and c(data.accent) or nil}
						table.insert(themeNames,themeName)
						added=true
					end
				end
			end
			if added then table.sort(themeNames) themeDD:Set({Options=themeNames}) end
		end)
	end)
	local function isBindKey(k) return Odyssey._BindFlags[k] or k=="OdysseyToggleKey" or k:sub(1,8)=="Keybind_" end
	local function saveConfig()
		pcall(function()
			ensureFolders()
			local data,keys={},{}
			for k,v in pairs(Odyssey.Flags) do
				local t=type(v)
				local ok=t=="boolean" or t=="number" or t=="string"
				if t=="table" then
					ok=true
					for _,x in ipairs(v) do if type(x)~="string" then ok=false break end end
				end
				if ok then if isBindKey(k) then keys[k]=v else data[k]=v end end
			end
			writefile(CONFIG_PATH,game:GetService("HttpService"):JSONEncode(data))
			writefile(KEYBINDS_FILE,game:GetService("HttpService"):JSONEncode(keys))
		end)
	end
	local function loadConfig() end
	do
		task.defer(function()
			loadConfig()
			local savedTheme=Odyssey.Flags["OdysseyTheme"]
			if savedTheme and Themes[savedTheme] then
				ApplyThemeDirect(savedTheme)
				themeDD:Set({CurrentOption=savedTheme})
			else
				ApplyThemeDirect("Electric")
			end
			local loaded=Odyssey._Loaded or {}
			for k,v in pairs(loaded) do
				if (k:sub(1,8)=="Keybind_" or k=="OdysseyBlurIdentity") and Odyssey._Restore[k] then pcall(Odyssey._Restore[k],v) end
			end
			local savedKey=loaded["OdysseyToggleKey"]
			if type(savedKey)=="string" then
				local okKey,kc=pcall(function() return Enum.KeyCode[savedKey] end)
				if okKey and kc then
					toggleKey=kc
					kbBox2.Text=kc.Name
					pcall(function() FooterKey.Text="Toggle UI: "..kc.Name.."   ·   Lib v"..Odyssey.Version end)
				end
			end
			win._cfgReady=true
		end)
	end

	win._autoSave=function()
		if not win._cfgReady then return end
		local ok=pcall(function()
			ensureFolders()
			local data={}
			if isfile(CONFIG_PATH) then
				local okR,old=pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(CONFIG_PATH)) end)
				if okR and type(old)=="table" then data=old end
			end
			for _,k in ipairs({"OdysseyTheme","OdysseyAutoLoad"}) do
				local v=Odyssey.Flags[k]
				if v~=nil then data[k]=v end
			end
			writefile(CONFIG_PATH,game:GetService("HttpService"):JSONEncode(data))
			local keys={}
			if isfile(KEYBINDS_FILE) then
				local okK,oldK=pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(KEYBINDS_FILE)) end)
				if okK and type(oldK)=="table" then keys=oldK end
			end
			if Odyssey.Flags["OdysseyToggleKey"]~=nil then keys["OdysseyToggleKey"]=Odyssey.Flags["OdysseyToggleKey"] end
			writefile(KEYBINDS_FILE,game:GetService("HttpService"):JSONEncode(keys))
		end)
		return ok
	end

