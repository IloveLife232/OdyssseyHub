		if not pop.Visible then return end
		if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
		local pos=i.Position
		local function inside(o)
			local ap,as=o.AbsolutePosition,o.AbsoluteSize
			return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
		end
		if not inside(pop) and not inside(btn) then setOpen(false) end
	end)

	local homeTab=self._tabs and self._tabs[1]
	if homeTab then homeTab.page:GetPropertyChangedSignal("Visible"):Connect(function() if not homeTab.page.Visible then setOpen(false) end end) end
end

