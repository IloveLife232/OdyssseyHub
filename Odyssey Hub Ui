-- RING: round gauge made of glowing dots, value in the middle (e.g. 1.2M COINS / HR)
function Tab:CreateRing(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local size = o.Size or 150
    local box = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size + 10), LayoutOrder = order, ZIndex = 4, Parent = parent})
    local ringF = New("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.fromOffset(size, size), ZIndex = 4, Parent = box})
    local outline = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = ringF})
    Corner(outline, UDim.new(1, 0))
    Stroke(outline, "Accent", 0.68, 1)
    local inner = New("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -40, 1, -40), ZIndex = 4, Parent = ringF})
    Corner(inner, UDim.new(1, 0))
    Stroke(inner, "Accent", 0.8, 1)
    local dots = {}
    local N = o.Dots or 40
    local r = size / 2 - 10
    for i = 1, N do
        local a = (i - 1) / N * math.pi * 2 - math.pi / 2
        local d = New("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(3, 7), Rotation = math.deg(a) + 90,
            Position = UDim2.new(0.5, math.cos(a) * r, 0.5, math.sin(a) * r), ZIndex = 5, Parent = ringF})
        paint(d, "BackgroundColor3", "Accent")
        dots[i] = d
    end
    local v = Text(ringF, {Text = tostring(o.Value or "0"), FontFace = F.Bold, TextSize = o.TextSize or 28, Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0.5, -22), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6})
    local vGlow = New("UIStroke", {Thickness = 1.5, Transparency = 0.65, Parent = v})
    paint(vGlow, "Color", "Accent")
    local cap = Text(ringF, {Text = spaced(string.upper(o.Name or "")), Role = "Mid", FontFace = F.Semi, TextSize = 9, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0.5, 10), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6})
    local pct = o.Percent or 0
    local function draw()
        local lit = math.floor(math.clamp(pct, 0, 1) * N + 0.5)
        for i, d in ipairs(dots) do d.BackgroundTransparency = (i <= lit) and 0 or 0.8 end
    end
    draw()
    local api = {}
    function api:Set(s)
        if type(s) ~= "table" then s = {Value = s} end
        if s.Value ~= nil then v.Text = tostring(s.Value) end
        if s.Name then cap.Text = spaced(string.upper(s.Name)) end
        if s.Percent then pct = s.Percent draw() end
    end
    function api:Destroy() box:Destroy() end
    return api
end

-- PROGRESS: inline bar with a label and value (e.g. NEXT HATCH  0.6s)
function Tab:CreateProgress(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local box = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order, ZIndex = 4, Parent = parent})
    local name = Text(box, {Text = spaced(string.upper(o.Name or "")), Role = "Mid", FontFace = F.Semi, TextSize = 10, Size = UDim2.new(1, -80, 0, 14), ZIndex = 5})
    local val = Text(box, {Text = tostring(o.Text or ""), FontFace = F.Bold, TextSize = 12, Size = UDim2.new(0, 80, 0, 14), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5})
    local track = New("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.8, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 20), ZIndex = 5, Parent = box})
    paint(track, "BackgroundColor3", "Accent")
    local fill = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromScale(math.clamp(o.Percent or 0, 0, 1), 1), ZIndex = 5, Parent = track})
    paint(fill, "BackgroundColor3", "Accent")
    local fg = New("UIStroke", {Thickness = 2, Transparency = 0.6, Parent = fill})
    paint(fg, "Color", "Accent")
    local api = {}
    function api:Set(s)
        if s.Percent then fill.Size = UDim2.fromScale(math.clamp(s.Percent, 0, 1), 1) end
        if s.Text then val.Text = tostring(s.Text) end
        if s.Name then name.Text = spaced(string.upper(s.Name)) end
    end
    function api:Destroy() box:Destroy() end
    return api
end

