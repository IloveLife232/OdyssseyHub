local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab

function Holo:CreateWindow(opts)
    opts = opts or {}
    local self = setmetatable({}, Window)
    self.Tabs = {}
    self.Conns = {}
    self.Toggles = {}
    self.Redraws = {}
    self.Visible = true

    -- config file: <folder>/<place id>.json (or opts.ConfigName)
    if CanFiles then
        local folder = opts.ConfigFolder or "OdysseyHub"
        pcall(function() if type(isfolder) == "function" and not isfolder(folder) then makefolder(folder) end end)
        CfgPath = folder .. "/" .. tostring(opts.ConfigName or game.PlaceId) .. ".json"
        if opts.AutoLoad ~= false then
            pcall(function()
                if isfile(CfgPath) then
                    for k, v in pairs(HttpService:JSONDecode(readfile(CfgPath))) do Holo.Flags[k] = v end
                end
            end)
        end
    end
    local themeName = saved("HoloTheme", opts.Theme or "Blue")
    T = THEMES[themeName] or THEMES.Blue

    local gui = New("ScreenGui", {Name = "OdysseyHolo", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 60})
    pcall(function() if type(syn) == "table" and syn.protect_gui then syn.protect_gui(gui) end end)
    gui.Parent = guiParent()
    self.Gui = gui

    local W, H = opts.Width or 660, opts.Height or 430
    local root = New("Frame", {Name = "Root", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -20), Size = UDim2.fromOffset(W, H), Parent = gui})
    self.Root = root
    local scale = New("UIScale", {Parent = root})
    self.Scale = scale
    local userScale = saved("HoloScale", 100) / 100
    local function fitScale()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local fit = math.min(1, (vp.X - 30) / W, (vp.Y - 90) / (H + 70))
        scale.Scale = math.max(0.45, fit * userScale)
    end
    self.FitScale = function(s) userScale = s fitScale() end
    fitScale()
    if workspace.CurrentCamera then
        table.insert(self.Conns, workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitScale))
    end

    -- projector beam + ring under the panel (Roblox has no soft cones or true ellipses, so the beam is
    -- thin strips fading up and out from the middle, and the ring is a ring of glowing dots)
    local proj = New("Frame", {Name = "Projector", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 140), Position = UDim2.new(0, 0, 1, -40), ZIndex = 0, Parent = root})
    local beam = New("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(300, 124), ZIndex = 0, Parent = proj})
    local STRIPS = 30
    for i = 1, STRIPS do
        local d = math.abs((i - 0.5) / STRIPS - 0.5) * 2            -- 0 in the middle, 1 at the edges
        local bottom = 0.7 + 0.3 * d ^ 1.4                           -- how see-through the strip is at the ring
        local st = New("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Size = UDim2.new(1 / STRIPS, 0, 1 - 0.45 * d, 0),
            Position = UDim2.new((i - 1) / STRIPS, 0, 1, 0), ZIndex = 0, Parent = beam})
        paint(st, "BackgroundColor3", "Accent")
        New("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.6, math.min(1, bottom + 0.15)), NumberSequenceKeypoint.new(1, bottom)}), Parent = st})
    end
    local ring = New("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(270, 28), ZIndex = 0, Parent = proj})
    local core = New("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(200, 6), BackgroundTransparency = 0.6, ZIndex = 0, Parent = ring})
    paint(core, "BackgroundColor3", "Accent")
    Corner(core, UDim.new(1, 0))
    New("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)}), Parent = core})
    local DOTS = 64
    for i = 1, DOTS do
        local a = (i - 1) / DOTS * math.pi * 2
        local front = math.sin(a) > 0
        local dot = New("Frame", {BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(front and 4 or 3, 2),
            Position = UDim2.new(0.5, math.cos(a) * 128, 0.5, math.sin(a) * 11), BackgroundTransparency = front and 0 or 0.45, ZIndex = 0, Parent = ring})
        paint(dot, "BackgroundColor3", "Accent")
    end
    proj.Visible = saved("HoloProjector", opts.Projector ~= false)
    self.Projector = proj

    -- outer glow (stacked faint strokes)
    for i, tr in ipairs({0.78, 0.87, 0.94}) do
        local gl = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, i * 6, 1, i * 6), BackgroundTransparency = 1, ZIndex = 1, Parent = root})
        Stroke(gl, "Accent", tr, 2)
    end

    local main = New("Frame", {Name = "Main", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 - saved("HoloOpacity", opts.Opacity or 92) / 100, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2, Parent = root})
    paint(main, "BackgroundColor3", "Panel")
    Stroke(main, "Accent", 0.62, 1)
    self.Main = main

    -- scan lines
    local scan = New("Frame", {Name = "Scan", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = main})
    for y = 0, H, 4 do
        local l = New("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.95, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, y), ZIndex = 2, Parent = scan})
        paint(l, "BackgroundColor3", "Accent")
    end
    -- inner edge glow
    local inner = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), ZIndex = 2, Parent = main})
    Stroke(inner, "Accent", 0.88, 3)

    -- header
    local header = New("Frame", {Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 54), ZIndex = 3, Parent = main})
    local hline = New("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.62, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), ZIndex = 3, Parent = header})
    paint(hline, "BackgroundColor3", "Accent")
    local diamond = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(36, 27), Size = UDim2.fromOffset(24, 24), Rotation = 45, BackgroundTransparency = 1, ZIndex = 3, Parent = header})
    Stroke(diamond, "Accent", 0, 1.5)
    local dglow = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 6, 1, 6), BackgroundTransparency = 1, Rotation = 0, ZIndex = 3, Parent = diamond})
    Stroke(dglow, "Accent", 0.75, 2)
    Text(header, {Text = opts.Logo or "O", FontFace = F.Bold, TextSize = 13, Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(36, 27), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4})
    Text(header, {Text = spaced(string.upper(opts.Name or "ODYSSEY")), FontFace = F.Light, TextSize = 21, Size = UDim2.new(0, 260, 1, 0), Position = UDim2.fromOffset(60, 0), ZIndex = 3})
    self.StatusLabel = Text(header, {Text = string.upper(opts.Status or (opts.Game and opts.Game or "PROJECTION ONLINE")), Role = "Mid", FontFace = F.Semi, TextSize = 12, Size = UDim2.new(0, 260, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -60, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3})
    local minBtn = New("TextButton", {Text = "–", FontFace = F.Bold, TextSize = 16, AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, 0), Size = UDim2.fromOffset(28, 28), ZIndex = 4, Parent = header})
    paint(minBtn, "TextColor3", "Mid")
    Stroke(minBtn, "Accent", 0.62, 1)

    -- tabs bar
    -- tabs scroll sideways when there are too many to fit (so the last ones, like SETTINGS, never get cut off)
    local tabBar = New("ScrollingFrame", {Name = "TabBar", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(22, 58), Size = UDim2.new(1, -44, 0, 38),
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 2,
        ElasticBehavior = Enum.ElasticBehavior.Never, ZIndex = 3, Parent = main})
    paint(tabBar, "ScrollBarImageColor3", "Accent")
    List(tabBar, Enum.FillDirection.Horizontal, 16)
    Pad(tabBar, 0, 10, 2, 0)
    tabBar.ScrollBarThickness = 3
    tabBar.InputChanged:Connect(function(i)   -- mouse wheel over the tabs scrolls them sideways
        if i.UserInputType == Enum.UserInputType.MouseWheel then
            local maxX = math.max(0, tabBar.AbsoluteCanvasSize.X - tabBar.AbsoluteSize.X)
            tabBar.CanvasPosition = Vector2.new(math.clamp(tabBar.CanvasPosition.X - i.Position.Z * 60, 0, maxX), 0)
        end
    end)
    self.TabBar = tabBar
    local pages = New("Frame", {Name = "Pages", BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 102), Size = UDim2.new(1, -44, 1, -116), ZIndex = 3, Parent = main})
    self.Pages = pages

    -- minimize orb
    local orb = New("TextButton", {Name = "Orb", Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(58, 58), Position = UDim2.new(0, 22, 0.5, -29), BackgroundTransparency = 0.15, Visible = false, ZIndex = 20, Parent = gui})
    paint(orb, "BackgroundColor3", "Panel")
    Corner(orb, UDim.new(1, 0))
    Stroke(orb, "Accent", 0, 1)
    local orbGlow = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 10, 1, 10), BackgroundTransparency = 1, ZIndex = 20, Parent = orb})
    Corner(orbGlow, UDim.new(1, 0))
    Stroke(orbGlow, "Accent", 0.7, 3)
    local od = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22), Rotation = 45, BackgroundTransparency = 1, ZIndex = 21, Parent = orb})
    Stroke(od, "Accent", 0, 1.5)
    Text(orb, {Text = opts.Logo or "O", FontFace = F.Bold, TextSize = 11, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 22})
    local orbCount = Text(orb, {Text = "", Role = "Hi", FontFace = F.Semi, TextSize = 11, Size = UDim2.new(1, 20, 0, 14), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 21})
    self.Orb = orb

    -- notifications + overlay layers
    local toasts = New("Frame", {Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 20), Size = UDim2.new(0, 270, 1, -40), ZIndex = 40, Parent = gui})
    List(toasts, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right)
    self.Toasts = toasts

    -- show / hide / minimize
    local function refreshOrb()
        local n = 0
        for _, t in ipairs(self.Toggles) do if t:GetValue() and not t.Tab.NoDot then n += 1 end end
        orbCount.Text = n > 0 and (n .. " ON") or ""
    end
    self.RefreshOrb = refreshOrb
    function self:SetVisible(v)
        self.Visible = v
        root.Visible = v
        orb.Visible = not v
        refreshOrb()
    end
    minBtn.MouseButton1Click:Connect(function() self:SetVisible(false) end)

    -- drag (header for the window, the orb itself for the orb; a short orb tap = open)
    local function dragify(handle, target, onTap)
        local dragging, startPos, startInput, moved
        table.insert(self.Conns, handle.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, moved = true, false
                startPos, startInput = target.Position, i.Position
            end
        end))
        table.insert(self.Conns, UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - startInput
                if d.Magnitude > 4 then moved = true end
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self.Conns, UserInputService.InputEnded:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                if not moved and onTap then onTap() end
            end
        end))
    end
    dragify(header, root)
    dragify(orb, orb, function() self:SetVisible(true) end)

    -- toggle key
    self.ToggleKey = saved("HoloToggleKey", (opts.ToggleKey and opts.ToggleKey.Name) or "RightControl")
    table.insert(self.Conns, UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode.Name == self.ToggleKey then self:SetVisible(not self.Visible) end
    end))

    G.OdysseyHoloWindow = self

    -- built-in SETTINGS tab (always last)
    if opts.SettingsTab ~= false then
        task.defer(function() self:_BuildSettings() end)
    end
    return self
end

function Window:SetStatus(text) self.StatusLabel.Text = string.upper(tostring(text)) end

function Window:SetTheme(name)
    if not THEMES[name] then return end
    T = THEMES[name]
    setFlag("HoloTheme", name)
    repaint()
    for _, tab in ipairs(self.Tabs) do tab:_Refresh() end
    for _, tog in ipairs(self.Toggles) do tog:_Render(false) end
    for _, fn in ipairs(self.Redraws) do pcall(fn) end
end

function Window:SaveConfig() saveNow() end

function Window:Destroy()
    for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
    for _, tab in ipairs(self.Tabs) do
        for _, c in ipairs(tab.Conns) do pcall(function() c:Disconnect() end) end
    end
    pcall(function() self.Gui:Destroy() end)
    if G.OdysseyHoloWindow == self then G.OdysseyHoloWindow = nil end
    if self.OnDestroy then pcall(self.OnDestroy) end
end

------------------------------------------------------------------------------------------
-- notifications
------------------------------------------------------------------------------------------
local KIND = {
    Info = {"SIGNAL", "Accent"}, Success = {"COMPLETE", GOOD}, Warning = {"WARNING", WARN}, Error = {"ERROR", BAD},
}
function Window:Notify(o)
    o = o or {}
    local kind = KIND[o.Type or "Info"] or KIND.Info
    local col = type(kind[2]) == "string" and T[kind[2]] or kind[2]
    local dur = o.Duration or 4
    local card = New("Frame", {BackgroundTransparency = 0.08, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 41, Parent = self.Toasts})
    paint(card, "BackgroundColor3", "Deep")
    -- (no scale-sized glow child here: the card grows to fit its children, so a "1 + 6px" child made it grow forever)
    New("UIStroke", {Color = col, Thickness = 1.5, Parent = card})
    Pad(card, 10, 12, 12, 12)
    List(card, Enum.FillDirection.Vertical, 2)
    local head = Text(card, {Text = spaced(string.upper(o.Title and o.Title ~= "Odyssey" and o.Title or kind[1])), FontFace = F.Semi, TextSize = 10, Size = UDim2.new(1, 0, 0, 14), ZIndex = 42, LayoutOrder = 1})
    head.TextColor3 = col
    Painted[head] = nil
    Text(card, {Text = tostring(o.Content or o.Text or ""), FontFace = F.Bold, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, ZIndex = 42, LayoutOrder = 2})
