autoLoop(Limited, {Side = "Right", Name = "Auto Buy Halloween Shop", Description = "Buys the picked items with Candy Corn", Flag = "AutoHalloweenShop", Every = 5, Run = function()
    local cfg = rcfg("Shared.Items.HalloweenShopConfig")
    local d = GameData.get()
    if not (cfg and cfg.Items and d) then return "Couldn't read the Halloween shop" end
    if cfg.IsOpen and select(2, pcall(cfg.IsOpen)) == false then return "The Halloween shop is closed" end
    local bought, need = 0, nil
    for _, it in ipairs(cfg.Items) do
        if not autoOn.AutoHalloweenShop then break end
        local listed = not cfg.IsListed or select(2, pcall(cfg.IsListed, d, it)) ~= false
        -- "All" = every item with a limit; items with no limit (they never sell out) only when you pick them
        local wanted = hwsPick[it.Id] == true or (hwsAll and it.Limit ~= nil)
        if listed and wanted then
            for _ = 1, 20 do
                if not autoOn.AutoHalloweenShop then break end
                d = GameData.get()
                local left = cfg.GetRemaining and select(2, pcall(cfg.GetRemaining, d, it))
                if left ~= nil and tonumber(left) and tonumber(left) <= 0 then break end
                local candy = cfg.GetCandy and select(2, pcall(cfg.GetCandy, d)) or 0
                if (tonumber(candy) or 0) < it.Price then need = need or (hwsItemName(it) .. " needs " .. short(it.Price) .. " candy") break end
                local ok, res = send("HalloweenShopService.RF.Purchase", {Id = it.Id})
                if ok and type(res) == "table" and res.Success == true then
                    bought += 1
                    Window:Notify({Type = "Success", Title = "Halloween shop", Content = "Bought " .. hwsItemName(it)})
                    task.wait(0.6)
                elseif ok and type(res) == "table" and res.Reason == "RateLimited" then
                    task.wait(1.5)
                else
                    break
                end
            end
        end
    end
    if bought > 0 then return "Bought " .. bought .. " · " .. os.date("%H:%M") end
    return need or "Everything picked is bought / sold out"
end})
