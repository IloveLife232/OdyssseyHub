-- BEST EGG (from the game's EggController / LaunchEggConfig / EggPricing): every egg in the game, on any island
-- you've unlocked; the price is EggPricing.GetUnitPrice(data, egg, LaunchEggConfig[egg].Price) (what the game
-- charges you, boosts included) x eggs per hatch. Picks the most expensive one you can pay for, switches the World +
-- Egg dropdowns to it, and Auto Hatch takes you there.
local function bestAffordableEgg()
    local RSx = game:GetService("ReplicatedStorage")
    local okL, lec = pcall(function() return require(RSx.Shared.Pets.LaunchEggConfig) end)
    local okP, ep = pcall(function() return require(RSx.Shared.Pets.EggPricing) end)
    local d = GameData.get()
    if not (okL and type(lec) == "table" and okP and ep and ep.GetUnitPrice and d) then return nil end
    local coins = tonumber(d.Currencies and d.Currencies.Coins) or coinsNow() or 0
    local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
    local bridge = d.Progression and d.Progression.BridgeLowered == true
    local best, bestP
    for name, info in pairs(lec) do
        if type(name) == "string" and name ~= "Test" and type(info) == "table" then
            local isl = info.Island
            local reach = (isl == nil and (name ~= "Spiked" or bridge)) or (isl ~= nil and unlocked[isl] == true)
            if reach then
                local ok, unit = pcall(ep.GetUnitPrice, d, name, info.Price)
                unit = ok and tonumber(unit) or nil
                if unit and unit > 0 and unit * (Hatch.count or 1) <= coins and (not bestP or unit > bestP) then best, bestP = name, unit end
            end
        end
    end
    return best, bestP
end
