-- GEM SHOP = THE SKILL TREE (from the game's SkillTreeController / SkillTreeConfig / SkillTreeFormula /
-- SkillTreeRequirements). The old gem upgrades above need the "Winter" zone the map doesn't have any more, so they
-- can't be bought. Skills cost Gems and are bought from anywhere with SkillTreeService:Unlock({Name = <skill>}).
-- Trees: the main tree ("Skill Tree" in the middle) and the Clicking / Pets / Eggs trees. A skill can be bought when the
-- skill before it is unlocked (a tree's first skill needs that tree opened in the main tree), its RequiredIsland is
-- unlocked and its RequiredRebirthShop has been visited. Price: SkillTreeFormula.GetPrice. Yours: Data.SkillTree.Unlocked.
local SKILL_DIRS = {"N", "S", "NE", "NW", "SE", "SW"}
local SKILL_ALL = "All"
local skillPick, skillAll = {}, true
local function skillNodes()
    local cfg = rcfg("Shared.Progression.SkillTreeConfig")
    local list = {}
    local function walk(node, tree, parent)
        if type(node) ~= "table" or type(node.Name) ~= "string" then return end
        table.insert(list, {node = node, tree = tree, parent = parent})
        for _, dir in ipairs(SKILL_DIRS) do walk(node[dir], tree, node.Name) end
    end
    for tree, root in pairs(type(cfg) == "table" and cfg or {}) do
        if type(root) == "table" and root.Name then walk(root, tree, nil) end
    end
    return list
end
local function skillTreeTitle(tree) return tree == "Origin" and "Main tree" or (tostring(tree) .. " tree") end
autoLoop(Upgrades, {Name = "Auto Upgrade", Description = "Buys Skill Tree skills with gems, cheapest first", Flag = "AutoUpgrade", Every = 3, Run = function()
    local d = GameData.get()
    local stf = rcfg("Shared.Progression.SkillTreeFormula")
    local req = rcfg("Shared.Progression.SkillTreeRequirements")
    if not (d and stf) then return "Couldn't read the skill tree" end
    local unlocked = type(d.SkillTree) == "table" and type(d.SkillTree.Unlocked) == "table" and d.SkillTree.Unlocked or {}
    local gems = tonumber(d.Currencies and d.Currencies.Gems) or 0
    local nodes = skillNodes()
    -- which trees are open: a tree's category node in the main tree (Tree = "Clicking" ...) is unlocked
    local treeOpen = {Origin = true}
    for _, e in ipairs(nodes) do if e.node.Tree and unlocked[e.node.Name] == true then treeOpen[e.node.Tree] = true end end
    local can, waiting, lockMsg = {}, nil, nil
    for _, e in ipairs(nodes) do
        local n = e.node
        if unlocked[n.Name] ~= true and (skillAll or skillPick[e.tree]) then
            local ready = (e.parent and unlocked[e.parent] == true) or (not e.parent and treeOpen[e.tree] == true)
            local withheld = stf.IsWithheld and select(2, pcall(stf.IsWithheld, d, n.Name)) == true
            if ready and not withheld then
                local island = req and req.GetLockedIsland and select(2, pcall(req.GetLockedIsland, d, n))
                local shop = req and req.GetLockedShop and select(2, pcall(req.GetLockedShop, d, n))
                local price = stf.GetPrice and tonumber(select(2, pcall(stf.GetPrice, d, n.Name))) or tonumber(n.Cost) or 0
                if type(island) == "string" then
                    lockMsg = lockMsg or (n.Name .. ": unlock " .. island .. " first")
                elseif type(shop) == "string" then
                    lockMsg = lockMsg or (n.Name .. ": visit the " .. shop .. " Rebirth Shop once")
                elseif price > gems then
                    if not waiting or price < waiting.price then waiting = {name = n.Name, price = price} end
                else
                    table.insert(can, {name = n.Name, price = price, tree = e.tree})
                end
            end
        end
    end
    table.sort(can, function(x, y) return x.price < y.price end)
    if #can == 0 then
        if waiting then return "Next: " .. waiting.name .. " · needs " .. short(waiting.price) .. " gems (you have " .. short(gems) .. ")" end
        return lockMsg or "Everything picked is unlocked"
    end
    -- you buy skills standing in a Rebirth Shop circle (the SkillTree point): go to the closest one, buy, come back
    local r0 = root()
    local back = r0 and r0.CFrame
    if not goToUpgradeStand("AutoUpgrade") then return "Can't find a Rebirth Shop circle" end
    local bought, lastReason = 0, nil
    for _, c in ipairs(can) do
