	hg.Parent=hueBar
	local curH,curS,curV=Color3.toHSV(defCol)
	local hueThumb=New("Frame",{Size=UDim2.new(0,14,0,14),Position=UDim2.new(curH,-7,0.5,-7),BackgroundColor3=Color3.fromHSV(curH,1,1),BorderSizePixel=0,Parent=hueBar})
