-- gives Phase + InZone. You hit it by tapping while standing on the boss platform (CollectionService tag
-- HallowBossConfig.PlatformTag) once the intro is over. Its bombs come on HallowBossService.Attack {Targets, Radius,
-- Delay}: the script steps away from any bomb landing near you. Kills / best damage: Data.HallowBoss.
HW.bossBack = nil
function HW.bossState()
    local ok, st = pcall(function() return require(RS.Controllers.Game.HallowBossController):GetDebugState() end)
    return ok and type(st) == "table" and st or {}
end
function HW.platform()
    local cfg = rcfg("Shared.Game.HallowBossConfig")
    local tag = cfg and cfg.PlatformTag
    if not tag then return nil end
    for _, p in ipairs(CS:GetTagged(tag)) do
        if p:IsA("BasePart") and p:IsDescendantOf(workspace) then return p end
    end
end
function HW.platformSpot(p, avoid, radius)
    local top = p.CFrame:PointToWorldSpace(Vector3.new(0, p.Size.Y * 0.5 + 3, 0))
    local half = math.min(p.Size.X, p.Size.Z) * 0.5
    local best, bestD = top, -1
    for i = 0, 8 do
        local spot = top
        if i > 0 then
            local a = i / 8 * math.pi * 2
            spot = top + p.CFrame:VectorToWorldSpace(Vector3.new(math.cos(a), 0, math.sin(a)) * half * 0.6)
        end
        local nearest = math.huge
        for _, t in ipairs(avoid or {}) do nearest = math.min(nearest, (Vector3.new(spot.X, 0, spot.Z) - Vector3.new(t.X, 0, t.Z)).Magnitude) end
        if not avoid or #avoid == 0 then return top end
        if nearest > bestD then best, bestD = spot, nearest end
        if nearest > (radius or 10) + 4 and i == 0 then return spot end
    end
    return best
end
HW.dodging = false
-- the fight's start time: HallowBossService.State sends {Phase, StartsAt, EndsAt, ...}; keep the latest one
HW.state = nil
pcall(function()
