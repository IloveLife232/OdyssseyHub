-- from the game's EggController: EggService.EggHatchRequested:Fire({Egg = "Basic", Count = 1/3/8, Auto = true, Seq = n})
-- the game only hatches when you stand at the egg, so Auto Hatch teleports you there first.
-- every egg the script has seen: [egg name] = {world = "...", pos = Vector3}. Eggs on far away islands may not be
-- loaded, so this remembers where they were once you've been there.
local KnownEggs = {}
local ALL_WORLDS = "All worlds"
-- the eggs are the models straight inside workspace.Eggs (Eggs.Basic, Eggs.Sky ...), like the version that worked
local function eggCFrame(m)
    local e = m:FindFirstChild("Egg")
    if e and e:IsA("BasePart") then return e.CFrame end
    local p = m:FindFirstChildWhichIsA("BasePart", true)
    if p then return p.CFrame end
    local ok, piv = pcall(function() return m:GetPivot() end)   -- works even when the parts haven't loaded in
    if ok and piv and piv.Position.Magnitude > 1 then return piv end
    local ok2, cf = pcall(function()   -- the game keeps a copy of where the egg sits in "AlignBackup"
        local t = game:GetService("HttpService"):JSONDecode(m:GetAttribute("AlignBackup")).cf
        return CFrame.new(table.unpack(t))
    end)
    if ok2 and cf then return cf end
end
local function eggModels()
    local out = {}
    local folder = workspace:FindFirstChild("Eggs")
    if not folder then return out end
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local cf = eggCFrame(m)
            if cf then table.insert(out, {model = m, cf = cf}) end
        end
    end
    return out
end
-- which world an egg is in: from your scan, eggs on other islands have an "Island" attribute (Nimbus/Sky =
-- "Sky Island"), and the starter eggs (Basic, Spotted, Spiked) have none - those are the Spawn island eggs.
local function worldOf(m)
    local v = m:GetAttribute("Island")
    if v ~= nil and tostring(v) ~= "" then return tostring(v) end
    return "Spawn Island"
end
local function scanEggs()
    for _, e in ipairs(eggModels()) do
        local k = KnownEggs[e.model.Name]
        local w = worldOf(e.model)
        if not k or k.world ~= w then
            KnownEggs[e.model.Name] = {world = w, pos = e.cf.Position, cf = e.cf}
        else
            k.pos, k.cf = e.cf.Position, e.cf
        end
    end
end
local function eggSpot(name)   -- where the egg is right now, or where we last saw it
    local folder = workspace:FindFirstChild("Eggs")
