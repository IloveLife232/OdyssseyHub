	if tipOnly(opts) then AddTooltip(card,opts.Tooltip) end
	local awaiting=false
	local holdActive=false
	keyBtn.MouseButton1Click:Connect(function() awaiting=true; keyBtn.Text="Press a key..." end)
	UserInputService.InputBegan:Connect(function(i,gp)
		if awaiting and not gp then
			if i.UserInputType~=Enum.UserInputType.Keyboard then return end
			current=i.KeyCode.Name
			keyBtn.Text=current
			Odyssey.Flags[flag]=current
			awaiting=false
			if opts.ChangedCallback then task.spawn(opts.ChangedCallback,current) end
		elseif not gp and i.KeyCode.Name==current then
			if hold then
				holdActive=true
				if cb then cb(true) end
			else
				if cb then cb() end
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if hold and i.KeyCode.Name==current and holdActive then
			holdActive=false
			if cb then cb(false) end
		end
	end)
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o)
		local k=type(o)=="table" and ((o.KeyCode and o.KeyCode.Name) or o.CurrentKeybind) or o
		if typeof(k)=="EnumItem" then k=k.Name end
		if k then current=tostring(k); keyBtn.Text=current; Odyssey.Flags[flag]=current end
	end
	function api:SetDescription(d) _setDesc(left,d) end
	Odyssey._Restore[flag]=function(v)
		if type(v)~="string" then return end
		current=v
		keyBtn.Text=v
		Odyssey.Flags[flag]=v
	end
	function api:GetValue() return current end
	function api:Destroy() card:Destroy() end
	return api
end

