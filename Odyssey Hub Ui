local function worldNames()
    local seen, list = {}, {}
    for _, k in pairs(KnownEggs) do if not seen[k.world] then seen[k.world] = true table.insert(list, k.world) end end
    -- in the game's island order (IslandConfig Order): Spawn first, then Sky Island, Autumn ... ; event worlds last
    local order = {["Spawn Island"] = -1}
    pcall(function()
        local ic = require(game:GetService("ReplicatedStorage").Shared.Progression.IslandConfig)
        for name, info in pairs(ic.Islands or {}) do if type(info) == "table" then order[name] = tonumber(info.Order) end end
    end)
    local FALLBACK = {["Sky Island"] = 1, Autumn = 2, Mushroom = 3, Desert = 4, ["Crystal Cave"] = 5, ["Shadow Realm"] = 6, Volcano = 7, Heaven = 8}
    -- event worlds (not a normal island, e.g. Halloween) go on top
    table.sort(list, function(a, b)
        local oa, ob = order[a] or FALLBACK[a] or -1000, order[b] or FALLBACK[b] or -1000
        if oa ~= ob then return oa < ob end
        return a < b
    end)
    table.insert(list, 1, ALL_WORLDS)
    return list
end
local function eggNames(world)
