		pcall(function() Gui:Destroy() end)
		for _,v in ipairs(PlayerGui:GetChildren()) do
			if v.Name=="OdysseyTip" or v.Name=="OdysseyNotif" or v.Name=="OdysseyConfirm" then pcall(function() v:Destroy() end) end
		end
		if self.OnDestroy then pcall(self.OnDestroy) end
	end
	return win
end

return Odyssey
