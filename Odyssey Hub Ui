        Cactus = "Desert", Geode = "Crystal Cave", Crystal = "Crystal Cave", Void = "Shadow Realm", Volcanic = "Volcano", Draconic = "Volcano", Heaven = "Heaven"}
    local function eggIsland(egg)
        local lec = rcfg("Shared.Pets.LaunchEggConfig")
        local isl = lec and lec[egg] and lec[egg].Island
        if type(isl) == "string" and isl ~= "" then return isl end
        local k = KnownEggs[egg]
        if k and k.world ~= "Spawn Island" then return k.world end
        return EGG_ISLAND[egg]
    end
    local function islandOpen(isl)
        if not isl or isl == "Spawn" or isl == "Spawn Island" then return true end
        local d = GameData.get()
        local u = d and d.Progression and d.Progression.UnlockedIslands
