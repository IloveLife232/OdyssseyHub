            if lastReason == "RateLimited" then task.wait(1.5) end
        end
    end
    local r = root()
    if r and back and autoOn.AutoUpgrade and (r.Position - back.Position).Magnitude > 20 then
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = back
    end
    -- close the Skill Tree menu the circle opened (SkillTreeController.Close), and any other menu it left open
    task.wait(0.3)
    pcall(function()
        local stc = require(RS.Controllers.Game.SkillTreeController)
        if not stc.IsOpen or stc.IsOpen() then stc.Close() end
    end)
    pcall(function()
        local mc = require(RS.Controllers.UI.MenuController)
