            end
        end
        -- free slots at the spots you already fish at
        local limit = (fcfg and fcfg.RodLimit and select(2, pcall(fcfg.RodLimit, d))) or (fcfg and fcfg.MaxRods) or 3
        local count, spots, anyAt = 0, {}, {}
        for rodId, rod in pairs(rods) do
            count += 1
            local sp = rod.Spot or tostring(rodId):match("^(.-)#")
            if sp then spots[sp] = spots[sp] or {} spots[sp][tonumber(rod.Slot) or 0] = true if type(rod.At) == "table" then anyAt[sp] = rod.At end end
        end
        for sp, used in pairs(spots) do
            local def = fcfg and fcfg.GetSpot and select(2, pcall(fcfg.GetSpot, sp))
            local slots = type(def) == "table" and tonumber(def.Slots) or 3
            for slot = 1, slots do
                if count >= (tonumber(limit) or 3) then break end
                if not used[slot] and bestBait() then
                    count += 1
                    table.insert(castJobs, {id = (fcfg and fcfg.RodId and select(2, pcall(fcfg.RodId, sp, slot))) or (sp .. "#" .. slot), spot = sp, kind = "new", at = anyAt[sp]})
