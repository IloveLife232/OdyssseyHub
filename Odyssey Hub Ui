	if typeof(current)=="EnumItem" then current=current.Name end
	current=tostring(current)
	local hold=opts.HoldToInteract or false
	local cb=opts.Callback
	local flag=opts.Flag or ("Keybind_"..tostring(opts.Name or "Keybind"))
	if type(Odyssey.Flags[flag])=="string" then current=Odyssey.Flags[flag] end
	Odyssey.Flags[flag]=current
	Odyssey._BindFlags[flag]=true
	local card=_slot(self,true)
	local left=_title(card,opts.Name or "Keybind",opts.Description)
	left.Size=UDim2.new(1,-96,0,0)
