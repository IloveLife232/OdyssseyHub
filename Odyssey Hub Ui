			function api:Set(x) if type(x)=="table" then x=x.Value end if v.Text~=tostring(x) then v.Text=tostring(x) end end
			apis[i]=api
			if r.Name then apis[r.Name]=api end
		end
		task.defer(syncLog)
		return apis
	end
	self._homeList=list
	self._homeOrder=10
	return tab
