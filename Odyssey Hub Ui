    local head = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 0.93, LayoutOrder = 2, ZIndex = 5, Parent = box})
    paint(head, "BackgroundColor3", "Accent")
    local headStroke = Stroke(head, "Accent", 0.62, 1)
    local headTxt = Text(head, {Text = "", FontFace = F.Bold, TextSize = 15, Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(14, 0), ZIndex = 6, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd})
    local caret = Text(head, {Text = ">", FontFace = F.Bold, TextSize = 14, Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6})
    caret.Rotation = 90
    local listBox = New("ScrollingFrame", {BorderSizePixel = 0, BackgroundTransparency = 0.05, Size = UDim2.new(1, 0, 0, 0), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3, Visible = false, LayoutOrder = 3, ZIndex = 6, Parent = box})
    paint(listBox, "BackgroundColor3", "Deep")
    paint(listBox, "ScrollBarImageColor3", "Accent")
    Stroke(listBox, "Accent", 0.62, 1)
    List(listBox, Enum.FillDirection.Vertical, 0)
    local function isSel(t)
        if multi then return table.find(selected, t) ~= nil end
        return selected == t
    end
    local function headText()
        local cur = multi and (#selected > 0 and table.concat(selected, ", ") or "NONE") or selected
        local right
        for _, x in ipairs(options) do if textOf(x) == cur then right = rightOf(x) end end
        local hex = T.Mid:ToHex()
        return string.upper(cur) .. (right and ('<font color="#' .. hex .. '" size="12">  · ' .. string.upper(tostring(right)) .. "</font>") or "")
    end
    local rows = {}
    local build
    local function fire()
        setFlag(o.Flag, selected)
        if o.Callback then task.spawn(o.Callback, multi and selected or selected) end
    end
    function build()
        for _, r in ipairs(rows) do r:Destroy() end
        rows = {}
        for i, x in ipairs(options) do
            local t = textOf(x)
            local sel = isSel(t)
            local r = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = sel and 0.88 or 1, LayoutOrder = i, ZIndex = 7, Parent = listBox})
            paint(r, "BackgroundColor3", "Accent")
            if sel then
                local bar = New("Frame", {BorderSizePixel = 0, Size = UDim2.new(0, 2, 1, 0), ZIndex = 8, Parent = r})
                paint(bar, "BackgroundColor3", "Accent")
            end
            Text(r, {Text = string.upper(t), Role = sel and "Hi" or "Mid", FontFace = sel and F.Bold or F.Reg, TextSize = 13, Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(14, 0), ZIndex = 8, TextTruncate = Enum.TextTruncate.AtEnd})
            if rightOf(x) then
                Text(r, {Text = string.upper(tostring(rightOf(x))), Role = sel and "Hi" or "Mid", FontFace = sel and F.Bold or F.Reg, TextSize = 13, Size = UDim2.new(0, 80, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 8})
            end
            r.MouseButton1Click:Connect(function()
                if multi then
                    local idx = table.find(selected, t)
                    if idx then table.remove(selected, idx) else table.insert(selected, t) end
                else
                    selected = t
                    open = false
                end
                headTxt.Text = headText()
                fire()
                build()
            end)
            table.insert(rows, r)
        end
        listBox.Visible = open
        listBox.Size = UDim2.new(1, 0, 0, math.min(#options, o.MaxVisible or 6) * 34)
        headStroke.Transparency = open and 0 or 0.62
        caret.Rotation = open and -90 or 90
    end
    head.MouseButton1Click:Connect(function() open = not open build() end)
    headTxt.Text = headText()
    build()
    setFlag(o.Flag, selected)
    if o.Callback and selected ~= "" then task.defer(o.Callback, selected) end
    local api = {}
    function api:Set(s)
        if s.Options then options = s.Options end
        if s.CurrentOption ~= nil then selected = s.CurrentOption setFlag(o.Flag, selected) end
        headTxt.Text = headText()
        build()
    end
    function api:Refresh(opts2) api:Set({Options = opts2}) end
    function api:GetValue() return selected end
    function api:Destroy() box:Destroy() end
    return api
end

-- CHOICE: a row of buttons where one is picked (the x1 / x3 / x8 row). Locked = {"x8"} shows a lock.
function Tab:CreateChoice(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local options = o.Options or {}
    local locked = {}
    for _, v in ipairs(o.Locked or {}) do locked[v] = true end
    local selected = saved(o.Flag, o.CurrentOption or options[1])
    local box = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, ZIndex = 4, Parent = parent})
    List(box, Enum.FillDirection.Vertical, 6)
    if o.Name and o.Name ~= "" then
        Text(box, {Text = spaced(string.upper(o.Name)), Role = "Mid", FontFace = F.Semi, TextSize = 10, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1, ZIndex = 5})
    end
    local row = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2, ZIndex = 5, Parent = box})
    local btns = {}
    local function draw()
        for v, b in pairs(btns) do
            local sel = v == selected
            b.Button.BackgroundTransparency = sel and 0.86 or 1
            b.Stroke.Transparency = sel and 0 or (locked[v] and 0.8 or 0.62)
            b.Label.TextColor3 = sel and T.Hi or T.Mid
        end
    end
    local n = #options
    for i, v in ipairs(options) do
        local b = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1 / n, -8 * (n - 1) / n, 1, 0), Position = UDim2.new((i - 1) / n, (i - 1) * 8 / n, 0, 0), ZIndex = 6, Parent = row})
        paint(b, "BackgroundColor3", "Accent")
        local st = Stroke(b, "Accent", 0.62, 1)
        local lbl = Text(b, {Text = tostring(v), FontFace = F.Bold, TextSize = 14, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7})
        if locked[v] then
            lbl.Size = UDim2.new(1, -14, 1, 0)
            local lock = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(10, 12), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 10, 0.5, 0), ZIndex = 7, Parent = b})
            local body = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromOffset(10, 7), Position = UDim2.fromOffset(0, 5), ZIndex = 7, Parent = lock})
            paint(body, "BackgroundColor3", "Mid")
            local shackle = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(6, 8), Position = UDim2.fromOffset(2, 0), ZIndex = 7, Parent = lock})
            Corner(shackle, UDim.new(1, 0))
            Stroke(shackle, "Mid", 0, 1.5)
        end
        btns[v] = {Button = b, Stroke = st, Label = lbl}
        b.MouseButton1Click:Connect(function()
            if locked[v] then
                self.Window:Notify({Type = "Warning", Content = tostring(o.LockedText or (tostring(v) .. " is locked"))})
                return
            end
            selected = v
            draw()
            setFlag(o.Flag, selected)
            if o.Callback then task.spawn(o.Callback, selected) end
        end)
    end
    draw()
    table.insert(self.Window.Redraws, draw)
    setFlag(o.Flag, selected)
    if o.Callback and selected ~= nil then task.defer(o.Callback, selected) end
    local api = {}
    function api:Set(s)
        if s.Locked then locked = {} for _, v in ipairs(s.Locked) do locked[v] = true end end
        if s.CurrentOption ~= nil then selected = s.CurrentOption setFlag(o.Flag, selected) end
        draw()
    end
    function api:GetValue() return selected end
    function api:Destroy() box:Destroy() end
    return api
end

-- INPUT (text / number box)
function Tab:CreateInput(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local box = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = order, ZIndex = 4, Parent = parent})
    Text(box, {Text = spaced(string.upper(o.Name or "INPUT")), Role = "Mid", FontFace = F.Semi, TextSize = 10, Size = UDim2.new(1, 0, 0, 14), ZIndex = 5})
    local tb = New("TextBox", {Text = tostring(saved(o.Flag, o.CurrentValue or "")), PlaceholderText = o.PlaceholderText or "", ClearTextOnFocus = false, FontFace = F.Reg, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0.94, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 20), ZIndex = 5, Parent = box})
    paint(tb, "BackgroundColor3", "Accent")
    paint(tb, "TextColor3", "Hi")
    paint(tb, "PlaceholderColor3", "Mid")
    Stroke(tb, "Accent", 0.62, 1)
    Pad(tb, 0, 12, 0, 12)
    if o.Numeric then
        tb:GetPropertyChangedSignal("Text"):Connect(function()
            local clean = tb.Text:gsub("[^%d%.%-]", "")
            if clean ~= tb.Text then tb.Text = clean end
        end)
    end
    tb.FocusLost:Connect(function(enter)
        if o.OnEnterOnly and not enter then return end
        local v = o.Numeric and tonumber(tb.Text) or tb.Text
        setFlag(o.Flag, tb.Text)
        if o.Callback then task.spawn(o.Callback, v) end
        if o.RemoveTextAfterFocusLost then tb.Text = "" end
    end)
    local api = {}
    function api:Set(s) tb.Text = tostring(type(s) == "table" and (s.Value or s.CurrentValue or s.Text or "") or s) end
    function api:GetValue() return o.Numeric and tonumber(tb.Text) or tb.Text end
    function api:Destroy() box:Destroy() end
    return api
end

-- KEYBIND: Callback fires when the key is pressed; ChangedCallback when you rebind it
function Tab:CreateBind(o)
    o = o or {}
    local parent, order = self:_Holder(o)
    local key = saved(o.Flag, (typeof(o.CurrentKeybind) == "EnumItem" and o.CurrentKeybind.Name) or o.CurrentKeybind or o.CurrentBind or "None")
    local row = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order, ZIndex = 4, Parent = parent})
    Text(row, {Text = spaced(string.upper(o.Name or "KEYBIND")), Role = "Mid", FontFace = F.Semi, TextSize = 11, Size = UDim2.new(1, -110, 1, 0), ZIndex = 5})
    local b = New("TextButton", {Text = string.upper(key), FontFace = F.Bold, TextSize = 12, AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 5, Parent = row})
    paint(b, "TextColor3", "Hi")
    Stroke(b, "Accent", 0, 1)
    Pad(b, 0, 12, 0, 12)
    local listening = false
    b.MouseButton1Click:Connect(function() listening = true b.Text = "..." end)
    table.insert(self.Conns, UserInputService.InputBegan:Connect(function(i, gp)
        if listening then
            if i.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                key = (i.KeyCode == Enum.KeyCode.Backspace) and "None" or i.KeyCode.Name
                b.Text = string.upper(key)
                setFlag(o.Flag, key)
                if o.ChangedCallback then task.spawn(o.ChangedCallback, key) end
            end
            return
        end
        if gp then return end
        if key ~= "None" and i.KeyCode.Name == key and o.Callback then task.spawn(o.Callback, key) end
    end))
    local api = {}
    function api:Set(s) local k = type(s) == "table" and (s.KeyCode and s.KeyCode.Name or s.CurrentKeybind) or s if k then key = tostring(k) b.Text = string.upper(key) setFlag(o.Flag, key) end end
    function api:GetValue() return key end
    function api:Destroy() row:Destroy() end
    return api
end
Tab.CreateKeybind = Tab.CreateBind

