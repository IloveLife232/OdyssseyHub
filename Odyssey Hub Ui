local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local THEMES = {
    Blue   = {Accent = rgb(92, 203, 255),  Hi = rgb(226, 246, 255), Mid = rgb(127, 175, 200), Panel = rgb(8, 26, 40),  Deep = rgb(6, 20, 32)},
    Teal   = {Accent = rgb(63, 242, 200),  Hi = rgb(224, 255, 247), Mid = rgb(124, 191, 174), Panel = rgb(6, 30, 26),  Deep = rgb(4, 22, 19)},
    Red    = {Accent = rgb(255, 93, 108),  Hi = rgb(255, 230, 233), Mid = rgb(201, 133, 140), Panel = rgb(36, 8, 12),  Deep = rgb(26, 6, 9)},
    Violet = {Accent = rgb(180, 155, 255), Hi = rgb(240, 235, 255), Mid = rgb(156, 146, 196), Panel = rgb(18, 12, 36), Deep = rgb(13, 9, 27)},
    Gold   = {Accent = rgb(255, 200, 87),  Hi = rgb(255, 246, 224), Mid = rgb(200, 174, 124), Panel = rgb(34, 24, 6),  Deep = rgb(25, 18, 4)},
}
local THEME_ORDER = {"Blue", "Teal", "Red", "Violet", "Gold"}
local GOOD, WARN, BAD = rgb(74, 222, 128), rgb(255, 181, 71), rgb(255, 93, 108)
local T = THEMES.Blue

-- every themed property is registered so SetTheme can repaint the whole UI
local Painted = setmetatable({}, {__mode = "k"})
local function paint(obj, prop, role)
    Painted[obj] = Painted[obj] or {}
    Painted[obj][prop] = role
    obj[prop] = T[role]
    return obj
end
local function repaint()
    for obj, props in pairs(Painted) do
        if obj.Parent then
            for prop, role in pairs(props) do pcall(function() obj[prop] = T[role] end) end
        end
    end
end

------------------------------------------------------------------------------------------
-- fonts (Titillium Web is Roblox's closest built-in to the mockup's font)
------------------------------------------------------------------------------------------
local function mkFont(weight)
    local ok, f = pcall(function() return Font.new(Font.fromEnum(Enum.Font.TitilliumWeb).Family, weight) end)
    if ok and f then return f end
    return Font.new("rbxasset://fonts/families/GothamSSm.json", weight)
end
local F = {
    Light = mkFont(Enum.FontWeight.Light),
    Reg = mkFont(Enum.FontWeight.Regular),
    Semi = mkFont(Enum.FontWeight.SemiBold),
    Bold = mkFont(Enum.FontWeight.Bold),
}

------------------------------------------------------------------------------------------
-- small helpers
------------------------------------------------------------------------------------------
local function New(class, props)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    if parent then o.Parent = parent end
    return o
end
local function Stroke(parent, role, transparency, thickness)
    local s = New("UIStroke", {Thickness = thickness or 1, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent})
    if role then paint(s, "Color", role) end
    return s
end
local function Corner(parent, r) return New("UICorner", {CornerRadius = r or UDim.new(0, 0), Parent = parent}) end
local function Pad(parent, t, r, b, l)
    return New("UIPadding", {PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, l or 0), Parent = parent})
end
local function List(parent, dir, padding, halign, valign)
    return New("UIListLayout", {FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, padding or 0), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left, VerticalAlignment = valign or Enum.VerticalAlignment.Top, Parent = parent})
end
local function Text(parent, props)
    local role = props.Role or "Hi"
    props.Role = nil
    local t = New("TextLabel", {BackgroundTransparency = 1, FontFace = props.FontFace or F.Reg, TextSize = props.TextSize or 14, TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center, Text = props.Text or "", Size = props.Size or UDim2.new(1, 0, 0, 18),
        Position = props.Position or UDim2.new(), AnchorPoint = props.AnchorPoint or Vector2.new(), TextWrapped = props.TextWrapped or false,
        AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None, ZIndex = props.ZIndex or 1, TextTransparency = props.TextTransparency or 0,
        LayoutOrder = props.LayoutOrder or 0, RichText = props.RichText or false, TextTruncate = props.TextTruncate or Enum.TextTruncate.None, Parent = parent})
    paint(t, "TextColor3", role)
    return t
end
local function spaced(s) return (tostring(s):gsub(".", "%0 "):gsub(" $", "")) end
local function tween(o, t, goal) local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal) tw:Play() return tw end
local function guiParent()
    local ok, h = pcall(function() return (type(gethui) == "function") and gethui() or nil end)
    if ok and h then return h end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then
        local test = Instance.new("Folder")
        if pcall(function() test.Parent = cg end) then test:Destroy() return cg end
    end
    return LP:WaitForChild("PlayerGui")
end
local function fmtNum(v, inc)
    if inc and inc < 1 then
        local dec = math.max(0, math.ceil(-math.log10(inc)))
        return string.format("%." .. dec .. "f", v)
    end
    return tostring(math.floor(v + 0.5))
end

------------------------------------------------------------------------------------------
-- config save / load
------------------------------------------------------------------------------------------
local CanFiles = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local CfgPath
local saveQueued = false
local function saveNow()
    if not (CanFiles and CfgPath) then return end
    pcall(function()
        local data = {}
        for k, v in pairs(Holo.Flags) do
            local t = type(v)
            if t == "boolean" or t == "number" or t == "string" then data[k] = v
            elseif t == "table" then
                local okList = true
                for _, x in ipairs(v) do if type(x) ~= "string" then okList = false break end end
                if okList then data[k] = v end
            end
        end
        writefile(CfgPath, HttpService:JSONEncode(data))
    end)
end
local function queueSave()
    if saveQueued then return end
    saveQueued = true
    task.delay(1, function() saveQueued = false saveNow() end)
end
local function setFlag(flag, v)
    if not flag then return end
    Holo.Flags[flag] = v
    queueSave()
end
local function saved(flag, default)
    if flag and Holo.Flags[flag] ~= nil then return Holo.Flags[flag] end
    return default
end

