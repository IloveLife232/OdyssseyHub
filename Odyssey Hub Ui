-- built-in SETTINGS tab (scripts can add their own options to it: set Window.ExtraSettings = function(tab) ... end
-- right after CreateWindow, and they show under the UI options on the left)
------------------------------------------------------------------------------------------
function Window:_BuildSettings()
    local tab = self:CreateTab({Name = "SETTINGS", Order = 999})
    self.SettingsTab = tab
    tab.NoDot = true
    tab:CreateSection("PROJECTION COLOR")
    tab:CreateChoice({Options = THEME_ORDER, CurrentOption = Holo.Flags.HoloTheme or "Blue", Callback = function(v) self:SetTheme(v) end})
    tab:CreateToggle({Name = "Projector Beam", Description = "The glowing ring under the window", CurrentValue = self.Projector.Visible, Flag = "HoloProjector",
        Callback = function(v) self.Projector.Visible = v end})
    tab:CreateSlider({Name = "Panel Opacity", Range = {40, 100}, Increment = 2, CurrentValue = saved("HoloOpacity", 92), Suffix = "%", Flag = "HoloOpacity",
        Callback = function(v) self.Main.BackgroundTransparency = 1 - v / 100 end})
    tab:CreateSlider({Name = "UI Size", Range = {60, 130}, Increment = 5, CurrentValue = saved("HoloScale", 100), Suffix = "%", Flag = "HoloScale",
        Callback = function(v) self.FitScale(v / 100) end})
    if type(self.ExtraSettings) == "function" then
        local ok, err = pcall(self.ExtraSettings, tab)
        if not ok then warn("[Odyssey Holo] ExtraSettings: " .. tostring(err)) end
        tab:Side("Left")
    end
    tab:Side("Right")
    tab:CreateSection("CONTROLS")
    tab:CreateBind({Name = "Hide / Show", CurrentKeybind = self.ToggleKey, Flag = "HoloToggleKey", ChangedCallback = function(k) self.ToggleKey = k end})
    tab:CreateButton({Name = "Save Config", Style = "Primary", Callback = function() saveNow() self:Notify({Type = "Success", Content = "Config saved"}) end})
    tab:CreateButton({Name = "Reset Config", Callback = function()
        self:Confirm({Title = "Reset all settings?", Content = "Every saved setting is cleared. Re-run the script after.",
            OnConfirm = function()
                Holo.Flags = {}
                pcall(function() if CanFiles and CfgPath then writefile(CfgPath, "{}") end end)
                self:Notify({Type = "Warning", Content = "Config reset - re-run the script"})
            end})
    end})
    tab:CreateButton({Name = "Unload", Style = "Danger", Callback = function() self:Destroy() end})
    self:SelectTab(self.Current or tab)
end

return Holo
