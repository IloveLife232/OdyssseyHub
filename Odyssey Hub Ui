    local pct = Text(box, {Text = "", Role = "Accent", FontFace = F.Bold, TextSize = 13, Size = UDim2.new(0, 70, 0, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 46})
    local track = New("Frame", {BorderSizePixel = 0, BackgroundTransparency = 0.8, Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 36), ZIndex = 46, Parent = box})
    paint(track, "BackgroundColor3", "Accent")
    local fill = New("Frame", {BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 47, Parent = track})
    paint(fill, "BackgroundColor3", "Accent")
    local sub = Text(box, {Text = "", Role = "Mid", TextSize = 11, Size = UDim2.new(1, -28, 0, 14), Position = UDim2.fromOffset(14, 44), ZIndex = 46})
    local api = {}
    local function draw()
        local p = (maxV > minV) and (val - minV) / (maxV - minV) or 0
        tween(fill, 0.2, {Size = UDim2.fromScale(p, 1)})
        pct.Text = math.floor(p * 100 + 0.5) .. "%"
        sub.Text = (o.ShowPercent == false) and "" or (fmtNum(val) .. " / " .. fmtNum(maxV))
    end
    function api:Set(s)
        if s.Name then name.Text = string.upper(s.Name) end
        if s.Range then minV, maxV = s.Range[1], s.Range[2] end
        local nv = s.Value or s.CurrentValue
