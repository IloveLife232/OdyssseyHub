	Corner(svThumb,6); Stroke(svThumb,C.White,2,0)
	gradBox.BackgroundColor3=Color3.fromHSV(curH,1,1)
	local hexBox=_fieldBox({Parent=hueRow,Text="#FFFFFF",Size=UDim2.new(0,72,1,0),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Align=Enum.TextXAlignment.Center,Font=Enum.Font.Code,TextSize=12})
	hexBox.BackgroundColor3=C.Card
	local function hexOf(c) return string.format("#%02X%02X%02X",math.floor(c.R*255),math.floor(c.G*255),math.floor(c.B*255)) end
	hexBox.Text=hexOf(defCol); hexLbl.Text=hexOf(defCol)
	local function paint()
		local pureHue=Color3.fromHSV(curH,1,1)
		gradBox.BackgroundColor3=pureHue
		swatch.BackgroundColor3=currentCol
		hueThumb.BackgroundColor3=pureHue
		hueThumb.Position=UDim2.new(curH,-7,0.5,-7)
		svThumb.BackgroundColor3=currentCol
		svThumb.Position=UDim2.new(curS,-6,1-curV,-6)
		hexBox.Text=hexOf(currentCol); hexLbl.Text=hexOf(currentCol)
	end
	local function updateFromHSV()
		currentCol=Color3.fromHSV(curH,curS,curV)
		paint()
		if cb then cb(currentCol) end
		if flag then Odyssey.Flags[flag]=currentCol end
	end
	local draggingHue,draggingSV=false,false
	hueBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingHue=true end end)
	gradBox.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingSV=true end end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingHue=false; draggingSV=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
		if draggingHue then
			curH=math.clamp((i.Position.X-hueBar.AbsolutePosition.X)/hueBar.AbsoluteSize.X,0,1)
			updateFromHSV()
		elseif draggingSV then
			curS=math.clamp((i.Position.X-gradBox.AbsolutePosition.X)/gradBox.AbsoluteSize.X,0,1)
			curV=1-math.clamp((i.Position.Y-gradBox.AbsolutePosition.Y)/gradBox.AbsoluteSize.Y,0,1)
			updateFromHSV()
		end
	end)
	hexBox.FocusLost:Connect(function()
		local h=hexBox.Text:gsub("#","")
		if #h==6 then
			local r2,g2,b2=tonumber(h:sub(1,2),16),tonumber(h:sub(3,4),16),tonumber(h:sub(5,6),16)
			if r2 and g2 and b2 then
				currentCol=Color3.fromRGB(r2,g2,b2)
				curH,curS,curV=Color3.toHSV(currentCol)
				paint()
				if cb then cb(currentCol) end
				if flag then Odyssey.Flags[flag]=currentCol end
				return
			end
		end
		hexBox.Text=hexOf(currentCol)
	end)
	local swHit=New("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Parent=hRow})
	swHit.MouseButton1Click:Connect(function() expanded=not expanded; body.Visible=expanded end)
	if opts.Tooltip then AddTooltip(hRow,opts.Tooltip) end
