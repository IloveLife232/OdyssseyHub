-- EVENT ALERTS: the game keeps every server event's timing on workspace: Event_<Name>_NextStartAt (server time),
-- Event_<Name>_Active and Event_<Name>_Duration (seconds). A popup X seconds before one starts and when it starts.
;(function()   -- own function so its locals don't count toward the main chunk's 200 limit
    local NICE = {Luck = "Luck", Mythic = "Mythic", BloodMoon = "Blood Moon", Galaxy = "Galaxy", CloudRain = "Cloud Rain", BalloonParty = "Balloon Party"}
    local function eventNames()
        local t = {}
        local okA, attrs = pcall(function() return workspace:GetAttributes() end)
        for k in pairs(okA and attrs or {}) do
            local n = tostring(k):match("^Event_(.+)_NextStartAt$")
            if n then table.insert(t, n) end
        end
        if #t == 0 then for k in pairs(NICE) do table.insert(t, k) end end
        table.sort(t)
        return t
    end
    local function nice(n) return NICE[n] or n end
    local evOn, evAll, evPick, lead = false, true, {}, 60
    local warned, started = {}, {}
    local function alert(title, text)
        Window:Notify({Type = "Info", Duration = 8, Title = title, Content = text})
        if Webhook.events and Webhook.url ~= "" then
            task.spawn(post, {title = title, description = text, color = 0x7B5CFF, fields = {{name = "Player", value = LP.Name, inline = true}}})
        end
    end
    World:CreateToggle({Name = "Event alerts", Description = "Popup before + when a server event starts", Flag = "EventAlerts", Callback = function(on)
        evOn = on
        GEN["events"] = (GEN["events"] or 0) + 1
        local myGen = GEN["events"]
        if not on then return end
        task.spawn(function()
            while running and evOn and GEN["events"] == myGen do
                pcall(function()
                local now = workspace:GetServerTimeNow()
                for _, n in ipairs(eventNames()) do
                    if evAll or evPick[n] then
                        local at = tonumber(workspace:GetAttribute("Event_" .. n .. "_NextStartAt"))
                        local active = workspace:GetAttribute("Event_" .. n .. "_Active") == true
                        local dur = tonumber(workspace:GetAttribute("Event_" .. n .. "_Duration"))
                        local durText = dur and (dur >= 60 and (math.floor(dur / 60) .. " min") or (dur .. "s")) or "?"
                        if at and not active and at - now <= lead and at - now > 0 and warned[n] ~= at then
                            warned[n] = at
                            alert(nice(n) .. " event soon", nice(n) .. " starts in " .. math.ceil(at - now) .. "s (lasts " .. durText .. ")")
                        end
                        if active and not started[n] then
                            started[n] = true
                            alert(nice(n) .. " event is ON", nice(n) .. " is on now for " .. durText)
                        elseif not active then
                            started[n] = false
                        end
                    end
                end
                end)
                task.wait(2)
            end
        end)
    end})
    local evTitles, evByTitle = {"All"}, {}
    for _, n in ipairs(eventNames()) do table.insert(evTitles, nice(n)) evByTitle[nice(n)] = n end
    World:CreateDropdown({Name = "Events", Options = evTitles, MultipleOptions = true, CurrentOption = {"All"}, MaxVisible = 7, Flag = "EventPick",
        Callback = function(list)
            list = type(list) == "table" and list or {list}
            evAll = table.find(list, "All") ~= nil
            for title, n in pairs(evByTitle) do evPick[n] = table.find(list, title) ~= nil end
        end})
    World:CreateSlider({Name = "Warn me before", Range = {15, 300}, Increment = 15, CurrentValue = 60, Suffix = "s", Segmented = false, Flag = "EventLead",
        Callback = function(v) lead = v end})
end)()
