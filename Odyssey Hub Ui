    -- with DigService:Hit(Id, Round.Sequence, serverTime). DigConfig.IsHit(round, time) tells exactly when the cursor
    -- is in the zone, so it waits for that moment and hits, round after round, until the treasure is dug up.
    autoLoop(Farm, {Side = "Right", Name = "Auto Dig", Description = "Digs at the Autumn digsite (10 digs per hour)", Flag = "AutoDig", Every = 10, Run = function()
        local dc = cfgOf("Shared.Minigames.DigConfig")
