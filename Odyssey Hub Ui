        local ic = rcfg("Shared.Progression.IslandConfig")
        local d = GameData.get()
        local u = d and d.Progression and d.Progression.UnlockedIslands or {}
        local best, bo
        for name, info in pairs(ic and ic.Islands or {}) do
            if u[name] ~= true and type(info) == "table" and (not bo or (info.Order or 0) < bo) then best, bo = name, info.Order or 0 end
        end
        return best
    end
    local lastQuest
    -- HOME + AUTO HATCH: the first time Auto Quest does something it remembers where you were. While it's doing
    -- quests Auto Hatch pauses (Hatch.questBusy); when there's nothing left it can do, Auto Hatch takes you back to
    -- your egg, or if Auto Hatch is off you're put back where you were.
    local questActed, questHome = false, nil
    local selfPaying = {}   -- island board / Halloween quests we've worked on (they pay out by themselves)
    local function questStart(name, def)   -- pop up once when it starts working on a new quest
        questActed = true
        Hatch.questAt = os.clock()
        if Hatch.qwList and name then Hatch.qwList[name] = nil end
        if type(name) == "string" and (name:find("^HW_") or name:find("^IQ_")) then selfPaying[name] = true end
        if not Hatch.questBusy then
            Hatch.questBusy = true
            local r = root()
            questHome = r and r.CFrame or nil
        end
        if lastQuest == name then return end
        lastQuest = name
        Window:Notify({Type = "Info", Title = "Doing quest", Content = tostring(def.Description or name)})
    end
    -- how many to open at once, the same way the game's own auto hatch picks it (EggController.pickAutoHatchCount):
    -- x8 if you own the x8 gamepass (or an Octo Hatch boost) and can afford 8, else x3 if you can afford 3, else x1
    local function questHatchCount(egg)
        local d = GameData.get()
        local lec = rcfg("Shared.Pets.LaunchEggConfig")
        local ep = rcfg("Shared.Pets.EggPricing")
        local info = lec and lec[egg]
        if not (d and info and ep and ep.GetTotal) then return 1 end
        local coins = tonumber(d.Currencies and d.Currencies.Coins) or 0
        local function total(n) local ok, v = pcall(ep.GetTotal, d, egg, info.Price, n) return ok and tonumber(v) or math.huge end
        local gp, bf = rcfg("Shared.Monetization.GamepassPerks"), rcfg("Shared.Items.BoostFormula")
        local has8 = (gp and gp.Has and select(2, pcall(gp.Has, d, "x8Egg")) == true) or (bf and bf.HasType and select(2, pcall(bf.HasType, d, "OctoHatch")) == true)
        if has8 and total(8) <= coins then return 8 end
        if total(3) <= coins then return 3 end
        return 1
    end
    local function questHatch(egg)
        if not islandOpen(eggIsland(egg)) then return "island locked" end   -- never go to a locked island
        if not eggRemote then return "Egg remote not found" end
        local cf = eggSpot(egg)
        if not cf then
            local isl = eggIsland(egg) or "Spawn"
            local spot = ISLAND_SPOTS[isl] or ISLAND_SPOTS["Spawn"]
            local r = root()
            if r and spot and autoOn.AutoQuest then
                pcall(function() LP:RequestStreamAroundAsync(spot) end)
                if not autoOn.AutoQuest then return "stopped" end
                r.AssemblyLinearVelocity = Vector3.new()
                r.CFrame = CFrame.new(spot)
                settleOnGround(r)
                task.wait(1)
                pcall(scanEggs)
                cf = eggSpot(egg)
            end
        end
        if not cf then return "Can't find the " .. egg .. " egg yet" end
        if not autoOn.AutoQuest then return "stopped" end
        local r = root()
        if r and (r.Position - cf.Position).Magnitude > 10 then
            pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
            if not autoOn.AutoQuest then return "stopped" end
            local look = cf.LookVector * Vector3.new(1, 0, 1)
            if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
            local spot = cf.Position + look.Unit * 6 + Vector3.new(0, 2, 0)
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.lookAt(spot, Vector3.new(cf.Position.X, spot.Y, cf.Position.Z))
            task.wait(0.6)
        end
        if not autoOn.AutoQuest then return "stopped" end
        local seq
        seq = math.max(Hatch.seq or 0, Hatch.lastOk or 0, Hatch.sent or 0) + 1   -- always a new, higher number
        Hatch.seq = seq
        Hatch.sent = seq
        local sentAt = os.clock()
        -- quests always hatch the Fast Hatch way: the hatch animation is hidden and it hatches every 3 seconds
        -- (put back when the quests are done, unless you have Fast Hatch on yourself)
        if not Hatch.questHid then Hatch.questHid = true pcall(hideHatchGuis, true) end
        pcall(eggRemote.FireServer, eggRemote, {Egg = egg, Count = questHatchCount(egg), Auto = true, Seq = seq})
        if Hatch.lastOk then
            while running and autoOn.AutoQuest and os.clock() - sentAt < 3 do task.wait(0.05) end
        else   -- first hatch this session: wait for the game's answer so the hatch number is known
            while running and autoOn.AutoQuest and Hatch.lastResult < sentAt and os.clock() - sentAt < 8 do task.wait(0.05) end
        end
        return nil
    end
    -- the cheapest egg you can hatch right now, on any unlocked world (for "hatch X eggs on any island" quests)
    local function cheapestEgg(d)
        local lec = rcfg("Shared.Pets.LaunchEggConfig")
        local ep = rcfg("Shared.Pets.EggPricing")
        local best, bestP
        for name, info in pairs(lec or {}) do
            if type(name) == "string" and name ~= "Test" and type(info) == "table" and islandOpen(eggIsland(name)) then
                local p = ep and ep.GetUnitPrice and select(2, pcall(ep.GetUnitPrice, d, name, info.Price))
                p = tonumber(p) or tonumber(info.Price)
                if p and (not bestP or p < bestP) then best, bestP = name, p end
            end
        end
        return best or "Basic", bestP
    end
    local function islandPrice(name)
        local ic = rcfg("Shared.Progression.IslandConfig")
        local info = ic and ic.Islands and ic.Islands[name]
        return info and tonumber(info.Price)
    end
    local HW_KINDS = {Tap = true, Hatch = true, Rebirth = true, Golden = true, TrickOrTreat = true, HallowBoss = true}
    local lastAccept = 0
    local function acceptHalloween()
        lastAccept = os.clock()
        return HW.accept(function() return autoOn.AutoQuest == true end)
    end
    Rewards:CreateSection({Name = "Quests", Side = "Left"})
    local function questIdle()   -- nothing left to do right now: hand back to Auto Hatch, or go home
        if Hatch.questHid then Hatch.questHid = false if not Hatch.fast then pcall(hideHatchGuis, false) end end
        if not Hatch.questBusy then return end
        Hatch.questBusy = false
        lastQuest = nil
        if not autoHatch then
            local r = root()
            if r and questHome and autoOn.AutoQuest then
                pcall(function() LP:RequestStreamAroundAsync(questHome.Position) end)
                r.AssemblyLinearVelocity = Vector3.new()
                r.CFrame = questHome
                Window:Notify({Type = "Info", Title = "Auto Quest", Content = "All quests I can do are done - back where you were"})
            end
        else
            Window:Notify({Type = "Info", Title = "Auto Quest", Content = "All quests I can do are done - back to hatching"})
        end
        questHome = nil
    end
    task.spawn(function()   -- turning Auto Quest off un-pauses Auto Hatch
        while running do
            if Hatch.questBusy and not autoOn.AutoQuest then Hatch.questBusy = false questHome = nil end
            task.wait(0.5)
        end
    end)
    local questRunInner
    -- "WAITING ON": every quest Auto Quest can't do right now, why, and how long until it can
    Hatch.qwList = {}
    function Hatch.qwAdd(name, cur, text)
        if name then Hatch.qwList[name] = text end
        return cur or text
    end
    function Hatch.fmtLeft(sec)
        sec = math.max(0, math.ceil(tonumber(sec) or 0))
        if sec >= 3600 then return math.floor(sec / 3600) .. "h " .. math.floor(sec % 3600 / 60) .. "m" end
        if sec >= 60 then return math.floor(sec / 60) .. "m " .. (sec % 60) .. "s" end
        return sec .. "s"
    end
    autoLoop(Rewards, {Name = "Auto Quest", Side = "Left", Description = "Claims + does your quests, easiest first", Flag = "AutoQuest", Every = 0.3, Run = function()
        questActed = false
        local ok, msg = pcall(questRunInner)
        if not ok then error(msg, 0) end
        if not questActed then questIdle() end
        pcall(function()
            local lines = {}
            for _, t in pairs(Hatch.qwList) do table.insert(lines, "• " .. tostring(t)) end
            table.sort(lines)
            local txt = #lines > 0 and table.concat(lines, "\n") or "Nothing - every open quest is being done"
            if txt ~= Hatch.qwShown then Hatch.qwShown = txt Hatch.qwPara:Set({Content = txt}) end
        end)
        return msg
    end})
    Hatch.qwPara = Rewards:CreateParagraph({Side = "Left", Title = "Quests waiting on", Content = "Turn on Auto Quest"})
    questRunInner = function()
        local qc = rcfg("Shared.Quests.QuestConfig")
        local d = GameData.get()
        local quests = d and d.Quests
        if not (qc and qc.Definitions and type(quests) == "table") then return "Couldn't read your quests" end
        -- 0) the Hallow Lord comes first: if today's Halloween jobs need it and a fight is starting / on, do that
        do
            local hw = rcfg("Shared.Quests.HalloweenDailyConfig")
            local okC, cur = false, nil
            if hw and hw.Current then okC, cur = pcall(hw.Current, d) end
            if okC and type(cur) == "table" and type(cur.Quests) == "table" then
                for _, j in ipairs(cur.Quests) do
                    local tpl = hw.GetTemplate and hw.GetTemplate(j.Id)
                    local kind = tpl and tpl.Kind or j.Id
                    local paid = hw.IsPaid and hw.IsPaid(cur, j.Id)
                    local amt = tonumber(cur.Progress and cur.Progress[j.Id]) or 0
                    if kind == "HallowBoss" and not paid and amt < (tonumber(j.Goal) or 1) then
                        local phase = HW.bossState().Phase
                        if phase == "Warning" or phase == "Fight" or HW.bossBack then
                            local msg, busy = HW.bossStep(function() return autoOn.AutoQuest == true end)
                            if busy then
                                questStart("HW_HallowBoss", {Description = "Halloween: Help defeat the Hallow Lord!"})
                                return "Quest (boss first): " .. msg
                            end
                        end
                        break
                    end
                end
            end
        end
        -- 1) claim anything finished (the game has a 1s cooldown per claim)
        for qname, q in pairs(quests) do
            if type(q) == "table" and q.Completed == true and q.Claimed ~= true and os.clock() - lastClaim > 1.2 and (claimFailUntil[qname] or 0) < os.clock() then
                lastClaim = os.clock()
                local ok, res = send("QuestService.RF.ClaimQuest", {Quest = qname})
                if ok and type(res) == "table" and res.Success == true then
                    Window:Notify({Type = "Success", Title = "Quest claimed", Content = tostring(qc.Definitions[qname] and qc.Definitions[qname].Description or qname)})
                    Webhook.hour.quests += 1
                    return "Claimed " .. qname
                end
                claimFailUntil[qname] = os.clock() + 60   -- game said no: try again in a minute, do other quests meanwhile
                break
            end
        end
        -- 2) the open quests, in the game's order
        local open = {}
        for qname, q in pairs(quests) do
            local def = qc.Definitions[qname]
            if def and type(q) == "table" and q.Completed ~= true then table.insert(open, {name = qname, q = q, def = def}) end
        end
        local ep = rcfg("Shared.Pets.EggPricing")
        local lec = rcfg("Shared.Pets.LaunchEggConfig")
        -- NPC QUESTS (from the game's NpcQuestController / NpcQuestConfig, e.g. Boingo at spawn): each line has steps -
        -- Talk (go to the NPC: NpcQuestService:Talk({Line = id})), Stat (taps / eggs opened), Collect (fly to each core:
        -- NpcQuestService:Collect({Line, Core})), Island (unlock it). Your place in it: Data.NpcQuests[line].
        do
            local nq = rcfg("Shared.Quests.NpcQuestConfig")
            if nq and type(nq.Lines) == "table" and (not nq.IsAvailable or select(2, pcall(nq.IsAvailable, d)) ~= false) then
                for lineId, line in pairs(nq.Lines) do
                    local entry = nq.GetEntry and select(2, pcall(nq.GetEntry, d, lineId)) or (type(d.NpcQuests) == "table" and d.NpcQuests[lineId])
                    entry = type(entry) == "table" and entry or nil
                    if not (entry and entry.Done) then
                        local okS, step = pcall(nq.CurrentStep, line, entry)
                        step = okS and type(step) == "table" and step or (line.Steps and line.Steps[1])
                        if step then
                            local okC, complete = pcall(nq.IsStepComplete, line, entry, d)
                            local cur, goal = 0, 1
                            pcall(function() cur, goal = nq.Progress(line, entry, d) end)
                            local kind = step.Kind
                            local group = "NPC_" .. tostring(kind)
                            if kind == "Talk" or (okC and complete) then group = "NPC_Talk"
                            elseif kind == "Stat" then group = (step.Stat == "EggsOpened") and "NPC_Eggs" or "NPC_Tap" end
                            table.insert(open, {name = "NPC_" .. lineId, q = {Amount = tonumber(cur) or 0},
                                def = {Description = tostring(line.Speaker or line.Npc) .. ": " .. tostring(step.Title or kind), Goal = tonumber(goal) or 1,
                                    Group = group, Line = line, LineId = lineId, Step = step, Entry = entry}})
                        end
                    end
                end
            end
        end
        -- SLIME / BOUNCY KEY (from BouncyObbyConfig + IslandBreakableConfig): the Invisible Toilet on Autumn makes
        -- a Bouncy Key from 20 Slime (BouncyObbyService:CraftKey()). Slime comes from the Glow Mushroom on Mushroom
        -- Island (4 per break, ready again after 8 min). Done once Data.BouncyObby.Key is true.
        do
            local bo = type(d.BouncyObby) == "table" and d.BouncyObby or {}
            local licensed = type(d.Unlocks) == "table" and d.Unlocks.BouncyBallLicense == true
            if bo.Key ~= true and not licensed then
                local owned = d.Items and d.Items.Owned
                local slime = owned and tonumber(owned.Slime) or 0
                table.insert(open, {name = "SlimeKey", q = {Amount = math.min(slime, 20)},
                    def = {Description = "Bouncy Key: 20 Slime from Glow Mushrooms", Goal = 20, Group = "SLIME", Slime = slime}})
            end
        end
        -- island quest boards (Autumn / Mushroom / Heaven ...): "Open 10 Pumpkin eggs!", "Open 35 Heaven eggs!" etc. From IslandQuestConfig; your
        -- progress is Data.IslandQuests[island].Progress[Id], they pay out by themselves. Hatch ones are done like
        -- egg quests (the shrine / Wave Defense ones it skips for now).
        do
            local iqc = rcfg("Shared.Quests.IslandQuestConfig")
            local iq = type(d.IslandQuests) == "table" and d.IslandQuests or {}
            if iqc and type(iqc.Boards) == "table" then
                -- every board in the game (Autumn, Mushroom, Heaven ...) on an island you have - a board you haven't
                -- started yet (no entry in your data, like Heaven at first) counts as 0 progress
                for island, board in pairs(iqc.Boards) do
                    local entry = type(iq[island]) == "table" and iq[island] or {Progress = {}}
                    if islandOpen(island) and entry.Claimed ~= true and type(board) == "table" and type(board.Quests) == "table" then
                        for _, qd in ipairs(board.Quests) do
                            local paid = iqc.IsPaid and select(2, pcall(iqc.IsPaid, entry, qd.Id)) == true
                            local amt = tonumber(entry.Progress and entry.Progress[qd.Id]) or 0
                            if qd.Kind == "Hatch" and qd.Egg and not paid and amt < (tonumber(qd.Goal) or 1) then
                                table.insert(open, {name = "IQ_" .. island .. "_" .. qd.Id, q = {Amount = amt},
                                    def = {Description = island .. " board: " .. tostring(qd.Text), Goal = qd.Goal, Egg = qd.Egg, Group = "IQ_" .. island}})
                            elseif qd.Kind == "Shrine" and not paid and amt < (tonumber(qd.Goal) or 1) then
                                table.insert(open, {name = "IQ_" .. island .. "_" .. qd.Id, q = {Amount = amt},
                                    def = {Description = island .. " board: " .. tostring(qd.Text), Goal = qd.Goal, Group = "IQ_Shrine", Island = island}})
                            elseif not paid and amt < (tonumber(qd.Goal) or 1) then
                                -- every other kind of board quest: the same jobs the Halloween dailies use (tap, hatch any
                                -- egg, rebirth, golden, trick or treat, Hallow Lord), Wave Defense, or "can't do it yet"
                                local kind = tostring(qd.Kind)
                                local group = (kind == "WaveDefense" and "IQ_Wave") or (HW_KINDS[kind] and ("HW_" .. kind)) or "IQ_Unknown"
                                table.insert(open, {name = "IQ_" .. island .. "_" .. tostring(qd.Id), q = {Amount = amt},
                                    def = {Description = island .. " board: " .. tostring(qd.Text), Goal = qd.Goal, Group = group, Island = island, Kind = kind}})
                            end
                        end
                    end
                end
            end
        end
        -- Halloween: get today's jobs from the Candy Witch if you don't have them, then add the open ones
        local hw = rcfg("Shared.Quests.HalloweenDailyConfig")
        if hw and hw.IsActive and select(2, pcall(hw.IsActive)) == true then
            local okO, offer = pcall(hw.HasOffer, d)
            if okO and offer == true and os.clock() - lastAccept > 60 then
                questStart("HalloweenAccept", {Description = "Get today's quests from the Candy Witch"})
                return acceptHalloween()
            end
            local okC, cur = pcall(hw.Current, d)
            if okC and type(cur) == "table" then
                local okR, list = pcall(hw.Resolve, cur)
                for _, j in ipairs(okR and list or {}) do
                    if HW_KINDS[j.Kind] and not (hw.IsPaid and hw.IsPaid(cur, j.Id)) then
                        local amt = tonumber(cur.Progress and cur.Progress[j.Id]) or 0
                        if amt < (tonumber(j.Goal) or 1) then
                            table.insert(open, {name = "HW_" .. j.Id, q = {Amount = amt}, def = {Description = "Halloween: " .. j.Text, Goal = j.Goal, Group = "HW_" .. j.Kind}})
                        end
                    end
                end
            end
        end
        do   -- a self-paying quest we worked on that isn't open any more = done
            local still = {}
            for _, e in ipairs(open) do still[e.name] = true end
            for qn in pairs(selfPaying) do
                if not still[qn] then selfPaying[qn] = nil Webhook.hour.quests += 1 end
            end
        end
        -- easiest first: how many coins are still needed to finish it (equip / golden / tap need none)
        local rbNow = rebirthsNow()
        for _, e in ipairs(open) do
            local def, left = e.def, math.max(1, (tonumber(e.def.Goal) or 1) - (tonumber(e.q.Amount) or 0))
            local cost = 0
            if def.Egg then
                local info = lec and lec[def.Egg]
                local unit = ep and ep.GetUnitPrice and info and select(2, pcall(ep.GetUnitPrice, d, def.Egg, info.Price))
                e.unit = tonumber(unit) or 1e30   -- how hard the egg itself is (its price)
                cost = e.unit * left
            elseif type(def.Group) == "string" and def.Group:sub(1, 6) == "Portal" then
                cost = islandPrice(def.Group:sub(7)) or 1e30
            elseif def.Group == "Rebirth" or def.Group == "HW_Rebirth" then
                cost = rbNow and rebirthPrice(1, rbNow) * left or 1e30
            elseif def.Group == "HW_Hatch" or def.Group == "NPC_Eggs" then
                local _, unit = cheapestEgg(d)
                cost = (tonumber(unit) or 1e30) * left
            end
            e.cost = cost
        end
        -- egg quests stay together (where the easiest one would go) and run cheapest egg -> priciest egg
        local eggBlock
        for _, e in ipairs(open) do if e.unit then eggBlock = math.min(eggBlock or math.huge, e.cost) end end
        for _, e in ipairs(open) do
            e.key1 = e.unit and eggBlock or e.cost
            e.key2 = e.unit or 0
        end
        table.sort(open, function(a, b)
            if a.key1 ~= b.key1 then return a.key1 < b.key1 end
            if a.key2 ~= b.key2 then return a.key2 < b.key2 end
            if a.cost ~= b.cost then return a.cost < b.cost end
            local oa = qc.Orders and qc.Orders[a.def.Group] or 0
            local ob = qc.Orders and qc.Orders[b.def.Group] or 0
            return oa < ob
        end)
        if #open == 0 then return "No open quests · waiting for new ones" end
        local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
        local waitMsg
        do   -- the waiting list only keeps quests that are still open (skipped ones keep their last reason)
            local isOpen = {}
            for _, e in ipairs(open) do isOpen[e.name] = true end
            for n in pairs(Hatch.qwList) do if not isOpen[n] then Hatch.qwList[n] = nil end end
        end
        for _, e in ipairs(open) do
            local name, def, q = e.name, e.def, e.q
            local amount = tonumber(q.Amount) or 0
            local progress = " (" .. short(amount) .. "/" .. short(def.Goal or 1) .. ")"
            if (skipUntil[name] or 0) < os.clock() then
                if def.Egg then
                    local lec = rcfg("Shared.Pets.LaunchEggConfig")
                    local info = lec and lec[def.Egg]
                    local isl = eggIsland(def.Egg)
                    local ep = rcfg("Shared.Pets.EggPricing")
                    local unit = ep and ep.GetUnitPrice and info and select(2, pcall(ep.GetUnitPrice, d, def.Egg, info.Price))
                    unit = tonumber(unit)
                    local coins = tonumber(d.Currencies and d.Currencies.Coins) or coinsNow()
                    if not islandOpen(isl) then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock " .. isl .. " first"))
                    elseif unit and coins and coins < unit then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · need " .. short(unit) .. " coins"))
                    else
                        -- give up on it for a minute if it hasn't moved after 8 tries, or the game says no
                        local t = tries[name]
                        if not t or t.amount ~= amount then tries[name] = {amount = amount, n = 0} t = tries[name] end
                        t.n += 1
                        if t.n > 8 then
                            skipUntil[name] = os.clock() + 60
                            tries[name] = nil
                        else
                            Hatch.info = nil
                            questStart(name, def)
                            local err = questHatch(def.Egg)
                            if err or (Hatch.info and tostring(Hatch.info):find("^Game said no")) then
                                skipUntil[name] = os.clock() + 60   -- can't do it right now: next quest
                                tries[name] = nil
                            else
                                return "Quest: " .. def.Description .. progress
                            end
                        end
                    end
                elseif type(def.Group) == "string" and def.Group:sub(1, 6) == "Portal" then
                    local isl = def.Group:sub(7)
                    local price = islandPrice(isl)
                    local coins = coinsNow()
                    if islandOpen(isl) then
                        skipUntil[name] = os.clock() + 10
                    elseif nextLockedIsland() ~= isl then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock the islands before it first"))
                    elseif not (price and coins) or coins < price then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. (price and (" · need " .. short(price) .. " coins") or " · can't read the price")))
                    else
                        questStart(name, def)
                        local ok, msg = pcall(unlockIsland, "AutoQuest")
                        msg = tostring(ok and msg or "")
                        if msg:find("Unlocked") then return "Quest: " .. def.Description .. " · " .. msg end
                        skipUntil[name] = os.clock() + 30   -- couldn't: next quest
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · " .. (msg ~= "" and msg or "couldn't unlock")))
                    end
                elseif def.Group == "Rebirth" then
                    local coins, rb = coinsNow(), rebirthsNow()
                    if coins and rb and rebirthPrice(1, rb) > coins then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · need " .. short(rebirthPrice(1, rb)) .. " coins"))
                    else
                        questStart(name, def)
                        send("RebirthService.RE.RebirthRequested", {Index = 1})
                        skipUntil[name] = os.clock() + 1
                        return "Quest: " .. def.Description .. progress
                    end
                elseif def.Group == "GoldenPet" then
                    -- the real golden machine trip (go to it, craft the sets, come back) - only when there's a set to gold,
                    -- so it doesn't pull you off your egg for nothing
                    local msgG, madeG = Hatch.goldenReadyMsg()
                    if not msgG then
                        questStart(name, def)
                        msgG, madeG = Hatch.goldenRun(function() return autoOn.AutoQuest == true end, math.max(1, (tonumber(def.Goal) or 1) - amount))
                    end
                    if (madeG or 0) > 0 then return "Quest: " .. def.Description .. progress .. " · made " .. madeG .. " golden" end
                    skipUntil[name] = os.clock() + 30   -- if it didn't count, the next quests get a turn
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. progress .. " · " .. tostring(msgG)))
                elseif def.Group == "EquipPet" then
                    questStart(name, def)
                    pcall(equipBest)
                    skipUntil[name] = os.clock() + 10
                elseif def.Group == "HW_HallowBoss" then
                    -- only while a fight is on; the rest of the time it does other quests
                    local msg, busy = HW.bossStep(function() return autoOn.AutoQuest == true end)
                    if busy then questStart(name, def) return "Quest: " .. def.Description .. " · " .. msg end
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · next fight in " .. Hatch.fmtLeft((function()
                        local hb = rcfg("Shared.Game.HallowBossConfig")
                        local now = workspace:GetServerTimeNow()
                        local nxt = hb and hb.NextStart and hb.NextStart(now)
                        return nxt and (nxt - now) or 0
                    end)())))
                elseif def.Group == "NPC_Talk" then
                    -- go to the NPC (its model is named after it, e.g. Workspace.Boingo) and talk
                    local npcName = tostring(def.Line.Npc or def.Line.Speaker)
                    -- NPCs far away aren't loaded in, so: the game's "NPC" tag, then by name, then load in spawn
                    -- (Boingo's quest is all around spawn) and look again. Where it was seen is remembered.
                    Hatch.npcSeen = Hatch.npcSeen or {}
                    local function findNpc()
                        for _, m in ipairs(CollectionS:GetTagged("NPC")) do
                            if m.Name == npcName and m:IsDescendantOf(workspace) then return m end
                        end
                        return workspace:FindFirstChild(npcName, true)
                    end
                    local npc = findNpc()
                    if not npc then
                        local spot = Hatch.npcSeen[npcName] or Vector3.new(-50.64, -511.73, -1888.64)
                        pcall(function() LP:RequestStreamAroundAsync(spot) end)
                        task.wait(0.5)
                        npc = findNpc()
                    end
                    local okP, pos = false, nil
                    if npc then okP, pos = pcall(function() return npc:GetPivot().Position end) end
                    if okP and pos then Hatch.npcSeen[npcName] = pos end
                    local r = root()
                    if okP and pos and r and autoOn.AutoQuest then
                        questStart(name, def)
                        pcall(function() LP:RequestStreamAroundAsync(pos) end)
                        r.AssemblyLinearVelocity = Vector3.new()
                        r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 6), pos)
                        task.wait(0.6)
                        send("NpcQuestService.RF.Talk", {Line = def.LineId})
                        pcall(function()   -- close the chat box it opens
                            local Dlg = require(RS.Modules.Client.Dialog.Dialog)
                            for _, fname in ipairs({"CloseAll", "Close", "Dismiss"}) do if type(Dlg[fname]) == "function" and pcall(Dlg[fname]) then break end end
                        end)
                        skipUntil[name] = os.clock() + 30   -- don't keep going back if the NPC has nothing new yet
                        return "Quest: " .. def.Description
                    end
                    skipUntil[name] = os.clock() + 60
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · couldn't find " .. npcName))
                elseif def.Group == "NPC_Tap" then
                    questStart(name, def)
                    if not autoTap then for _ = 1, 120 do if not autoOn.AutoQuest then break end pcall(tapOnce) end end
                    return "Quest: " .. def.Description .. progress
                elseif def.Group == "NPC_Eggs" then
                    local egg = cheapestEgg(d)
                    questStart(name, def)
                    Hatch.info = nil
                    local err = questHatch(egg)
                    if err or (Hatch.info and tostring(Hatch.info):find("^Game said no")) then
                        skipUntil[name] = os.clock() + 60
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · " .. tostring(err or Hatch.info)))
                    else
                        return "Quest: " .. def.Description .. progress
                    end
                elseif def.Group == "NPC_Collect" then
                    -- fly to every core it still needs and pick it up
                    local nq = rcfg("Shared.Quests.NpcQuestConfig")
                    local okO, cores = pcall(nq.OpenCores, def.Line, def.Entry)
                    cores = okO and type(cores) == "table" and cores or {}
                    if #cores > 0 then questStart(name, def) end
                    for _, core in ipairs(cores) do
                        if not autoOn.AutoQuest then break end
                        local r = root()
                        if r and typeof(core.Position) == "Vector3" then
                            pcall(function() LP:RequestStreamAroundAsync(core.Position) end)
                            r.AssemblyLinearVelocity = Vector3.new()
                            r.CFrame = CFrame.new(core.Position + Vector3.new(0, 3, 0))
                            task.wait(0.5)
                            send("NpcQuestService.RF.Collect", {Line = def.LineId, Core = core.Id})
                            task.wait(0.4)
                        end
                    end
                    skipUntil[name] = os.clock() + 5
                    if #cores > 0 then return "Quest: " .. def.Description end
                elseif def.Group == "NPC_Island" then
                    local isl = def.Step and def.Step.Island
                    if isl and nextLockedIsland() == isl then
                        local price = islandPrice(isl)
                        local coins = coinsNow()
                        if price and coins and coins >= price then
                            questStart(name, def)
                            local ok, msg = pcall(unlockIsland, "AutoQuest")
                            skipUntil[name] = os.clock() + 30
                            return "Quest: " .. def.Description .. " · " .. tostring(ok and msg or "")
                        end
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. (price and (" · need " .. short(price) .. " coins") or "")))
                    else
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock the islands before it first"))
                    end
                elseif def.Group == "IQ_Wave" then
                    -- Wave Defense board quest (e.g. "Clear wave 5"): Auto Wave Defense plays it whenever it's ready
                    if not autoOn.AutoWaveDefense and AUTO.waveToggle then
                        pcall(function() AUTO.waveToggle:Set({CurrentValue = true}) end)
                        Window:Notify({Type = "Info", Title = "Auto Quest", Content = "Turned on Auto Wave Defense for: " .. def.Description})
                    end
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. progress .. " · Auto Wave Defense is on it" .. (function()
                        local col = type(d.Colosseum) == "table" and d.Colosseum or {}
                        local left = (tonumber(col.Cooldown) or 0) + 1800 - workspace:GetServerTimeNow()
                        return left > 0 and (" · next game in " .. Hatch.fmtLeft(left)) or " · ready now"
                    end)()))
                elseif def.Group == "IQ_Unknown" then
                    skipUntil[name] = os.clock() + 300
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. progress .. " · can't do " .. tostring(def.Kind) .. " quests yet"))
                elseif def.Group == "IQ_Shrine" then
                    -- the shrine on Autumn (ShrineConfig.FindShrine: Ts2Islands.Autumn.Shrine): stand within 45 studs and
                    -- ShrineService:Choose(<blessing>) - picks Luck
                    if not islandOpen("Autumn") then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock Autumn first"))
                    else
                        questStart(name, def)
                        local sc = rcfg("Shared.Game.ShrineConfig")
                        local function shrine() return sc and sc.FindShrine and sc.FindShrine() or nil end
                        local m = shrine()
                        local r = root()
                        if not m and r and autoOn.AutoQuest then
                            pcall(function() LP:RequestStreamAroundAsync(ISLAND_SPOTS["Autumn"]) end)
                            r.AssemblyLinearVelocity = Vector3.new()
                            r.CFrame = CFrame.new(ISLAND_SPOTS["Autumn"])
                            settleOnGround(r)
                            for _ = 1, 30 do m = shrine() if m then break end task.wait(0.1) end
                        end
                        local ok, pos = false, nil
                        if m then ok, pos = pcall(function() return m:GetPivot().Position end) end
                        r = root()
                        if ok and pos and r and autoOn.AutoQuest then
                            r.AssemblyLinearVelocity = Vector3.new()
                            r.CFrame = CFrame.new(pos + Vector3.new(0, 4, 10), pos)
                            task.wait(0.5)
                            local okC, res = send("ShrineService.RF.Choose", "Luck")
                            skipUntil[name] = os.clock() + 30
                            if okC and type(res) == "table" and res.Success == false then
                                waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · shrine said: " .. tostring(res.Reason or res.Message)))
                            else
                                return "Quest: " .. def.Description .. " · picked Luck"
                            end
                        else
                            skipUntil[name] = os.clock() + 60
                            waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · couldn't find the shrine"))
                        end
                    end
                elseif def.Group == "HW_TrickOrTreat" then
                    questStart(name, def)
                    local msg, n = HW.trickOrTreat(function() return autoOn.AutoQuest == true end)
                    if n > 0 then return "Quest: " .. def.Description .. " · " .. msg end
                    skipUntil[name] = os.clock() + 120   -- houses on cooldown: do other quests meanwhile
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · " .. msg))
                elseif def.Group == "HW_Tap" then
                    questStart(name, def)
                    if not autoTap then for _ = 1, 120 do if not autoOn.AutoQuest then break end pcall(tapOnce) end end
                    return "Quest: " .. def.Description .. progress
                elseif def.Group == "HW_Hatch" then
                    -- any egg counts: always the cheapest one, whatever world it's on
                    local egg = cheapestEgg(d)
                    questStart(name, def)
                    Hatch.info = nil
                    local err = questHatch(egg)
                    if err or (Hatch.info and tostring(Hatch.info):find("^Game said no")) then
                        skipUntil[name] = os.clock() + 60
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · " .. tostring(err or Hatch.info)))
                    else
                        return "Quest: " .. def.Description .. progress
                    end
                elseif def.Group == "HW_Rebirth" then
                    local coins, rb = coinsNow(), rebirthsNow()
                    if coins and rb and rebirthPrice(1, rb) > coins then
                        waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · need " .. short(rebirthPrice(1, rb)) .. " coins"))
                    else
                        questStart(name, def)
                        send("RebirthService.RE.RebirthRequested", {Index = 1})
                        skipUntil[name] = os.clock() + 1
                        return "Quest: " .. def.Description .. progress
                    end
                elseif def.Group == "SLIME" then
                    local r = root()
                    if def.Slime >= 20 then
                        -- enough Slime: go to the Invisible Toilet (Autumn) and make the key
                        if not islandOpen("Autumn") then
                            waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock Autumn first"))
                        elseif r and autoOn.AutoQuest then
                            questStart(name, def)
                            local spot = Vector3.new(-129.87, 901.98, -1973.53)
                            pcall(function() LP:RequestStreamAroundAsync(spot) end)
                            local t = workspace:FindFirstChild("Theinvisibletoilet")
                            local okP, p = false, nil
                            if t then okP, p = pcall(function() return t:GetPivot().Position end) end
                            if okP and p then spot = p end
                            r.AssemblyLinearVelocity = Vector3.new()
                            r.CFrame = CFrame.new(spot + Vector3.new(0, 3, 6), spot)
                            task.wait(0.8)
                            local ok, res = send("BouncyObbyService.RF.CraftKey")
                            local why = type(res) == "table" and res.Reason
                            if ok and type(res) == "table" and (res.Success == true or why == "AlreadyOwned") then
                                Window:Notify({Type = "Success", Title = "Auto Quest", Content = "Got the Bouncy Key from the Invisible Toilet!"})
                            else
                                skipUntil[name] = os.clock() + 60
                                waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · toilet said " .. tostring(why or "no")))
                            end
                            return "Quest: " .. def.Description .. " · making the key"
                        end
                    else
                        -- break the Glow Mushroom: it appears near its spot on Mushroom Island (only for you), you hit
                        -- it by tapping within 14 studs, and it hops away when hit, so it keeps following it
                        local ibc = rcfg("Shared.Game.IslandBreakableConfig")
                        local readyAt = ibc and ibc.GetReadyAt and select(2, pcall(ibc.GetReadyAt, d, "Mushroom")) or 0
                        local now = 0
                        pcall(function() now = workspace:GetServerTimeNow() end)
                        local spots = workspace:FindFirstChild("IslandBreakableSpots")
                        local spot = spots and spots:GetAttribute("Mushroom")
                        if not islandOpen("Mushroom") then
                            waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · unlock Mushroom first"))
                        elseif (tonumber(readyAt) or 0) > now then
                            local left = math.ceil((tonumber(readyAt) or 0) - now)
                            waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. progress .. " · Glow Mushroom back in " .. math.floor(left / 60) .. "m " .. (left % 60) .. "s"))
                        elseif typeof(spot) ~= "Vector3" then
                            skipUntil[name] = os.clock() + 30
                            waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. " · couldn't find the Glow Mushroom spot"))
                        elseif r and autoOn.AutoQuest then
                            questStart(name, def)
                            local function mushroom()
                                for _, m in ipairs(CollectionS:GetTagged("Breakable")) do
                                    if m:GetAttribute("BreakableType") == "IslandMushroom" and m:IsDescendantOf(workspace)
                                        and m:GetAttribute("BreakableBroken") ~= true and m:GetAttribute("BreakableDespawned") ~= true then
                                        local owner = m:GetAttribute("BreakableOwner")
                                        if owner == nil or owner == LP.UserId then return m end
                                    end
                                end
                            end
                            local function hit()
                                if Hatch.tapSeq and tapRemote then
                                    Hatch.tapSeq += 1
                                    pcall(tapRemote.FireServer, tapRemote, {ClientSequence = Hatch.tapSeq, Auto = false, Source = "screen"})
                                else
                                    pcall(tapOnce)
                                end
                            end
                            pcall(function() LP:RequestStreamAroundAsync(spot) end)
                            r.AssemblyLinearVelocity = Vector3.new()
                            r.CFrame = CFrame.new(spot + Vector3.new(0, 4, 0))
                            local seen, started = false, os.clock()
                            while autoOn.AutoQuest and os.clock() - started < 95 do
                                local m = mushroom()
                                if not m then
                                    if seen or os.clock() - started > 10 then break end   -- broken, or it never showed up
                                else
                                    seen = true
                                    local okP, p = pcall(function() return m:GetPivot().Position end)
                                    local rr = root()
                                    if okP and p and rr then
                                        rr.AssemblyLinearVelocity = Vector3.new()
                                        rr.CFrame = CFrame.new(p + Vector3.new(5, 2, 0), p)
                                    end
                                    hit()
                                end
                                task.wait(0.07)
                            end
                            if not seen then skipUntil[name] = os.clock() + 60 end
                            return "Quest: " .. def.Description .. progress .. (seen and " · broke the Glow Mushroom" or " · Glow Mushroom didn't show up")
                        end
                    end
                elseif def.Group == "HW_Golden" then
                    -- the real golden machine trip (go to it, craft the sets, come back) - only when there's a set to gold,
                    -- so it doesn't pull you off your egg for nothing
                    local msgG, madeG = Hatch.goldenReadyMsg()
                    if not msgG then
                        questStart(name, def)
                        msgG, madeG = Hatch.goldenRun(function() return autoOn.AutoQuest == true end, math.max(1, (tonumber(def.Goal) or 1) - amount))
                    end
                    if (madeG or 0) > 0 then return "Quest: " .. def.Description .. progress .. " · made " .. madeG .. " golden" end
                    skipUntil[name] = os.clock() + 30
                    waitMsg = Hatch.qwAdd(name, waitMsg, (def.Description .. progress .. " · " .. tostring(msgG)))
                end
            end
        end
        -- nothing it can do because you need more coins: turn on Auto Tap so you earn them
        if waitMsg and waitMsg:find("coins") and not autoTap and not questTapOn then
            questTapOn = true
            pcall(function() tapToggle:Set({CurrentValue = true}) end)
            Window:Notify({Type = "Info", Title = "Auto Quest", Content = "Need more coins - turned on Auto Tap"})
        end
        if not (waitMsg and waitMsg:find("coins")) then questTapOn = false end
        return waitMsg or "Waiting on your quests"
    end
    Rewards:CreateLabel({Text = "Auto Quest claims finished quests and does the rest easiest to hardest. Quests that need waiting are skipped meanwhile. If Auto Hatch is on it pauses it, does the quests, then sends you back to your egg; otherwise it puts you back where you were.", Side = "Left"})
end

