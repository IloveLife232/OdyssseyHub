local function rewardText(r)
    if type(r) ~= "table" then return "" end
    if type(r.Amount) == "number" then return short(r.Amount) .. " " .. tostring(r.Type or r.Currency or r.Name or "") end
    local parts = {}
    for k, v in pairs(r) do
        if type(v) == "number" then table.insert(parts, short(v) .. " " .. tostring(k))
        elseif type(v) == "table" and type(v.Amount) == "number" then table.insert(parts, short(v.Amount) .. " " .. tostring(v.Type or v.Name or k)) end
    end
    return table.concat(parts, ", ")
end

