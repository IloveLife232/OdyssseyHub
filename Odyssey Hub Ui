-- PET INDEX (from the game's PetIndexCatalog + PetIndexRngController, and your watch file): the game lists what's
-- ready with PetIndexCatalog.Claimables(Data.Pets) -> {Kind = "Pet"/"Egg", Name, Tier}. Its "Claim All" button sends
-- PetIndexService.ClaimAllRequested:Fire(); one pet = PetRewardClaimRequested:Fire(name, tier) (e.g. "Kitty", "Shiny"),
-- one egg page = RewardClaimRequested:Fire(egg). Only sends anything when something is really ready.
local PET_INDEX_SPOTS = {Vector3.new(-109.42, -516.17, -1906.15), Vector3.new(89.19, 2031.71, -1965.80), Vector3.new(-25.50, 11042.32, -1706.30)}
HANDLERS["PetIndexService.RE.ClaimAllRequested"] = function()
    local cat = rcfg("Shared.Pets.PetIndexCatalog")
    if not (cat and cat.Claimables) then return "Couldn't read the Pet Index" end
    local function ready()
        local d = GameData.get()
        if not (d and d.Pets) then return {} end
        local ok, list = pcall(cat.Claimables, d.Pets)
        return ok and type(list) == "table" and list or {}
    end
    local function claimRound()
        send("PetIndexService.RE.ClaimAllRequested")
        task.wait(1.5)
        for _, it in ipairs(ready()) do
            if not (running and claimOn["PetIndexService.RE.ClaimAllRequested"]) then break end
            if it.Kind == "Pet" then
                send("PetIndexService.RE.PetRewardClaimRequested", it.Name, it.Tier)
            else
                send("PetIndexService.RE.RewardClaimRequested", it.Name)
            end
            task.wait(0.35)
        end
        task.wait(1)
    end
    local before = #ready()
    if before == 0 then return "No index rewards ready · " .. os.date("%H:%M") end
    claimRound()
    local left = #ready()
    if left >= before then
        -- the game didn't take it from here: go stand on the closest Pet Index circle and try once more
        local r = root()
        if r then
            local back = r.CFrame
            local best, bd
            local function consider(pos) local dd = (pos - r.Position).Magnitude if not bd or dd < bd then best, bd = pos, dd end end
            for _, ip in ipairs(CollectionS:GetTagged("InteractionPoint")) do
                if ip.Name == "PetIndex" and ip:IsDescendantOf(workspace) then
                    local ok, pos = pcall(function() return ip:IsA("BasePart") and ip.Position or ip:GetPivot().Position end)
                    if ok and pos then consider(pos) end
                end
            end
            for _, pos in ipairs(PET_INDEX_SPOTS) do consider(pos) end
            if best then
                pcall(function() LP:RequestStreamAroundAsync(best) end)
                r.AssemblyLinearVelocity = Vector3.new()
                r.CFrame = CFrame.new(best + Vector3.new(0, 3, 0))
                task.wait(0.8)
                claimRound()
                pcall(function()
                    local MC = require(RS.Controllers.UI.MenuController)
                    local open = MC:GetOpen()
                    if open ~= nil then MC:Close(open) end
                end)
                local rr = root()
                if rr then rr.AssemblyLinearVelocity = Vector3.new() rr.CFrame = back end
            end
        end
        left = #ready()
    end
    if left < before then return "Claimed " .. (before - left) .. " index reward(s) · " .. os.date("%H:%M") end
    return "Game didn't give the " .. before .. " ready reward(s) · " .. os.date("%H:%M")
end
