-- knock every ready house once; returns a status and how many it knocked
-- where each house is, remembered once seen (houses far away aren't loaded in, so they're not always in HW.pads)
HW.housePos = HW.housePos or {}
function HW.trickOrTreat(on)
    if HW.closed() then return "Trick-or-treat is closed", 0 end
    local ready, soonest = HW.readyHouses()
    if #ready == 0 then
        return "All houses done · next in " .. (soonest and (math.ceil(soonest / 60) .. "m") or "a while"), 0
    end
    local pads = HW.go(on, function() local p = HW.pads() return #p > 0 and p or nil end)
    if not pads then return on() and "Couldn't get to Halloween island" or "stopped", 0 end
    local left = {}
    for _, id in ipairs(ready) do left[id] = true end
    local function knockedNow(id)   -- the game saved this knock (Data.TrickOrTreat[id] is this reset's time)
        local d = GameData.get()
        local last = d and type(d.TrickOrTreat) == "table" and tonumber(d.TrickOrTreat[id]) or 0
        return last > 0 and workspace:GetServerTimeNow() - last < 14400 and (last // 14400) == (workspace:GetServerTimeNow() // 14400)
    end
    local function scan()
        local byId = {}
        for _, p in ipairs(HW.pads()) do
            byId[p.id] = p
            HW.housePos[p.id] = p.zone.Position
        end
        return byId
    end
    local function stand(pos)
        local r = root()
        if not r then return end
        pcall(function() LP:RequestStreamAroundAsync(pos) end)
        r.AssemblyLinearVelocity = Vector3.new()
        r.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    end
    local knocked, candy = 0, 0
    -- up to 4 passes over every house still to do: a house that isn't loaded in yet, or didn't answer, gets
    -- another go after the others (walking round the island loads the rest in)
    for pass = 1, 4 do
        if not on() then break end
        local byId = scan()
        local ids = {}
        for id in pairs(left) do table.insert(ids, id) end
        table.sort(ids)
        if #ids == 0 then break end
        for _, id in ipairs(ids) do
            if not on() then break end
            local pad = byId[id]
            if not pad and HW.housePos[id] then   -- seen before but not loaded right now: go there and look again
                stand(HW.housePos[id])
                task.wait(1)
                pad = scan()[id]
            end
            if pad then
                stand(pad.zone.Position)
                task.wait(0.5)
                for try = 1, 3 do
                    local ok, res = send("TrickOrTreatService.RF.Knock", id)
                    if ok and type(res) == "table" and res.Success == true then
                        knocked += 1
                        candy += tonumber(res.Candy) or 0
                        if res.Pet then Window:Notify({Type = "Success", Title = "Trick or treat", Content = "Got a pet: " .. tostring(res.Pet)}) end
                        left[id] = nil
                        break
                    end
                    if knockedNow(id) then left[id] = nil break end   -- already done this reset
                    -- not close enough / too fast: stand right in the middle again and wait a moment
                    task.wait(1.2)
                    stand(pad.zone.Position)
                    task.wait(0.4)
                end
                task.wait(0.8)
            end
        end
        -- houses never seen yet: walk past every house we know so the rest of the island loads in
        local unseen = false
        for id in pairs(left) do if not HW.housePos[id] then unseen = true end end
        if unseen then
            for _, pos in pairs(HW.housePos) do
                if not on() then break end
                stand(pos)
                task.wait(0.6)
                scan()
            end
        end
    end
    local missed = 0
    for _ in pairs(left) do missed += 1 end
    if knocked > 0 then
        Window:Notify({Type = "Success", Title = "Trick or treat", Content = knocked .. " house(s) · +" .. short(candy) .. " Candy Corn" .. (missed > 0 and (" · " .. missed .. " didn't answer") or "")})
        return "Knocked " .. knocked .. " house(s) · +" .. short(candy) .. " candy" .. (missed > 0 and (" · " .. missed .. " left, trying again") or ""), knocked
    end
    return "No house answered - try again soon", 0
end

