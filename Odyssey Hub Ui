-- FAST HATCH: sends the next hatch without waiting for the last one to finish, and hides the hatch
-- animation. From your PlayerGui list the animation screens are "Hatching", "HatchScreen" and
-- "Egg Opening Stuff" (BoostBarHatch is your boost bar, so it's left alone). The game turns them on for
-- every hatch, so while Fast Hatch is on they get switched straight back off.
local HATCH_GUIS = {["Hatching"] = true, ["HatchScreen"] = true, ["Egg Opening Stuff"] = true}
-- the animation is played by the game's own code when the hatch answer (EggHatchResult) comes in. Fast Hatch
-- switches the game's listeners on that answer off (ours stays on), so no animation plays at all. Your pets
-- are still given by the server - only the show is skipped. Turning Fast Hatch off switches them back on.
local paused = {}
local function pauseGameAnimation(on)
    if on then
        if type(getconnections) ~= "function" or not Hatch.resultRemote then return false end
        for _, rem in ipairs({Hatch.resultRemote, Hatch.resultRemote.Parent:FindFirstChild("ForcedHatchResult")}) do
            for _, c in ipairs(getconnections(rem.OnClientEvent)) do
                local ok, isOurs = pcall(function() return c.Function and debug.info(c.Function, "s") == debug.info(1, "s") end)
                if not (ok and isOurs) and c.Enabled ~= false then
                    if pcall(function() c:Disable() end) then table.insert(paused, c) end
                end
            end
        end
        return #paused > 0
    else
        for _, c in ipairs(paused) do pcall(function() c:Enable() end) end
        paused = {}
    end
end
local guiWatch, hiddenObjs = {}, {}
local function hideHatchGuis(on)
    for _, c in ipairs(guiWatch) do pcall(function() c:Disconnect() end) end
    guiWatch = {}
    if not on then   -- put back everything we hid
        for d in pairs(hiddenObjs) do pcall(function() d.Visible = true end) end
        hiddenObjs = {}
    end
    pcall(pauseGameAnimation, on)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for name in pairs(HATCH_GUIS) do
        local g = pg:FindFirstChild(name)
        if g and g:IsA("ScreenGui") then
            if on then
                if name ~= "Egg Opening Stuff" then g.Enabled = false end   -- that one is always on; its contents animate
                for _, d in ipairs(g:GetDescendants()) do
                    if d:IsA("GuiObject") and d.Visible and name == "Egg Opening Stuff" then hiddenObjs[d] = true d.Visible = false end
                end
                table.insert(guiWatch, g:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if Hatch.fast and g.Enabled and name ~= "Egg Opening Stuff" then g.Enabled = false end
                end))
                table.insert(guiWatch, g.DescendantAdded:Connect(function(d)
                    if Hatch.fast and d:IsA("GuiObject") then task.defer(function() hiddenObjs[d] = true d.Visible = false end) end
                end))
            end
        end
    end
end
