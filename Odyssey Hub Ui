autoLoop(Upgrades, {Name = "Auto Physical Upgrades", Description = "Buys +1 Jumps and the island pads in order", Flag = "AutoPads", Every = 10, Run = function()
    local pcfg = rcfg("Shared.Progression.PhysicalUpgradeConfig")
    local icfg = rcfg("Shared.Progression.IslandUpgradeConfig")
