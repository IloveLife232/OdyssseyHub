-- SERVER EVENTS (from the game's BalloonPartyEffects / PigsCouldFlyEffects / BalloonFlight / PigFlight / ItemController):
--   balloons + pigs are announced on <Service>.Launched with their flight data; where one is right now =
--   BalloonFlight.Position(data, now - LaunchedAt) / PigFlight.Position(...). You hit one within HitRange with
--   <Service>.Hit:Fire(Uid); they end on Popped / Caught / Retired. The script flies to each one and hits it.
--   Blood Moon Dial: WeatherDialService:CanUse("BloodMoon") then :Use("BloodMoon").
;(function()   -- own function so these locals don't count toward the main chunk's limit
    Limited:CreateSection({Name = "Server events", Side = "Left"})
    local function makeHunter(o)
        -- o = {service, flight, cfgKey, flag, name, desc, cooldown}
        local live, gone = {}, {}
        local function addOne(a)
            if type(a) == "table" and type(a.Uid) == "string" and not gone[a.Uid] then live[a.Uid] = a end
        end
        local function dropUid(...)
            for _, v in ipairs({...}) do
                if type(v) == "string" then live[v] = nil gone[v] = true
                elseif type(v) == "table" and type(v.Uid) == "string" then live[v.Uid] = nil gone[v.Uid] = true end
            end
        end
        pcall(function()
            local f = RS.RemoteServices:FindFirstChild(o.service)
            track(f.RE.Launched.OnClientEvent:Connect(function(a) addOne(a) end))
            for _, ev in ipairs({"Popped", "Caught", "Retired"}) do
                local e = f.RE:FindFirstChild(ev)
                if e then track(e.OnClientEvent:Connect(dropUid)) end
            end
        end)
        local function flightMod() local ok, m = pcall(function() return require(RS.Shared.Admin[o.flight]) end) return ok and m or nil end
        local function cfg()
            local ok, c = pcall(function() return require(RS.Shared.Admin.WorldEventConfig)[o.cfgKey] end)
            return ok and type(c) == "table" and c or {}
        end
        local back
        autoLoop(Limited, {Side = "Left", Name = o.name, Description = o.desc, Flag = o.flag, Every = 0.2, Run = function()
            local fm = flightMod()
            if not fm then return "Couldn't read the flight paths" end
            if next(live) == nil then   -- nothing known yet: ask the server what's flying
                local ok, list = send(o.service .. ".RF.GetActive")
                if ok and type(list) == "table" then for _, a in pairs(list) do addOne(a) end end
            end
            local now = workspace:GetServerTimeNow()
            local r = root()
            if not r then return "No character" end
            local best, bestPos, bd
            for uid, a in pairs(live) do
                local t = now - (tonumber(a.LaunchedAt) or now)
                if fm.Lifetime and t >= fm.Lifetime then
                    live[uid] = nil
                else
                    local ok, pos = pcall(fm.Position, a, t)
                    if ok and typeof(pos) == "Vector3" then
                        local dd = (pos - r.Position).Magnitude
                        if not bd or dd < bd then best, bestPos, bd = a, pos, dd end
                    end
                end
            end
            if not best then
                if back then
                    r.AssemblyLinearVelocity = Vector3.new()
                    r.CFrame = back
                    back = nil
                end
                return "Waiting for the event"
            end
            if not back then back = r.CFrame end
            -- stand right under it and hit (several times for the big ones)
            r.AssemblyLinearVelocity = Vector3.new()
            r.CFrame = CFrame.new(bestPos - Vector3.new(0, 3, 0))
            send(o.service .. ".RE.Hit", best.Uid)
            task.wait(tonumber(cfg().HitCooldown) or o.cooldown)
            return "Hitting · " .. (function() local n = 0 for _ in pairs(live) do n += 1 end return n end)() .. " up"
        end})
    end
    makeHunter({service = "BalloonPartyService", flight = "BalloonFlight", cfgKey = "Balloon", flag = "AutoBalloons",
        name = "Auto Balloon Party", desc = "Flies to every balloon and pops it", cooldown = 0.25})
    makeHunter({service = "PigsCouldFlyService", flight = "PigFlight", cfgKey = "Pig", flag = "AutoPigs",
        name = "Auto Pigs Could Fly", desc = "Flies to every pig and hits it", cooldown = 0.5})
    autoLoop(Limited, {Side = "Left", Name = "Auto Blood Moon Dial", Description = "Uses a Blood Moon Dial whenever Blood Moon isn't on", Flag = "AutoBloodDial", Every = 20, Run = function()
        local d = GameData.get()
        local owned = d and d.Items and d.Items.Owned
        local n = owned and tonumber(owned.BloodMoonDial) or 0
        if n < 1 then return "No Blood Moon Dials" end
        if workspace:GetAttribute("Event_BloodMoon_Active") == true then return "Blood Moon is already on · " .. n .. " dial(s) left" end
        local ok, res = send("WeatherDialService.RF.CanUse", "BloodMoon")
        if not (ok and type(res) == "table" and res.Success == true) then
            return "Can't use it now" .. ((ok and type(res) == "table" and res.Reason) and (": " .. tostring(res.Reason)) or "")
        end
        local ok2, res2 = send("WeatherDialService.RF.Use", "BloodMoon")
        if ok2 and type(res2) == "table" and res2.Success == true then
            Window:Notify({Type = "Success", Title = "Blood Moon", Content = "Used a Blood Moon Dial (" .. (n - 1) .. " left)"})
            return "Used one · " .. os.date("%H:%M")
        end
        return "Game said: " .. tostring(ok2 and type(res2) == "table" and res2.Reason or "no")
    end})
end)()

