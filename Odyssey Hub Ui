-- AUTO LOOPS: one helper for every "do this over and over" toggle. fn() does one round and returns a short
-- status for the toggle's text. Every one of these is switched off by FARM > Stop all.
local AUTO = {}          -- toggle apis that Stop all turns off
local autoOn = {}        -- [flag] = true while running
-- BUSY LOCK: while you're in a Wave Defense game, a Haunted Mansion run or a boss fight, nothing else may pull you
-- away (teleport you) until it's done. AUTO.lockOn(name, allow, owner) takes it (allow = which toggles may still run),
-- AUTO.lockOff(name) gives it back. Every other auto toggle just waits ("Paused · finishing ...").
-- longest each one can really take; a lock older than that is stale (something went wrong) and is dropped
AUTO.lockMax = {["Hallow Lord"] = 420, ["Wave Defense"] = 1200, ["Haunted Mansion"] = 2100}
local function lockStale(b) return b and os.clock() - b.at > (AUTO.lockMax[b.name] or 1200) end
-- also counts a wave / mansion run you're playing yourself (no Odyssey toggle needed):
-- the game marks a wave with the ColosseumActive attribute, and the mansion code knows when a run is going
function AUTO.liveGame()
    if LP:GetAttribute("ColosseumActive") == true then return {name = "Wave Defense", allow = {AutoWaveDefense = true}} end
    if AUTO.mansionLive and AUTO.mansionLive() then return {name = "Haunted Mansion", allow = {AutoMansion = true}} end
end
-- which auto toggle each running thread belongs to, so a teleport can be checked against the lock
AUTO.threads = setmetatable({}, {__mode = "k"})
function AUTO.lockOn(name, allow, owner)
    local b = AUTO.busy
    if b and lockStale(b) then AUTO.busy = nil b = nil end
    if b and b.name ~= name then return false end
    if not b then
        local l = AUTO.liveGame()
        if l and l.name ~= name then return false end
    end
    if not (b and b.name == name) then AUTO.busy = {name = name, allow = allow or {}, owner = owner, at = os.clock()} end
    return true
end
function AUTO.lockOff(name) if AUTO.busy and AUTO.busy.name == name then AUTO.busy = nil end end
function AUTO.blockedFor(key)
    local b = AUTO.busy
    if b and lockStale(b) then AUTO.busy = nil b = nil end
    if not b then b = AUTO.liveGame() end
    if not b then return nil end
    if b.allow[key] then return nil end
    return b.name
end
-- HARD STOP: a toggle that was already half way through something (a chest, trick or treat, a quest...) when the
-- wave / mansion started can't move you either - any teleport from its thread is simply dropped until it's done
pcall(function()
    if type(hookmetamethod) ~= "function" or type(checkcaller) ~= "function" then return end
    local old
    old = hookmetamethod(game, "__newindex", function(self, k, v)
        if (k == "CFrame" or k == "Position") and checkcaller() and running then
            local key = AUTO.threads[coroutine.running()]
            if key and typeof(self) == "Instance" then
                local c = LP.Character
                if c and self.Parent == c and self.Name == "HumanoidRootPart" and AUTO.blockedFor(key) then return end
            end
        end
        return old(self, k, v)
    end)
end)
local function autoLoop(tab, o)
    -- o.Key = its name inside the script (for toggles that aren't saved in the config, o.Flag is nil)
    local key = o.Key or o.Flag
    local api
    api = tab:CreateToggle({Name = o.Name, Description = o.Description, Flag = o.Flag, Side = o.Side, Callback = function(on)
        autoOn[key] = on
        GEN[key] = (GEN[key] or 0) + 1
        local myGen = GEN[key]   -- turning it off/on again stops the old loop
        if not on then
            if AUTO.busy and AUTO.busy.owner == key then AUTO.busy = nil end
            api:SetDescription(o.Description or "")
            return
        end
        task.spawn(function()
            AUTO.threads[coroutine.running()] = key
            while running and autoOn[key] and GEN[key] == myGen do
                local blockedBy = AUTO.blockedFor(key)
                local ok, status
                if blockedBy then
                    ok, status = true, "Paused · finishing " .. blockedBy
                else
                    ok, status = pcall(o.Run)
                    if not ok and AUTO.busy and AUTO.busy.owner == key then AUTO.busy = nil end   -- crashed: give the lock back
                end
                if not ok then status = "error: " .. tostring(status):sub(1, 60) end
                if status and autoOn[key] then api:SetDescription(tostring(status)) end
                local waitFor = o.Every or 5
                local t = os.clock()
                while running and autoOn[key] and os.clock() - t < waitFor do task.wait(0.1) end
            end
        end)
    end})
    table.insert(AUTO, api)
    return api
end


