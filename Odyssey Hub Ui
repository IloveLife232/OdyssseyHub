-- takes you to an egg (its world first if it isn't loaded), the same way Auto Hatch does
function Hatch.moveToEgg(egg)
    if AUTO.blockedFor("BestEgg") or Hatch.questBusy then return false end
    local cf = eggSpot(egg)
    if not cf then
        local okW = goToEggWorld(egg)
        if not okW then return false end
        cf = eggSpot(egg)
    end
    local r = root()
    if not (cf and r) then return false end
    if (r.Position - cf.Position).Magnitude <= 10 then return true end
    pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
    local look = cf.LookVector * Vector3.new(1, 0, 1)
    if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
    local pos = cf.Position
    local spot = pos + look.Unit * 6 + Vector3.new(0, 2, 0)
    r.AssemblyLinearVelocity = Vector3.new()
    r.CFrame = CFrame.lookAt(spot, Vector3.new(pos.X, spot.Y, pos.Z))
