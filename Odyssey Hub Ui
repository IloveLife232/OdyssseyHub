-- from the game's RebirthController: RebirthService.RebirthRequested:Fire({Index = i}).
-- Button i gives 5^(i-1) rebirths and costs 800 * amount * (1 + 0.21875 * (rebirths - 1)) coins.
-- Auto Rebirth presses the biggest button you can afford.
local function rebirthPrice(i, rebirths)
    local amount = 5 ^ (i - 1)
    local base = math.round(800 * amount / 10) * 10
    local r = rebirths or 0
    local p = base * (((r >= 2) and (r - 1) or r) * 0.21875 + 1)
    if r > 1e15 then p /= 2 end
    return p
end
