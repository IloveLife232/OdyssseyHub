		TweenService:Create(on,ti,{BackgroundTransparency=enabled and 0 or 1}):Play()
		TweenService:Create(thumb,ti,{Position=enabled and UDim2.new(0,21,0.5,-7) or UDim2.new(0,3,0.5,-7),BackgroundColor3=enabled and C.White or C.Knob}):Play()
	end
	local api={}
	function api:Set(o)
		if type(o)~="table" then o={CurrentValue=o} end
		if o.CurrentValue~=nil and o.CurrentValue~=enabled then
			enabled=o.CurrentValue==true
			render(true)
			if flag then Odyssey.Flags[flag]=enabled end
			if cb then task.spawn(cb,enabled) end
		end
		if o.Description then _setDesc(left,o.Description) end
		if o.Name then local nl=left:FindFirstChildWhichIsA("TextLabel"); if nl then nl.Text=o.Name end end
	end
