-- DISCORD WEBHOOK
------------------------------------------------------------------------------------------
local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
local RANK = {Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6, Mythical = 6, Secret = 7, Exclusive = 7, Divine = 8}
local function post(embed)
    local url = Webhook.url or ""
    if not url:match("^https://discord%.com/api/webhooks/") and not url:match("^https://discordapp%.com/api/webhooks/") and not url:match("^https://ptb%.discord%.com/api/webhooks/") and not url:match("^https://canary%.discord%.com/api/webhooks/") then
        return false, "no valid webhook URL in Settings"
    end
    if not httpRequest then return false, "your executor can't send web requests" end
    embed.footer = {text = "Odyssey · Tapping Simulator"}
    embed.timestamp = DateTime.now():ToIsoDate()
    local ok, res = pcall(httpRequest, {Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"},
        Body = HS:JSONEncode({username = "Odyssey", embeds = {embed}})})
    if not ok then return false, tostring(res) end
    local code = type(res) == "table" and (res.StatusCode or res.Status) or 0
    if code ~= 0 and (code < 200 or code >= 300) then return false, "Discord said " .. tostring(code) end
    return true
end
Webhook.post = post
local function uptimeText()
    local s = math.floor(os.clock() - Stats.t0)
    return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
end
-- every hatched pet: count Legendary / Mythic / Secret, remember the last of each and the rarest this hour
local function rarClass(rar)
    rar = tostring(rar)
    if rar:find("Secret") then return "Secret" end
    if rar == "Mythic" or rar == "Mythical" then return "Mythic" end
    if rar == "Legendary" then return "Legendary" end
end
local function isMysteryEgg(egg)
    egg = tostring(egg or "")
    if egg:lower():find("mystery") then return true end
    local cur = workspace:GetAttribute("MysteryEgg_Egg") or workspace:GetAttribute("MysteryEgg_Name")
    return cur ~= nil and tostring(cur) == egg
end
function Webhook.trackPet(pet, egg)
    local h = Webhook.hour
    -- every pet counts toward "took X hatches", even ones auto deleted
    Webhook.since.Mythic += 1
    Webhook.since.Secret += 1
    if isMysteryEgg(egg) then h.mysteryHatches += 1 end
    local cls0 = rarClass(pet.Rarity)
    if cls0 == "Mythic" or cls0 == "Secret" then
        pet._took = Webhook.since[cls0]
        Webhook.since[cls0] = 0
    end
    if pet.AutoDeleted then return end
    local cls = cls0
    local label = tostring(pet.Name) .. (pet.Tier and pet.Tier ~= "Normal" and (" (" .. tostring(pet.Tier) .. ")") or "")
        .. (pet.OneIn and (" · 1 in " .. short(tonumber(pet.OneIn) or 0)) or "")
    if cls then
        h.count[cls] += 1
        h.last[cls] = label
    end
    local rank = RANK[tostring(pet.Rarity)] or (cls == "Secret" and 7) or 0
    local oneIn = tonumber(pet.OneIn) or 0
    if not h.rarest or rank > h.rarest.rank or (rank == h.rarest.rank and oneIn > h.rarest.oneIn) then
        h.rarest = {rank = rank, oneIn = oneIn, label = label .. " [" .. tostring(pet.Rarity) .. "]"}
    end
end
function Webhook.sendStats(isTest)
    local s = math.max(1, os.clock() - Stats.t0)
    local gained = (Stats.rebirths and Stats.startReb) and (Stats.rebirths - Stats.startReb) or 0
    local h = Webhook.hour
    h.tapsStart = h.tapsStart or 0
    h.eggsStart = h.eggsStart or 0
    local skills = {}
    for tree, n in pairs(h.skills) do table.insert(skills, tree .. ": " .. n) end
    table.sort(skills)
    local function rarLine(cls) return short(h.count[cls]) .. (h.last[cls] and (" · last: " .. h.last[cls]) or "") end
    local ok, err = post({
        title = isTest and "Test message - webhook works" or "Hourly stats",
        color = 0x5CCBFF,
        fields = {
            {name = "Player", value = LP.Name, inline = true},
            {name = "Uptime", value = uptimeText(), inline = true},
            {name = "Coins", value = short(Stats.coins), inline = true},
            {name = "Coins / hour", value = short(Stats.earned / s * 3600), inline = true},
            {name = "Rebirths", value = short(Stats.rebirths) .. " (+" .. short(gained) .. ")", inline = true},
            {name = "Quests done (hour)", value = short(h.quests), inline = true},
            {name = "Taps (hour)", value = short(math.max(0, taps - h.tapsStart)), inline = true},
            {name = "Eggs hatched (hour)", value = "Normal: " .. short(math.max(0, Hatch.hatched - h.eggsStart - h.mysteryHatches))
