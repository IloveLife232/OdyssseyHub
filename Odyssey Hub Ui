function Webhook.onPet(pet, egg)
    -- always sent to your webhook (no toggle): only Mythic and Secret pets
    if Webhook.url == "" or pet.AutoDeleted then return end
    local rar = tostring(pet.Rarity)
    if not (rar == "Mythic" or rar == "Mythical" or rar:find("Secret")) then return end
    local rank = RANK[rar] or (rar:find("Secret") and 8) or 0
    -- the pet's picture: its image id from the game's pet list, turned into a link with Roblox's thumbnail API
    local thumb
    pcall(function()
        local lpc = rcfg("Shared.Pets.LaunchPetConfig")
        local info = lpc and lpc[tostring(pet.Name)]
        local img = info and (info.Image or info.Icon or info.Thumbnail or info.Decal)
        local id = img and tostring(img):match("%d+")
        if id and httpRequest then
            local res = httpRequest({Url = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. id .. "&size=420x420&format=Png", Method = "GET"})
            local body = res and (res.Body or res.body)
            local data = body and game:GetService("HttpService"):JSONDecode(body)
            thumb = data and data.data and data.data[1] and data.data[1].imageUrl
        end
    end)
    post({
        title = "Hatched " .. tostring(pet.Name) .. "!",
        color = rank >= 7 and 0xFF5D6C or rank >= 6 and 0xB49BFF or 0xFFC857,
        thumbnail = thumb and {url = thumb} or nil,
        fields = {
            {name = "Pet", value = tostring(pet.Name), inline = true},
            {name = "Rarity", value = tostring(pet.Rarity) .. (pet.Tier and pet.Tier ~= "Normal" and (" · " .. tostring(pet.Tier)) or ""), inline = true},
            {name = "Egg", value = tostring(egg or Hatch.egg or "?") .. (isMysteryEgg(egg) and " (Mystery)" or ""), inline = true},
            {name = "Took", value = pet._took and (short(pet._took) .. " hatches") or "?", inline = true},
            {name = "Chance", value = pet.OneIn and ("1 in " .. short(tonumber(pet.OneIn) or 0)) or "?", inline = true},
            {name = "Power", value = tostring(pet.Power or "?"), inline = true},
            {name = "Player", value = LP.Name, inline = true},
        },
    })
end
