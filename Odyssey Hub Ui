	function api:GetValue() return enabled end
	function api:Destroy() card:Destroy() end
	if flag then
		Odyssey.Flags[flag]=enabled
		Odyssey._Restore[flag]=function(v)
			if type(v)~="boolean" or v==enabled then return end
			enabled=v
			render(false)
			Odyssey.Flags[flag]=v
			if cb then task.spawn(cb,v) end
		end
	end

	if enabled and cb then task.defer(cb,true) end
